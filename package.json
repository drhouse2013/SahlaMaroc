{
  "name": "sahlamaroc",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "SahlaMaroc — le Maroc simple et pratique : guides et calculateurs pour les MRE et les visiteurs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "translate": "node src/i18n/translate.mjs",
    "prebuild": "node tools/raster.mjs",
    "predev": "node tools/raster.mjs",
    "check:content": "node tools/check-content.mjs",
    "check:dist": "node tools/check-dist.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test tools/test-fx.mjs tools/test-vignette.mjs tools/test-returnbudget.mjs tools/test-retirement.mjs tools/test-ramadan.mjs tools/test-prayer.mjs tools/test-customs.mjs tools/test-costofliving.mjs tools/test-capitalgain.mjs tools/test-theme.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/marhey": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "~7.4.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "gray-matter": "^4.0.3",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
