# Copier en .env (local) et dans Vercel/Netlify > Environment variables (prod).

# --- Google AdSense (après validation du site) ---
PUBLIC_ADSENSE_CLIENT=           # ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT_BANNER=      # ID du bloc "Display" responsive
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=  # ID du bloc "In-article"
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# --- Affiliation (laisser vide = lien normal sans commission) ---
PUBLIC_BOOKING_AID=              # Booking.com Affiliate Partner : aid numérique
PUBLIC_AIRALO_URL=               # Lien de tracking Airalo complet (Impact)
PUBLIC_WISE_URL=                 # Lien de parrainage / partenaire Wise
PUBLIC_GYG_PARTNER_ID=           # GetYourGuide partner_id
PUBLIC_VIATOR_PID=               # Viator pid (P00xxxxxx)
PUBLIC_SAFETYWING_REF=           # SafetyWing referenceID
PUBLIC_DISCOVERCARS_AID=         # DiscoverCars a_aid

# --- Analytics (Umami Cloud, gratuit, sans cookies) ---
PUBLIC_UMAMI_WEBSITE_ID=

# --- Traduction (npm run translate) — NE JAMAIS préfixer par PUBLIC_ ---
DEEPL_API_KEY=                   # clé gratuite DeepL : se termine par ":fx"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
