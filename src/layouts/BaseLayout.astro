---
/**
 * BaseLayout — squelette de toutes les pages.
 * Performance :
 * - Polices auto-hébergées : Readex Pro (texte et titres), Marhey pour le logo ;
 *   on précharge uniquement la variante Readex de la langue (latin ou arabe).
 * - JS minimal : thème (inline, anti-flash), menus, recherche (index chargé à la demande),
 *   chargeur AdSense différé, petit traceur d'événements (Umami, uniquement s'il est configuré).
 * - AdSense chargé seulement après interaction ou 3,5 s => n'impacte ni LCP ni TBT.
 */
import '@fontsource-variable/readex-pro';
import '@fontsource-variable/marhey';
import '../styles/global.css';
import readexLatin from '@fontsource-variable/readex-pro/files/readex-pro-latin-wght-normal.woff2?url';
import readexArabic from '@fontsource-variable/readex-pro/files/readex-pro-arabic-wght-normal.woff2?url';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';
import SearchBox from '../components/SearchBox.astro';
import { LOCALE_META, isIndexable, useTranslations, type Locale } from '../i18n';
import { rssPath, type Alternates } from '../utils/i18n';
import { ADSENSE_CLIENT, UMAMI_WEBSITE_ID } from '../config/site';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  /** hreflang : versions indexables uniquement */
  alternates: Alternates;
  /** Sélecteur de langue : toutes les versions existantes (par défaut = alternates) */
  switchTargets?: Alternates;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { lang, alternates, switchTargets, ...seo } = Astro.props;
// Langue pas encore lancée => noindex automatique (voir site.config.mjs)
const noindex = seo.noindex || !isIndexable(lang);
const t = useTranslations(lang);
const meta = LOCALE_META[lang];
const description = seo.description ?? t('site.description');
---

<!doctype html>
<html lang={meta.hreflang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="google-site-verification" content="WYCTZCgbChnFf2QffNqOmXH0864UscD392U7WB8QJXw" />
    <meta name="theme-color" content="#fbf8f3" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="alternate" type="application/rss+xml" title={t('rss.title')} href={rssPath(lang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={meta.dir === 'rtl' ? readexArabic : readexLatin} as="font" type="font/woff2" crossorigin />
    {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}

    <SEO lang={lang} alternates={alternates} description={description} {...seo} noindex={noindex} />

    <!-- Thème appliqué avant le premier rendu (évite le flash) -->
    <script is:inline data-theme-init>
      (function () {
        var key = 'sahla-theme-preference';
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        function readPreference() {
          try {
            var saved = localStorage.getItem(key);
            if (saved === 'light' || saved === 'dark') return saved;
          } catch (e) {}
          return 'system';
        }
        var preference = readPreference();
        function applyTheme() {
          var dark = preference === 'dark' || (preference === 'system' && media.matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.dataset.themePreference = preference;
          var color = document.querySelector('meta[name="theme-color"]');
          if (color) color.setAttribute('content', dark ? '#0f1626' : '#fbf8f3');
          document.querySelectorAll('[data-theme-select]').forEach(function (select) { select.value = preference; });
          document.dispatchEvent(new Event('sahla:theme-applied'));
        }
        document.addEventListener('sahla:theme-change', function (event) {
          if (['system', 'light', 'dark'].indexOf(event.detail) === -1) return;
          preference = event.detail;
          try { localStorage.setItem(key, preference); } catch (e) {}
          applyTheme();
        });
        media.addEventListener('change', applyTheme);
        window.addEventListener('storage', function (event) {
          if (event.key !== key && event.key !== null) return;
          preference = readPreference();
          applyTheme();
        });
        applyTheme();
      })();
    </script>

    {UMAMI_WEBSITE_ID && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_WEBSITE_ID}></script>}
  </head>
  <body class="min-h-screen bg-[var(--surface-2)] pb-[calc(3.5rem+env(safe-area-inset-bottom))] font-sans text-[var(--text)] antialiased lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-[var(--surface)] focus:px-4 focus:py-2 focus:font-semibold focus:text-navy-700 focus:shadow-lg">{t('nav.skip')}</a>
    <Header lang={lang} switchTargets={switchTargets ?? alternates} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileNav lang={lang} />
    <SearchBox lang={lang} mode="dialog" />

    <!-- Scroll reveal global (.reveal + .stagger-reveal) -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal, .stagger-reveal').forEach(function (el) { io.observe(el); });
      })();
    </script>

    <!-- Événements (Umami si configuré) + chargeur AdSense différé -->
    <script is:inline define:vars={{ client: ADSENSE_CLIENT ?? '' }}>
      (function () {
        // Traceur unique : aucun envoi si Umami n'est pas configuré.
        window.sahlaTrack = function (name, data) {
          try { if (window.umami) window.umami.track(name, Object.assign({ page: location.pathname }, data || {})); } catch (e) {}
        };
        document.addEventListener('click', function (e) {
          var el = e.target.closest && e.target.closest('a[data-affiliate], a[data-lang-link], [data-track]');
          if (!el) return;
          if (el.dataset.affiliate) window.sahlaTrack('affiliate_click', { provider: el.dataset.affiliate });
          else if (el.dataset.langLink) window.sahlaTrack('language_change', { to: el.dataset.langLink });
          else window.sahlaTrack(el.dataset.track, { label: el.dataset.trackLabel || '' });
        });
        // Lecture d'un guide : 75 % de l'article atteints
        var art = document.querySelector('[data-article]');
        if (art) {
          var onScroll = function () {
            var r = art.getBoundingClientRect();
            if (r.top + r.height * 0.75 < innerHeight) {
              window.sahlaTrack('article_read', { slug: art.dataset.article });
              removeEventListener('scroll', onScroll);
            }
          };
          addEventListener('scroll', onScroll, { passive: true });
        }

        var slots = document.querySelectorAll('ins.adsbygoogle');
        if (client && slots.length) {
          var loaded = false;
          var load = function () {
            if (loaded) return;
            loaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
            document.head.appendChild(s);
            slots.forEach(function () { (window.adsbygoogle = window.adsbygoogle || []).push({}); });
          };
          ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) {
            addEventListener(e, load, { once: true, passive: true });
          });
          setTimeout(load, 3500);
        }
      })();
    </script>
  </body>
</html>
