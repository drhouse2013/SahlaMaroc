---
/**
 * ArticleLayout — gabarit des guides.
 * Structure : fil d'Ariane, H1, introduction, auteur et dates (publication, mise à jour, vérification),
 * avertissement « règles qui évoluent » sur les sujets sensibles, sommaire, contenu, sources officielles,
 * « Signaler une erreur », auteur, calculateurs liés, villes liés, guides liés, thème parent.
 */
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Disclosure from '../components/Disclosure.astro';
import AdSlot from '../components/AdSlot.astro';
import ArticleCard from '../components/ArticleCard.astro';
import GuideVisual from '../components/GuideVisual.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AffiliateLink from '../components/AffiliateLink.astro';
import ToolGrid from '../components/ToolGrid.astro';
import Icon from '../components/Icon.astro';
import { useTranslations } from '../i18n';
import { CATEGORIES, CATEGORY_ICON } from '../i18n/categories';
import { formatDate } from '../utils/date';
import { categoryPath, cityPath, getPageUrl, homePath, hubPath, type Alternates } from '../utils/i18n';
import { absoluteUrl, articleJsonLd, breadcrumbJsonLd, faqJsonLd } from '../utils/seo';
import { checklistsIn, citedLinks, isYmyl, officialSourcesFor, relatedCitiesFor, relatedToolsFor } from '../utils/content';
import { getNews } from '../utils/news';
import { cityLabel } from '../data/cities';
import { journeyOf } from '../data/journeys';
import type { IconName } from '../data/icons';
import { getArticleByKey } from '../utils/i18n';

interface Props {
  entry: CollectionEntry<'articles'>;
  alternates: Alternates;
  switchTargets: Alternates;
  headings: MarkdownHeading[];
  minutes: number;
  related: CollectionEntry<'articles'>[];
}

const { entry, alternates, switchTargets, headings, minutes, related } = Astro.props;
const d = entry.data;
const lang = d.lang;
const t = useTranslations(lang);
const cat = CATEGORIES[d.category];
const url = absoluteUrl(Astro.url.pathname, Astro.site);
const imageUrl = d.heroImage ? absoluteUrl(d.heroImage.src, Astro.site) : undefined;
const toc = headings.filter((h) => h.depth === 2);
const aboutUrl = await getPageUrl(lang, 'about');
const contactUrl = await getPageUrl(lang, 'contact');
const disclosureUrl = await getPageUrl(lang, 'disclosure');
const reportUrl = contactUrl ? `${contactUrl}?type=correction&page=${encodeURIComponent(url)}` : undefined;
const hasAffiliate = /<AffiliateLink\b/.test(entry.body ?? '');
const ymyl = isYmyl(entry);
const official = officialSourcesFor(entry);
const cited = citedLinks(entry.body);
const tools = relatedToolsFor(entry);
const cities = relatedCitiesFor(entry);
const news = (await getNews(entry.data.lang)).filter((n) => n.data.related.includes(entry.data.translationKey));
const checklists = checklistsIn(entry.body);
const updated = d.updatedDate ?? d.pubDate;
const brief = [
  d.forWho && { k: 'forWho', icon: 'users', v: d.forWho },
  d.delay && { k: 'delay', icon: 'clock', v: d.delay },
  d.cost && { k: 'cost', icon: 'coins', v: d.cost },
].filter((x): x is { k: 'forWho' | 'delay' | 'cost'; icon: IconName; v: string } => Boolean(x));
const faq = d.faq ?? [];
const waUrl = `https://wa.me/?text=${encodeURIComponent(`${t('article.shareText')} ${d.title} ${url}`)}`;
// Parcours guidé : précédent / suivant (jamais vers une traduction automatique depuis une page indexable).
const pos = journeyOf(d.translationKey);
/** Pages fiscales, douanières ou financières : statut de relecture professionnelle toujours visible. */
const PRO_TAGS = ['douane', 'fiscalité', 'fiscalite', 'dédouanement', 'vignette', 'officedeschanges', 'change', 'conventionfiscale'];
const proSensitive = ['immobilier', 'money'].includes(d.category) || d.tags.some((x: string) => PRO_TAGS.includes(x.toLowerCase().replace(/\s/g, '')));
const usable = (a: Awaited<ReturnType<typeof getArticleByKey>>) => (a && (d.machineTranslated || !a.data.machineTranslated) ? a : null);
const prev = pos && pos.index > 0 ? usable(await getArticleByKey(lang, pos.journey.steps[pos.index - 1])) : null;
const next = pos && pos.index < pos.journey.steps.length - 1 ? usable(await getArticleByKey(lang, pos.journey.steps[pos.index + 1])) : null;

const crumbs = [
  { name: t('breadcrumb.home'), href: homePath(lang) },
  { name: cat.label[lang], href: categoryPath(lang, d.category) },
  { name: d.title },
];

const jsonLd = [
  articleJsonLd({
    url, title: d.title, description: d.description, lang, image: imageUrl,
    datePublished: d.pubDate, dateModified: d.updatedDate, author: d.author,
    authorUrl: aboutUrl ? absoluteUrl(aboutUrl, Astro.site) : undefined, site: Astro.site, section: cat.label[lang],
  }),
  breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: absoluteUrl(c.href ?? Astro.url.pathname, Astro.site) }))),
  ...(faq.length ? [faqJsonLd(faq)] : []),
];

const essentials = {
  en: ['Morocco eSIM', 'Hotels & riads', 'Tours with free cancellation', 'Travel health insurance'],
  fr: ['eSIM Maroc', 'Hôtels et riads', 'Excursions annulables', 'Assurance santé voyage'],
  es: ['eSIM para Marruecos', 'Hoteles y riads', 'Excursiones con cancelación gratuita', 'Seguro médico de viaje'],
  de: ['eSIM für Marokko', 'Hotels & Riads', 'Touren mit kostenloser Stornierung', 'Reisekrankenversicherung'],
  ar: ['شريحة eSIM للمغرب', 'فنادق ورياض', 'رحلات بإلغاء مجاني', 'تأمين صحي للسفر'],
}[lang];
---

<BaseLayout lang={lang} title={d.title} description={d.description} alternates={alternates} switchTargets={switchTargets} image={imageUrl} imageAlt={d.heroAlt} type="article" noindex={d.machineTranslated} jsonLd={jsonLd} publishedTime={d.pubDate} modifiedTime={d.updatedDate}>
<div data-category={d.category}>
  <header class="article-header">
    <div class="container-page pt-8 pb-8 md:pb-10">
      <Breadcrumbs items={crumbs} lang={lang} />
      <div class="mt-6 max-w-4xl">
        <a href={categoryPath(lang, d.category)} class="badge badge-cat">
          <Icon name={CATEGORY_ICON[d.category]} class="size-3.5" />{cat.label[lang]}
        </a>
        <h1 class="article-title mt-4">{d.title}</h1>
        <p class="article-lede mt-5">{d.description}</p>
      </div>
      <div class="article-meta mt-7 max-w-4xl">
        <span class="flex items-center gap-2">
          <span class="grid size-8 place-items-center rounded-full bg-navy-700 text-sm font-semibold text-white" aria-hidden="true">{d.author.charAt(0)}</span>
          {aboutUrl ? <a href={aboutUrl} class="font-semibold text-[var(--text)] hover:underline">{d.author}</a> : <strong class="text-[var(--text)]">{d.author}</strong>}
        </span>
        <span class="inline-flex items-center gap-1.5"><Icon name="calendar" class="size-4" />
          {d.updatedDate
            ? <span>{t('article.updated')} <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate, lang)}</time></span>
            : <span>{t('article.published')} <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate, lang)}</time></span>}
        </span>
        <span class="inline-flex items-center gap-1.5"><Icon name="clock" class="size-4" />{t('article.readingTime', { n: minutes })}</span>
        {d.verifiedDate
          ? <span class="badge badge-emerald" data-verified><Icon name="checkCircle" class="size-4" />{t('article.verified')} <time datetime={d.verifiedDate.toISOString()}>{formatDate(d.verifiedDate, lang)}</time></span>
          : <span class="inline-flex items-center gap-1.5" data-verified-missing><Icon name="clock" class="size-4" />{t('article.verifiedMissing')}</span>}
        {proSensitive && (d.proReviewedDate
          ? <span class="badge badge-emerald" data-pro-reviewed><Icon name="checkCircle" class="size-4" />{t('article.proReviewed')} <time datetime={d.proReviewedDate.toISOString()}>{formatDate(d.proReviewedDate, lang)}</time></span>
          : <span class="inline-flex items-center gap-1.5" data-pro-missing><Icon name="clock" class="size-4" />{t('article.proNotReviewed')}</span>)}
        {d.checkedDate && <span class="inline-flex items-center gap-1.5 font-medium text-emerald-moroccan-600 dark:text-emerald-moroccan-100"><Icon name="checkCircle" class="size-4" />{t('article.checked')} {formatDate(d.checkedDate, lang)}</span>}
        <span class="flex flex-wrap items-center gap-2 no-print sm:ms-auto" role="group" aria-label={t('article.share')} data-article-actions>
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm" data-track="share_whatsapp"><Icon name="send" class="size-4" />{t('article.share.whatsapp')}</a>
          <button type="button" class="btn btn-ghost btn-sm" data-copy={url} data-done={t('article.share.copied')} hidden><Icon name="link" class="size-4" /><span aria-live="polite">{t('article.share.copy')}</span></button>
          <button type="button" class="btn btn-ghost btn-sm" data-print hidden><Icon name="printer" class="size-4" />{t('article.print')}</button>
        </span>
      </div>
      <div class="article-cover mt-8 overflow-hidden rounded-xl border border-[var(--line)] no-print"><GuideVisual article={entry} large eager /></div>
    </div>
  </header>

  <div class="container-page grid gap-12 pt-8 lg:grid-cols-[minmax(0,1fr)_17.5rem]">
    <article class="min-w-0 max-w-[68ch] lg:max-w-none" data-article={d.translationKey}>
      {ymyl && (
        <div class="alert alert-info not-prose">
          <Icon name="shield" class="mt-0.5 size-5 shrink-0 text-navy-700 dark:text-navy-100" />
          <p class="text-sm"><strong>{t('article.ymyl.title')} : </strong>{t('article.ymyl.text')}</p>
        </div>
      )}
      {hasAffiliate && <div class="mt-3"><Disclosure lang={lang} /></div>}

      {brief.length > 0 && (
        <section class="reveal article-brief not-prose mt-6" aria-labelledby="brief-title" data-brief>
          <h2 id="brief-title" class="eyebrow muted">{t('article.brief.title')}</h2>
          <dl class="mt-3 grid gap-4 sm:grid-cols-3">
            {brief.map((b) => (
              <div class="min-w-0">
                <dt class="flex items-center gap-1.5"><Icon name={b.icon} class="size-4 text-terracotta-600 dark:text-terracotta-300" />{t(`article.brief.${b.k}`)}</dt>
                <dd class="[overflow-wrap:anywhere]">{b.v}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {toc.length >= 3 && (
        <nav class="reveal mt-6 border-b border-[var(--line)] pb-5 text-[0.95rem] lg:hidden" aria-label={t('article.onThisPage')}>
          <p class="eyebrow muted">{t('article.onThisPage')}</p>
          <ol class="mt-3 list-decimal space-y-1.5 ps-5 marker:text-[var(--muted)]">{toc.map((h) => <li><a href={`#${h.slug}`} class="hover:underline">{h.text}</a></li>)}</ol>
        </nav>
      )}

      {checklists.length > 0 && (
        <p class="not-prose mt-4 inline-flex items-center gap-2 text-sm font-medium text-emerald-moroccan-600 dark:text-emerald-moroccan-100">
          <Icon name="listChecks" class="size-4" /><a href={`#checklist-${checklists[0].id}`} class="hover:underline">{t('article.checklist')}</a>
        </p>
      )}

      <div class="article-body prose prose-lg mt-8 dark:prose-invert prose-a:text-[var(--link)] prose-a:underline-offset-2 prose-strong:text-[var(--text)] prose-th:text-start prose-img:rounded-2xl">
        <slot />
      </div>

      {faq.length > 0 && (
        <section class="reveal not-prose mt-12" aria-labelledby="faq-title" data-faq>
          <h2 id="faq-title" class="text-[length:var(--step-4)]">{t('article.faq')}</h2>
          <div class="faq-list mt-5">
            {faq.map((f) => (
              <div>
                <h3>{f.q}</h3>
                <p>{f.a}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {pos && (prev || next) && (
        <nav class="reveal not-prose mt-12" aria-label={t('journey.nav', { title: t(`journey.${pos.journey.id}.title` as 'journey.buy.title') })} data-journey-nav>
          <p class="eyebrow muted">{t(`journey.${pos.journey.id}.title` as 'journey.buy.title')} · {t('journey.step', { i: pos.index + 1, n: pos.journey.steps.length })}</p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {prev ? (
              <a href={`/${lang}/${prev.data.slug}`} rel="prev" class="card card-hover flex items-center gap-3 p-4">
                <Icon name="arrowRight" class="size-5 shrink-0 -scale-x-100 rtl:scale-x-100" />
                <span class="min-w-0"><span class="block text-xs font-semibold uppercase muted">{t('journey.prev')}</span><span class="block font-semibold [overflow-wrap:anywhere]">{prev.data.title}</span></span>
              </a>
            ) : <span class="hidden sm:block"></span>}
            {next && (
              <a href={`/${lang}/${next.data.slug}`} rel="next" class="card card-hover flex items-center justify-between gap-3 p-4 sm:col-start-2">
                <span class="min-w-0"><span class="block text-xs font-semibold uppercase muted">{t('journey.next')}</span><span class="block font-semibold [overflow-wrap:anywhere]">{next.data.title}</span></span>
                <Icon name="arrowRight" class="size-5 shrink-0 rtl:-scale-x-100" />
              </a>
            )}
          </div>
        </nav>
      )}

      <section class="reveal not-prose mt-12 card p-5 sm:p-6" aria-labelledby="sources-title">
        <h2 id="sources-title" class="flex items-center gap-2 text-lg font-semibold"><Icon name="landmark" class="size-5 text-navy-600 dark:text-navy-300" />{t('article.sources')}</h2>
        <p class="mt-1.5 text-sm muted">{t('article.sourcesNote')}</p>
        <ul class="mt-4 grid gap-2 text-sm">
          {official.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-1">{s.name[lang] ?? s.name.en}<Icon name="external" class="size-3.5" /></a></li>)}
        </ul>
        {cited.length > 0 && (
          <>
            <p class="mt-5 text-xs font-semibold uppercase tracking-wide muted">{t('article.sourcesCited')}</p>
            <ul class="mt-2 grid gap-2 text-sm">
              {cited.map((c) => <li><a href={c.url} target="_blank" rel="noopener noreferrer" class="link">{c.text}</a> <span class="muted">({c.host})</span></li>)}
            </ul>
          </>
        )}
        <div class="mt-5 flex flex-col gap-3 border-t border-[var(--line)] pt-4 text-sm sm:flex-row sm:items-center sm:justify-between">
          <p class="inline-flex items-center gap-1.5 muted"><Icon name="refresh" class="size-4" /><time datetime={updated.toISOString()}>{t('article.lastUpdate', { date: formatDate(updated, lang) })}</time></p>
          {reportUrl && <a href={reportUrl} class="inline-flex items-center gap-1.5 font-semibold text-terracotta-600 hover:underline dark:text-terracotta-300" data-track="report_error_click"><Icon name="flag" class="size-4" />{t('article.report')}</a>}
        </div>
      </section>

      <AuthorBox lang={lang} name={d.author} />

      {tools.length > 0 && (
        <section class="reveal mt-12" aria-labelledby="rel-tools">
          <h2 id="rel-tools" class="text-[length:var(--step-3)]">{t('article.relatedTools')}</h2>
          <div class="mt-4"><ToolGrid lang={lang} keys={tools.map((x) => x.key)} compact /></div>
        </section>
      )}

      {cities.length > 0 && (
        <section class="reveal mt-10" aria-labelledby="rel-cities">
          <h2 id="rel-cities" class="text-[length:var(--step-3)]">{t('article.relatedCities')}</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {cities.map((c) => <li><a href={cityPath(lang, c.slug[lang])} class="badge badge-navy min-h-10 px-4 text-sm hover:brightness-95"><Icon name="mapPin" class="size-4" />{cityLabel(c.id, lang)}</a></li>)}
          </ul>
        </section>
      )}

      {news.length > 0 && (
        <section class="reveal mt-10" aria-labelledby="rel-news">
          <h2 id="rel-news" class="text-[length:var(--step-3)]">{t('news.related')}</h2>
          <ul class="mt-4 grid gap-2">
            {news.map((n) => <li><a href={`${hubPath(lang, 'news')}#n-${n.data.translationKey}`} class="card card-hover flex items-center gap-3 p-4 font-medium"><Icon name="stamp" class="size-5 shrink-0 text-navy-600 dark:text-navy-300" />{n.data.title}</a></li>)}
          </ul>
        </section>
      )}

      <AdSlot type="banner" lang={lang} />
    </article>

    <aside class="hidden lg:block" aria-label={t('article.onThisPage')}>
      <div class="sticky top-24 grid gap-6">
        {toc.length >= 3 && (
          <nav class="toc-sidebar text-sm" aria-label={t('article.onThisPage')}>
            <p class="eyebrow muted">{t('article.onThisPage')}</p>
            <ol class="mt-3 grid gap-1.5 border-s-2 border-[var(--line)]">
              {toc.map((h) => <li><a href={`#${h.slug}`} class="-ms-0.5 block border-s-2 border-transparent py-0.5 ps-4 muted hover:border-terracotta-500 hover:text-[var(--text)]">{h.text}</a></li>)}
            </ol>
          </nav>
        )}
        <div class="card p-5">
          <p class="font-semibold">{t('article.reco.title')}</p>
          <ul class="mt-3 grid gap-2.5 text-sm">
            <li class="flex items-center gap-2"><Icon name="wifi" class="size-4 shrink-0 muted" /><AffiliateLink provider="airalo">{essentials[0]}</AffiliateLink></li>
            <li class="flex items-center gap-2"><Icon name="bed" class="size-4 shrink-0 muted" /><AffiliateLink provider="booking" query="Morocco">{essentials[1]}</AffiliateLink></li>
            <li class="flex items-center gap-2"><Icon name="compass" class="size-4 shrink-0 muted" /><AffiliateLink provider="getyourguide" query="Morocco">{essentials[2]}</AffiliateLink></li>
            <li class="flex items-center gap-2"><Icon name="heart" class="size-4 shrink-0 muted" /><AffiliateLink provider="safetywing">{essentials[3]}</AffiliateLink></li>
          </ul>
          <p class="mt-4 text-xs muted">{t('article.reco.why')} {disclosureUrl && <a href={disclosureUrl} class="underline">{t('disclosure.link')}</a>}</p>
        </div>
        <AdSlot type="sidebar" lang={lang} />
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="reveal container-page mt-16" aria-labelledby="rel-guides">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="rel-guides" class="section-title">{t('article.next')}</h2>
        <a href={categoryPath(lang, d.category)} class="btn-tertiary btn inline-flex items-center gap-1.5 font-semibold">{t('article.parentCta', { topic: cat.label[lang] })}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a>
      </div>
      <div class="feature-list mt-6"><ArticleCard article={related[0]} /><div class="row-list">{related.slice(1).map((a) => <ArticleCard article={a} size="row" />)}</div></div>
    </section>
  )}
</div>
</BaseLayout>

<script>
  // Boutons qui exigent du JS : masqués par défaut, affichés ici (le lien WhatsApp fonctionne sans JS).
  document.querySelectorAll<HTMLButtonElement>('[data-article-actions] button').forEach((b) => (b.hidden = false));
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const label = b.querySelector('span')!;
    try {
      await navigator.clipboard.writeText(b.dataset.copy || location.href);
      const old = label.textContent;
      label.textContent = b.dataset.done || '';
      setTimeout(() => (label.textContent = old), 2000);
    } catch { window.prompt('', b.dataset.copy || location.href); }
  });

  // Scroll reveal : anime les éléments .reveal à leur entrée dans le viewport.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -60px 0px', threshold: 0.1 },
    );
    document.querySelectorAll('.reveal, .stagger-reveal').forEach((el) => io.observe(el));
  } else {
    // Afficher directement sans animation.
    document.querySelectorAll('.reveal, .stagger-reveal').forEach((el) => el.classList.add('is-visible'));
  }
</script>
