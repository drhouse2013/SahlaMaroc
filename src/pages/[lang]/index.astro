---
/** Accueil localisé : /en, /fr, /es, /de, /ar */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import Journeys from '../../components/home/Journeys.astro';
import EditorNote from '../../components/home/EditorNote.astro';
import CityGrid from '../../components/home/CityGrid.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import Newsletter from '../../components/Newsletter.astro';
import AdSlot from '../../components/AdSlot.astro';
import Icon from '../../components/Icon.astro';
import { LOCALES, useTranslations, type Locale } from '../../i18n';
import { allChecklists } from '../../utils/content';
import { allLocalesAlternates, allLocalesTargets, getArticleByKey, getPageUrl, homePath, hubPath } from '../../utils/i18n';
import { organizationJsonLd, websiteJsonLd } from '../../utils/seo';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const homeSeo: Record<Locale, [string, string]> = {"fr":["Maroc : guides MRE, voyages et calculateurs gratuits","Préparez votre retour ou votre voyage au Maroc : guides pratiques, ferries, démarches, immobilier et calculateurs gratuits pour MRE et voyageurs."],"en":["Morocco travel guides, MRE advice & free calculators","Plan your Morocco trip or return home with practical guides, ferry information, property advice and free calculators for MREs and visitors."],"es":["Marruecos: guías, diáspora y calculadoras gratuitas","Prepara tu viaje o regreso a Marruecos: guías prácticas, ferris, trámites, vivienda y calculadoras gratuitas para la diáspora y los visitantes."],"de":["Marokko: Reiseführer, MRE-Tipps & kostenlose Rechner","Planen Sie Ihre Reise oder Rückkehr nach Marokko: praktische Guides, Fähren, Formalitäten, Immobilien und kostenlose Rechner für MRE und Besucher."],"ar":["المغرب: أدلة عملية لمغاربة العالم والزوار وحاسبات مجانية","خطط لرحلتك أو عودتك إلى المغرب مع أدلة عملية حول العبّارات والإجراءات والعقار وحاسبات مجانية لمغاربة العالم والزوار."]};
const toolUrl = await getPageUrl(lang, 'calculators');
const POPULAR = ['marhaba-guide', 'car-180-days', 'send-money', 'buy-property-abroad', 'e-visa', 'sim-esim-morocco'];
const popular = (await Promise.all(POPULAR.map((k) => getArticleByKey(lang, k)))).filter((a) => a !== null);
const availableChecklists = await allChecklists(lang);
const checklistKeys = ['summer-checklist', 'buy-property-abroad', 'kids-pets'];
const checklists = checklistKeys.flatMap(key => {
  const item = availableChecklists.find(c => c.article.data.translationKey === key);
  return item ? [item] : [];
});
const checklistsUrl = hubPath(lang, 'checklists');
---

<BaseLayout lang={lang} title={homeSeo[lang][0]} description={homeSeo[lang][1]} alternates={allLocalesAlternates(homePath)} switchTargets={allLocalesTargets(homePath)} jsonLd={[websiteJsonLd(lang, Astro.site, t('site.description')), organizationJsonLd(Astro.site)]}>
  <div class="home-redesign">
    <Hero lang={lang} />
    <Journeys lang={lang} />
    <section class="container-page section new-tools-section" aria-labelledby="tools-title">
      <div class="new-section-head"><div><p class="eyebrow">{t('nav.tools')}</p><h2 id="tools-title" class="section-title mt-3">{t('home.tools.title')}</h2><p class="section-sub">{t('home.tools.sub')}</p></div>{toolUrl && <a href={toolUrl} class="new-text-link">{t('common.seeAll')}<span aria-hidden="true">↗</span></a>}</div>
      <div class="mt-8"><ToolGrid lang={lang} keys={['calc-property-fees', 'calc-mortgage', 'calc-transfer', 'calc-summer', 'calc-car-days', 'calc-ferry-compare']} /></div>
    </section>
    {popular.length > 0 && <section class="container-page section" aria-labelledby="popular-title">
      <div class="new-section-head"><div><p class="eyebrow">{t('nav.guides')}</p><h2 id="popular-title" class="section-title mt-3">{t('home.popular')}</h2><p class="section-sub">{t('home.popularSub')}</p></div><a href={hubPath(lang,'guides')} class="new-text-link">{t('nav.allGuides')}<span aria-hidden="true">↗</span></a></div>
      <div class="new-guide-feature"><ArticleCard article={popular[0]} /><div class="new-guide-list">{popular.slice(1).map(a=><ArticleCard article={a} size="sm" />)}</div></div>
    </section>}
    <CityGrid lang={lang} ids={['casablanca','rabat','fes','taghazout']} limit={4} />
    {checklists.length > 0 && <section class="container-page section" aria-labelledby="chk-title"><div class="new-checklists"><div><p class="eyebrow">{t('nav.checklists')}</p><h2 id="chk-title" class="section-title mt-3">{t('home.checklists.title')}</h2><p class="section-sub">{t('home.checklists.text')}</p><a href={checklistsUrl} class="btn btn-primary mt-6">{t('home.checklists.cta')}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a></div><ul>{checklists.map(c=><li><a href={`/${lang}/${c.article.data.slug}#checklist-${c.id}`}><Icon name="listChecks" class="size-5 shrink-0" /><span>{c.title}</span><span class="muted">{t('checklists.items',{n:c.items})}</span></a></li>)}</ul></div></section>}
    <EditorNote lang={lang} />
    <Newsletter lang={lang} />
    <div class="container-page"><AdSlot type="banner" lang={lang} /></div>
  </div>
</BaseLayout>
