---
/** Accueil localisé : /en, /fr, /es, /de, /ar */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import CityGrid from '../../components/home/CityGrid.astro';
import FactsBand from '../../components/home/FactsBand.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import Newsletter from '../../components/Newsletter.astro';
import AdSlot from '../../components/AdSlot.astro';
import Icon from '../../components/Icon.astro';
import { LOCALES, useTranslations, type Locale } from '../../i18n';
import { CATEGORIES, CATEGORY_ICON } from '../../i18n/categories';
import { allChecklists } from '../../utils/content';
import { allLocalesAlternates, allLocalesTargets, categoryPath, getActiveCategories, getArticleByKey, getArticles, getPageUrl, homePath, hubPath } from '../../utils/i18n';
import { organizationJsonLd, websiteJsonLd } from '../../utils/seo';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const articles = await getArticles(lang);
const toolUrl = await getPageUrl(lang, 'calculators');
const active = await getActiveCategories(lang);
const POPULAR = ['marhaba-guide', 'car-180-days', 'send-money', 'buy-property-abroad', 'e-visa', 'sim-esim-morocco'];
const popular = (await Promise.all(POPULAR.map((k) => getArticleByKey(lang, k)))).filter((a) => a !== null);
const latest = articles.slice(0, 6);
const checklists = (await allChecklists(lang)).slice(0, 3);
const checklistsUrl = hubPath(lang, 'checklists');
const why = [
  { icon: 'lightbulb', title: t('home.why.1.title'), text: t('home.why.1.text') },
  { icon: 'shield', title: t('home.why.2.title'), text: t('home.why.2.text') },
  { icon: 'refresh', title: t('home.why.3.title'), text: t('home.why.3.text') },
  { icon: 'users', title: t('home.why.4.title'), text: t('home.why.4.text') },
] as const;
---

<BaseLayout lang={lang} title={t('site.tagline')} alternates={allLocalesAlternates(homePath)} switchTargets={allLocalesTargets(homePath)} jsonLd={[websiteJsonLd(lang, Astro.site, t('site.description')), organizationJsonLd(Astro.site)]}>
  <Hero lang={lang} />

  <section class="container-page section" aria-labelledby="tools-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="tools-title" class="section-title">{t('home.tools.title')}</h2>
        <p class="section-sub">{t('home.tools.sub')}</p>
      </div>
      {toolUrl && <a href={toolUrl} class="btn btn-ghost btn-sm">{t('common.seeAll')}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a>}
    </div>
    <div class="mt-8"><ToolGrid lang={lang} /></div>
  </section>

  <section class="container-page section" aria-labelledby="why-title">
    <h2 id="why-title" class="section-title">{t('home.why.title')}</h2>
    <p class="section-sub">{t('home.why.sub')}</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {why.map((w) => (
        <li class="card p-5">
          <span class="icon-tile"><Icon name={w.icon} class="size-[1.35rem]" /></span>
          <h3 class="mt-4 text-lg font-semibold">{w.title}</h3>
          <p class="mt-1.5 text-sm muted">{w.text}</p>
        </li>
      ))}
    </ul>
  </section>

  {popular.length > 0 && (
    <section class="container-page section" aria-labelledby="popular-title">
      <h2 id="popular-title" class="section-title">{t('home.popular')}</h2>
      <p class="section-sub">{t('home.popularSub')}</p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{popular.map((a) => <ArticleCard article={a} />)}</div>
    </section>
  )}

  {active.length > 0 && (
    <nav class="container-page section" aria-label={t('home.categories')}>
      <h2 class="section-title">{t('home.categories')}</h2>
      <ul class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4">
        {active.map((id) => (
          <li class="min-w-0">
            <a href={categoryPath(lang, id)} class="card card-hover flex min-h-14 items-center gap-2 px-3 py-3 text-[0.95rem] font-medium sm:gap-3 sm:px-4">
              <span class="icon-tile size-8 shrink-0 sm:size-10"><Icon name={CATEGORY_ICON[id]} /></span><span class="min-w-0 [overflow-wrap:anywhere]">{CATEGORIES[id].label[lang]}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <CityGrid lang={lang} />

  {checklists.length > 0 && (
    <section class="container-page section" aria-labelledby="chk-title">
      <div class="card grid items-center gap-6 p-6 sm:p-9 md:grid-cols-[1fr_1fr]">
        <div>
          <span class="icon-tile"><Icon name="listChecks" class="size-[1.35rem]" /></span>
          <h2 id="chk-title" class="mt-4 text-2xl font-semibold sm:text-3xl">{t('home.checklists.title')}</h2>
          <p class="mt-2 muted">{t('home.checklists.text')}</p>
          <a href={checklistsUrl} class="btn btn-primary mt-6">{t('home.checklists.cta')}</a>
        </div>
        <ul class="grid gap-2">
          {checklists.map((c) => (
            <li><a href={`/${lang}/${c.article.data.slug}#checklist-${c.id}`} class="flex items-center justify-between gap-3 rounded-2xl border border-[var(--line)] px-4 py-3 hover:bg-[var(--surface-3)]"><span class="font-medium">{c.title}</span><span class="text-xs muted">{t('checklists.items', { n: c.items })}</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <FactsBand lang={lang} />

  {latest.length > 0 && (
    <section class="container-page section" aria-labelledby="latest-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="latest-title" class="section-title">{t('home.latest')}</h2>
        <a href={hubPath(lang, 'guides')} class="btn btn-ghost btn-sm">{t('nav.allGuides')}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{latest.map((a) => <ArticleCard article={a} />)}</div>
    </section>
  )}

  <Newsletter lang={lang} />
  <div class="container-page"><AdSlot type="banner" lang={lang} /></div>
</BaseLayout>
