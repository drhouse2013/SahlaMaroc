---
/** Accueil localisé : /en, /fr, /es, /de, /ar */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import PersonaPaths from '../../components/home/PersonaPaths.astro';
import CityGrid from '../../components/home/CityGrid.astro';
import FactsBand from '../../components/home/FactsBand.astro';
import ToursGrid from '../../components/home/ToursGrid.astro';
import DarijaStrip from '../../components/home/DarijaStrip.astro';
import Faq from '../../components/home/Faq.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import { LOCALES, useTranslations, type Locale } from '../../i18n';
import { CATEGORIES } from '../../i18n/categories';
import { FACTS, L, pick } from '../../data/home';
import { allLocalesAlternates, categoryPath, getActiveCategories, getArticles, getPageUrl, homePath } from '../../utils/i18n';
import { illustration } from '../../utils/illustrations';
import { formatDate } from '../../utils/date';
import { websiteJsonLd } from '../../utils/seo';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const articles = await getArticles(lang);
const featured = articles.find((a) => a.data.featured) ?? articles[0];
const latest = articles.filter((a) => a !== featured).slice(0, 6);
const toolUrl = await getPageUrl(lang, 'calculators');
const active = await getActiveCategories(lang);
const counts = Object.fromEntries(active.map((id) => [id, articles.filter((a) => a.data.category === id).length]));
const facts = pick(FACTS, lang);
const lastUpdate = articles.reduce((d, a) => Math.max(d, (a.data.updatedDate ?? a.data.pubDate).valueOf()), 0);
const stats = [
  `${articles.length} ${L.statGuides[lang]}`,
  `5 ${L.statLangs[lang]}`,
  ...(lastUpdate ? [`${L.statUpdated[lang]} ${formatDate(new Date(lastUpdate), lang, 'short')}`] : []),
];
---

<BaseLayout lang={lang} title={t('site.tagline')} alternates={allLocalesAlternates(homePath)} jsonLd={[websiteJsonLd(lang, Astro.site, t('site.description'))]}>
  <HeroSection
    eyebrow={L.heroEyebrow[lang]}
    title={t('home.hero.title')}
    subtitle={t('home.hero.subtitle')}
    primary={featured ? { href: `/${lang}/${featured.data.slug}`, label: t('home.hero.cta') } : undefined}
    secondary={toolUrl ? { href: toolUrl, label: t('home.hero.ctaSecondary') } : undefined}
    scene="marrakech"
    chips={[facts[0], facts[2]]}
    stats={articles.length ? stats : []}
  />

  {
    active.length > 0 && (
      <nav class="mx-auto max-w-6xl px-4" aria-label={t('home.categories')}>
        <ul class="flex flex-wrap gap-2">
          {active.map((id) => (
            <li>
              <a href={categoryPath(lang, id)} class="card flex items-center gap-2 px-4 py-2.5 text-sm font-medium transition hover:border-terracotta-500">
                <span aria-hidden="true">{CATEGORIES[id].icon}</span>{CATEGORIES[id].label[lang]}
                <span class="rounded-full bg-sand-100 px-2 text-xs dark:bg-white/10">{counts[id]}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {articles.length > 0 && <PersonaPaths lang={lang} />}

  <section class="mx-auto max-w-6xl px-4 pt-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold sm:text-4xl">🧮 {L.toolsTitle[lang]}</h2>
        <p class="mt-2 max-w-2xl text-ink-900/75 dark:text-sand-100/75">{L.toolsSub[lang]}</p>
      </div>
      {toolUrl && <a href={toolUrl} class="btn btn-ghost">{t('nav.tools')}</a>}
    </div>
    <div class="mt-8"><ToolGrid lang={lang} /></div>
  </section>

  {
    featured && (
      <section class="mx-auto max-w-6xl px-4 pt-24">
        <h2 class="text-3xl font-bold sm:text-4xl">{t('home.latest')}</h2>
        <div class="mt-8"><ArticleCard article={featured} size="lg" /></div>
        {latest.length > 0 && <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{latest.map((a) => <ArticleCard article={a} />)}</div>}
      </section>
    )
  }

  <CityGrid lang={lang} />
  <FactsBand lang={lang} />
  <ToursGrid lang={lang} />

  <section class="mx-auto max-w-6xl px-4 pt-24">
    <div class="grid items-center gap-8 overflow-hidden rounded-[2rem] bg-terracotta-600 text-white md:grid-cols-2">
      <div class="p-8 sm:p-12">
        <p class="eyebrow text-white">⚽ 2030</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{L.y2030Title[lang]}</h2>
        <p class="mt-3 max-w-md text-white/90">{L.y2030Text[lang]}</p>
        <a href="#cities" class="btn mt-7 bg-white text-terracotta-700 hover:bg-sand-100">{L.citiesTitle[lang]}</a>
      </div>
      <Image src={illustration('casablanca')} alt="" width={700} loading="lazy" class="h-full max-h-80 w-full object-cover md:max-h-none" />
    </div>
  </section>

  <DarijaStrip lang={lang} />
  <Faq lang={lang} />
  <div class="mx-auto max-w-6xl px-4"><AdSlot type="banner" lang={lang} /></div>
</BaseLayout>
