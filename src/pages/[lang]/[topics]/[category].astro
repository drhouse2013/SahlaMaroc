---
/** Pages catégorie : /en/topics/arrival, /fr/themes/arrivee, /ar/mawadi/wusul… */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { LOCALES, TOPICS_SEGMENT, isIndexable, useTranslations, type Locale } from '../../../i18n';
import { CATEGORIES, type CategoryId } from '../../../i18n/categories';
import { categoryPath, getActiveCategories, getArticles, homePath, type Alternates } from '../../../utils/i18n';
import { absoluteUrl, breadcrumbJsonLd } from '../../../utils/seo';

export async function getStaticPaths() {
  // Seules les catégories avec au moins un article sont générées (pas de pages vides indexables).
  const perLang = await Promise.all(LOCALES.map(async (lang) => ({ lang, ids: await getActiveCategories(lang) })));
  return perLang.flatMap(({ lang, ids }) =>
    ids.map((id) => ({
      params: { lang, topics: TOPICS_SEGMENT[lang], category: CATEGORIES[id].slug[lang] },
      props: { id },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const { id } = Astro.props as { id: CategoryId };
const t = useTranslations(lang);
const label = CATEGORIES[id].label[lang];
const articles = (await getArticles(lang)).filter((a) => a.data.category === id);
// hreflang seulement vers les langues où cette catégorie existe ET est indexable
const alternates: Alternates = {};
for (const l of LOCALES) if (isIndexable(l) && (await getActiveCategories(l)).includes(id)) alternates[l] = categoryPath(l, id);
alternates[lang] = categoryPath(lang, id);
const crumbs = [{ name: t('breadcrumb.home'), href: homePath(lang) }, { name: label }];
---

<BaseLayout
  lang={lang}
  title={t('category.title', { topic: label })}
  alternates={alternates}
  jsonLd={[breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: absoluteUrl(c.href ?? Astro.url.pathname, Astro.site) })))]}
>
  <div class="zellige-soft border-b border-ink-900/5 dark:border-white/5">
    <div class="mx-auto max-w-6xl px-4 pt-8 pb-12">
      <Breadcrumbs items={crumbs} />
      <p class="mt-8 text-5xl" aria-hidden="true">{CATEGORIES[id].icon}</p>
      <h1 class="mt-3 text-4xl font-bold sm:text-5xl">{label}</h1>
      <p class="mt-3 text-ink-900/75 dark:text-sand-100/75">{articles.length} {articles.length > 1 ? 'guides' : 'guide'}</p>
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-4 pt-10">
    {
      articles.length ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{articles.map((a) => <ArticleCard article={a} />)}</div>
      ) : (
        <p class="mt-6 text-ink-900/70 dark:text-sand-100/70">{t('category.empty')}</p>
      )
    }
    <AdSlot type="banner" lang={lang} />
  </div>
</BaseLayout>
