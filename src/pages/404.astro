---
/** 404 : servie automatiquement par Vercel/Netlify. Anglais par défaut (langue inconnue). */
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';
import { allLocalesAlternates, homePath } from '../utils/i18n';
const t = useTranslations('en');
---

<BaseLayout lang="en" title={t('404.title')} alternates={allLocalesAlternates(homePath)} noindex>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-6xl">🐪</p>
    <h1 class="mt-4 text-3xl font-extrabold">{t('404.title')}</h1>
    <p class="mt-3 text-ink-900/70 dark:text-sand-100/70">{t('404.text')}</p>
    <a href="/en" class="mt-8 inline-block rounded-full bg-terracotta-600 px-6 py-3 font-semibold text-white">{t('404.back')}</a>
  </div>
</BaseLayout>
