---
/**
 * 404 : servie automatiquement par Vercel/Netlify pour toute URL inconnue (langue inconnue => anglais).
 * Pour /fr/…, /es/…, /de/…, /ar/… le script charge la variante localisée /404-<lang>/ (interface complète, RTL inclus).
 */
import NotFound from '../components/NotFound.astro';
import { LOCALES } from '../i18n';
const others = LOCALES.filter((l) => l !== 'en');
---
<NotFound lang="en" />
<script is:inline define:vars={{ others }}>
  (function () {
    var l = location.pathname.split('/')[1];
    if (others.indexOf(l) < 0) return;
    fetch('/404-' + l).then(function (r) { return r.ok ? r.text() : Promise.reject(); }).then(function (h) {
      var d = document;
      d.open(); d.write(h); d.close();
      d.documentElement.lang = l; d.documentElement.dir = l === 'ar' ? 'rtl' : 'ltr';
    }).catch(function () {});
  })();
</script>
