---
/** FAQ en <details> natif (zéro JS). */
import type { Locale } from '../../i18n';
import { FAQ, L, pick } from '../../data/home';
interface Props { lang: Locale }
const { lang } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 pt-24">
  <h2 class="text-center text-3xl font-bold sm:text-4xl">{L.faqTitle[lang]}</h2>
  <div class="mt-8 grid gap-3">
    {pick(FAQ, lang).map((f) => (
      <details class="group card px-6 py-5 open:shadow-lg">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
          {f.q}
          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-sand-100 transition group-open:rotate-45 dark:bg-white/10" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 leading-relaxed text-ink-900/80 dark:text-sand-100/80">{f.a}</p>
      </details>
    ))}
  </div>
</section>
