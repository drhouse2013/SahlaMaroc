---
/** Mini lexique darija : contenu utile, partageable, et signal d'expertise locale. */
import type { Locale } from '../../i18n';
import { DARIJA, L, pick } from '../../data/home';
import { entryPath, getArticleByKey } from '../../utils/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const guide = await getArticleByKey(lang, 'darija-phrases');
---

<section class="mx-auto max-w-6xl px-4 pt-24">
  <div class="rounded-[2rem] bg-emerald-moroccan-600 p-8 text-white sm:p-12 dark:bg-emerald-moroccan-600/40">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl font-bold sm:text-4xl">{L.darijaTitle[lang]}</h2>
      {guide && <a href={entryPath(lang, guide.data.slug)} class="btn bg-white text-emerald-moroccan-600 hover:bg-sand-100">{L.readGuide[lang]}</a>}
    </div>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {DARIJA.map((p) => (
        <li class="rounded-2xl bg-black/15 p-5">
          <p class="font-display text-2xl text-saffron-400" lang="ar" dir="rtl">{p.ar}</p>
          <p class="mt-1 font-semibold text-white">{p.latin}</p>
          <p class="mt-1 text-sm text-white">{pick(p.meaning, lang)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
