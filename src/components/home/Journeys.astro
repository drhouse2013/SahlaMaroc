---
import { PERSONAS, L, pick } from '../../data/home';
import { getArticleByKey } from '../../utils/i18n';
import { type Locale } from '../../i18n';
import Icon from '../Icon.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const journeys = await Promise.all(pick(PERSONAS, lang).map(async (p) => ({ ...p, articles: (await Promise.all(p.keys.map(k => getArticleByKey(lang, k)))).filter(a => a !== null) })));
---
<section class="container-page section" aria-labelledby="journey-title">
  <p class="eyebrow text-[var(--accent)]">{L.essentials[lang]}</p>
  <h2 id="journey-title" class="section-title mt-3 max-w-3xl">{L.personasTitle[lang]}</h2>
  <div class="needs">
    {journeys.map((p, i) => <article class="need">
      <span class="need__num" aria-hidden="true">0{i + 1}</span>
      <h3>{p.title}</h3>
      <p>{lang === 'fr' ? p.text.replace('Acheter sans risque à distance', 'Préparer un achat à distance') : p.text}</p>
      <ul>{p.articles.map(a => <li><a href={`/${lang}/${a.data.slug}`}><span>{a.data.title}</span><Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a></li>)}</ul>
    </article>)}
  </div>
</section>
