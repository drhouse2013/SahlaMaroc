---
import { PERSONAS, L, pick } from '../../data/home';
import { getArticleByKey } from '../../utils/i18n';
import { useTranslations, type Locale } from '../../i18n';
import Icon from '../Icon.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const journeys = await Promise.all(pick(PERSONAS, lang).map(async (p) => ({ ...p, articles: (await Promise.all(p.keys.map(k => getArticleByKey(lang, k)))).filter(a => a !== null) })));
const icons = ['ship', 'home', 'compass'] as const;
---
<section class="container-page section journey-section" aria-labelledby="journey-title">
  <p class="eyebrow muted">{L.essentials[lang]}</p>
  <h2 id="journey-title" class="section-title mt-3">{L.personasTitle[lang]}</h2>
  <div class="journey-grid">
    {journeys.map((p, i) => <article class="journey-card">
      <div class="journey-card__top"><Icon name={icons[i]} class="size-6" /><span aria-hidden="true">0{i + 1}</span></div>
      <h3>{p.title}</h3><p class="muted">{lang === 'fr' ? p.text.replace('Acheter sans risque à distance', 'Préparer un achat à distance') : p.text}</p>
      <ul>{p.articles.map(a => <li><a href={`/${lang}/${a.data.slug}`}><span>{a.data.title}</span><Icon name="arrowRight" class="size-4 shrink-0 rtl:-scale-x-100" /></a></li>)}</ul>
    </article>)}
  </div>
</section>
