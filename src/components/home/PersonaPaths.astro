---
/** Trois parcours selon le profil du visiteur : chaque carte renvoie vers 3 guides. */
import type { Locale } from '../../i18n';
import { L, PERSONAS, pick } from '../../data/home';
import { entryPath, getArticleByKey } from '../../utils/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const personas = await Promise.all(
  pick(PERSONAS, lang).map(async (p) => ({
    ...p,
    links: (await Promise.all(p.keys.map((k) => getArticleByKey(lang, k)))).filter((a) => a !== null),
  })),
);
const tints = [
  'bg-terracotta-50 dark:bg-terracotta-700/20',
  'bg-majorelle-50 dark:bg-majorelle-700/25',
  'bg-emerald-moroccan-100 dark:bg-emerald-moroccan-600/20',
];
---

<section class="mx-auto max-w-6xl px-4 pt-20">
  <h2 class="max-w-2xl text-3xl font-bold sm:text-4xl">{L.personasTitle[lang]}</h2>
  <div class="mt-8 grid gap-5 md:grid-cols-3">
    {
      personas.map((p, i) => (
        <div class:list={['flex flex-col rounded-3xl p-6', tints[i]]}>
          <span class="text-4xl" aria-hidden="true">{p.icon}</span>
          <h3 class="mt-4 text-xl font-bold">{p.title}</h3>
          <p class="mt-2 text-ink-900/75 dark:text-sand-100/75">{p.text}</p>
          <ul class="mt-5 grid gap-2 border-t border-ink-900/10 pt-4 dark:border-white/10">
            {p.links.map((a) => (
              <li>
                <a href={entryPath(lang, a.data.slug)} class="flex items-start gap-2 font-medium hover:text-terracotta-600 dark:hover:text-terracotta-300">
                  <span aria-hidden="true" class="mt-0.5 text-terracotta-600 rtl:-scale-x-100 dark:text-terracotta-300">→</span>
                  <span>{a.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
