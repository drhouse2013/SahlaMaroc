---
/**
 * Les trois bandeaux de la maquette : « Je rentre au Maroc », « Je souhaite investir »,
 * « Je visite le Maroc ». Photo éditoriale du site + voile coloré + texte traduit.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import PhotoCredit from '../PhotoCredit.astro';
import { PATHS, pathPhoto } from '../../data/paths';
import { placePhoto } from '../../utils/photos';
import { hubPath } from '../../utils/i18n';
import type { Locale } from '../../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;

const returnPhoto = pathPhoto('return', lang);
const investPhoto = pathPhoto('invest', lang);
const visitPlace = placePhoto('city', 'ouarzazate', lang);

interface Card {
  id: 'return' | 'invest' | 'visit';
  href: string;
  icon: 'plane' | 'building' | 'map';
  title: string;
  text: string;
  media: ImageMetadata | null;
  credit: string | null;
  source: string | null;
  alt: string;
  rust?: boolean;
}

const cards: Card[] = [
  {
    id: 'return',
    href: hubPath(lang, 'mre'),
    icon: 'plane',
    title: PATHS.return.title[lang],
    text: PATHS.return.text[lang],
    media: returnPhoto?.src ?? null,
    credit: returnPhoto?.credit ?? null,
    source: null,
    alt: returnPhoto?.alt ?? '',
  },
  {
    id: 'invest',
    href: hubPath(lang, 'invest'),
    icon: 'building',
    title: PATHS.invest.title[lang],
    text: PATHS.invest.text[lang],
    media: investPhoto?.src ?? null,
    credit: investPhoto?.credit ?? null,
    source: null,
    alt: investPhoto?.alt ?? '',
    rust: true,
  },
  {
    id: 'visit',
    href: hubPath(lang, 'visit'),
    icon: 'map',
    title: PATHS.visit.title[lang],
    text: PATHS.visit.text[lang],
    media: visitPlace.image,
    credit: visitPlace.credit,
    source: visitPlace.source,
    alt: visitPlace.alt,
  },
];
const cta = { fr: 'Découvrir', en: 'Explore', es: 'Descubrir', de: 'Entdecken', ar: 'اكتشف' }[lang];
---

<div class="tpl-features">
  <div class="tpl-features__grid">
    {cards.map((card) => (
      <div class:list={['tpl-feature', card.rust && 'tpl-feature--rust']} data-path={card.id}>
        {card.media && (
          <Image
            src={card.media}
            alt={card.alt}
            widths={[420, 640, 900]}
            sizes="(min-width: 1000px) 31vw, (min-width: 650px) 33vw, 92vw"
            class="tpl-feature__media"
            loading={card.id === 'return' ? 'eager' : 'lazy'}
          />
        )}
        <Icon name={card.icon} class="size-6 tpl-feature__icon" />
        <h2>{card.title}</h2>
        <p>{card.text}</p>
        <span class="tpl-feature__arrow" aria-hidden="true"><Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></span>
        <a class="tpl-feature__link" href={card.href}><span class="sr-only">{card.title} — {cta}</span></a>
        {card.credit && <PhotoCredit lang={lang} credit={card.credit} source={card.source} />}
      </div>
    ))}
  </div>
</div>
