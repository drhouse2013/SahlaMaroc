---
/**
 * Héros de l'accueil (maquette Sahla Maroc) : panorama de Tanger, titre serif, recherche
 * et quatre bénéfices. Le panorama est optimisé (srcset) ; le texte est traduit.
 */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import heroPanorama from '../../assets/template/hero-panorama.webp';
import { useTranslations, type Locale } from '../../i18n';
import { hubPath } from '../../utils/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  fr: {
    title: 'Le Maroc,', em: 'simplement.',
    intro: ['Guides pratiques, démarches, investissement, voyage et outils pour les Marocains du ', 'monde', ' et tous les voyageurs.'],
    placeholder: 'Rechercher un guide, une démarche, une ville…',
    cta: 'Rechercher',
    benefits: ['Guides fiables', 'Outils pratiques', 'Spécial MRE', '100% gratuit'],
    photo: 'Tanger au coucher du soleil, panorama du site Sahla Maroc',
  },
  en: {
    title: 'Morocco,', em: 'made simple.',
    intro: ['Practical guides, paperwork, investing, travel and tools for Moroccans ', 'abroad', ' and every visitor.'],
    placeholder: 'Search a guide, a procedure, a city…',
    cta: 'Search',
    benefits: ['Trusted guides', 'Practical tools', 'Built for MREs', '100% free'],
    photo: 'Tangier at sunset, Sahla Maroc panorama',
  },
  es: {
    title: 'Marruecos,', em: 'sin complicaciones.',
    intro: ['Guías prácticas, trámites, inversión, viajes y herramientas para los marroquíes ', 'en el mundo', ' y todos los viajeros.'],
    placeholder: 'Buscar una guía, un trámite, una ciudad…',
    cta: 'Buscar',
    benefits: ['Guías fiables', 'Herramientas prácticas', 'Para la diáspora', '100% gratis'],
    photo: 'Tánger al atardecer, panorama de Sahla Maroc',
  },
  de: {
    title: 'Marokko,', em: 'ganz einfach.',
    intro: ['Praktische Ratgeber, Formalitäten, Investieren, Reisen und Rechner für Marokkaner ', 'im Ausland', ' und alle Reisenden.'],
    placeholder: 'Ratgeber, Formalität oder Stadt suchen…',
    cta: 'Suchen',
    benefits: ['Verlässliche Ratgeber', 'Praktische Rechner', 'Für Marokkaner im Ausland', '100 % kostenlos'],
    photo: 'Tanger bei Sonnenuntergang, Panorama von Sahla Maroc',
  },
  ar: {
    title: 'المغرب،', em: 'ببساطة.',
    intro: ['أدلة عملية وإجراءات واستثمار وسفر وأدوات لمغاربة ', 'العالم', ' ولجميع الزوار.'],
    placeholder: 'ابحث عن دليل أو إجراء أو مدينة…',
    cta: 'ابحث',
    benefits: ['أدلة موثوقة', 'أدوات عملية', 'لمغاربة العالم', '100٪ مجانًا'],
    photo: 'طنجة عند الغروب، بانوراما موقع ساهلة المغرب',
  },
}[lang];

const searchUrl = hubPath(lang, 'search');
const benefitIcons = ['book', 'sparkles', 'users', 'shield'] as const;
---

<section class="tpl-hero" aria-labelledby="home-title">
  <Image
    src={heroPanorama}
    alt={copy.photo}
    widths={[640, 960, 1440, 2172]}
    sizes="100vw"
    class="tpl-hero__media"
    loading="eager"
    fetchpriority="high"
    quality={72}
  />
  <div class="tpl-hero__shade" aria-hidden="true"></div>
  <div class="tpl-hero__content">
    <h1 id="home-title">{copy.title} <em>{copy.em}</em></h1>
    <p class="tpl-hero__intro">{copy.intro[0]}<u>{copy.intro[1]}</u>{copy.intro[2]}</p>
    <form class="tpl-search" action={searchUrl} method="get" role="search">
      <Icon name="search" class="size-5" />
      <input type="search" name="q" placeholder={copy.placeholder} aria-label={t('nav.search')} required />
      <button type="submit">{copy.cta}</button>
    </form>
    <div class="tpl-benefits">
      {copy.benefits.map((label, i) => (
        <span class="tpl-benefit">
          <Icon name={benefitIcons[i]} class="size-5" />
          <span>{label}</span>
          {i < copy.benefits.length - 1 && <i aria-hidden="true"></i>}
        </span>
      ))}
    </div>
  </div>
</section>
