---
/** Premier écran de l'accueil : titre, chapô, les trois parcours, puis la recherche. */
import Icon from '../Icon.astro';
import PathCard from '../paths/PathCard.astro';
import { useTranslations, type Locale } from '../../i18n';
import { PATH_ORDER, PATH_UI } from '../../data/paths';
import { hubPath } from '../../utils/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = {
 fr: { title: 'Le Maroc,', titleEm: 'simplement.', intro: 'Votre retour, votre investissement ou votre voyage au Maroc, étape par étape. Guides et outils gratuits.', search: 'Rechercher un guide', placeholder: 'Une ville, une démarche, une envie…' },
 en: { title: 'Morocco,', titleEm: 'made simple.', intro: 'Plan your return, investment or trip to Morocco, step by step. Free guides and tools.', search: 'Search the guides', placeholder: 'A city, a question, an idea…' },
 es: { title: 'Marruecos,', titleEm: 'sin complicaciones.', intro: 'Prepara tu regreso, inversión o viaje a Marruecos, paso a paso. Guías y herramientas gratuitas.', search: 'Buscar una guía', placeholder: 'Una ciudad, una pregunta, una idea…' },
 de: { title: 'Marokko,', titleEm: 'ganz einfach.', intro: 'Rückkehr, Investition oder Reise nach Marokko: Schritt für Schritt planen. Kostenlose Ratgeber und Rechner.', search: 'Ratgeber durchsuchen', placeholder: 'Eine Stadt, eine Frage, eine Idee…' },
 ar: { title: 'المغرب،', titleEm: 'ببساطة.', intro: 'خطّط لعودتك أو استثمارك أو رحلتك إلى المغرب، خطوة بخطوة. أدلة وأدوات مجانية.', search: 'ابحث في الأدلة', placeholder: 'مدينة، سؤال، فكرة…' },
}[lang];
const searchUrl = hubPath(lang, 'search');
---
<section class="home-hero" aria-labelledby="home-title">
  <div class="container-page home-hero__grid">
    <h1 id="home-title">{copy.title} <em>{copy.titleEm}</em></h1>
    <p class="home-hero__intro">{copy.intro}</p>
    <div class="home-paths" data-home-paths>
      <h2 class="home-paths__title">{PATH_UI.paths[lang]}</h2>
      <ul class="path-cards">
        {PATH_ORDER.map((id, i) => <li><PathCard id={id} lang={lang} eager priority={i === 0} /></li>)}
      </ul>
    </div>
    <form class="home-search" action={searchUrl} method="get" role="search">
      <label for="home-query">{copy.search}</label>
      <div><Icon name="search" class="size-5 shrink-0 muted" /><input id="home-query" name="q" type="search" placeholder={copy.placeholder} required /><button class="btn btn-primary btn-sm" type="submit">{t('nav.search')}</button></div>
    </form>
  </div>
</section>
