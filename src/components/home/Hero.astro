---
/** Premier écran de l'accueil : titre, chapô, les trois parcours, puis la recherche. */
import Icon from '../Icon.astro';
import PathCard from '../paths/PathCard.astro';
import { useTranslations, type Locale } from '../../i18n';
import { PATH_ORDER, PATH_UI } from '../../data/paths';
import { hubPath } from '../../utils/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = {
 fr: { title: 'Le Maroc,', titleEm: 'simplement.', intro: 'Guides pratiques, checklists et calculateurs gratuits pour avancer au Maroc, étape par étape.', search: 'Rechercher un guide', placeholder: 'Une ville, une démarche, une envie…' },
 en: { title: 'Morocco,', titleEm: 'made simple.', intro: 'Practical guides, checklists and free calculators for your next steps in Morocco.', search: 'Search the guides', placeholder: 'A city, a question, an idea…' },
 es: { title: 'Marruecos,', titleEm: 'sin complicaciones.', intro: 'Guías prácticas, listas y calculadoras gratuitas para avanzar en Marruecos, paso a paso.', search: 'Buscar una guía', placeholder: 'Una ciudad, una pregunta, una idea…' },
 de: { title: 'Marokko,', titleEm: 'ganz einfach.', intro: 'Praktische Ratgeber, Checklisten und kostenlose Rechner für Ihre nächsten Schritte in Marokko.', search: 'Ratgeber durchsuchen', placeholder: 'Eine Stadt, eine Frage, eine Idee…' },
 ar: { title: 'المغرب،', titleEm: 'ببساطة.', intro: 'أدلة عملية وقوائم تحقق وحاسبات مجانية تساعدكم على التقدّم في المغرب، خطوة بخطوة.', search: 'ابحث في الأدلة', placeholder: 'مدينة، سؤال، فكرة…' },
}[lang];
const searchUrl = hubPath(lang, 'search');
---
<section class="home-hero" aria-labelledby="home-title">
  <div class="container-page home-hero__grid">
    <h1 id="home-title">{copy.title} <em>{copy.titleEm}</em></h1>
    <p class="home-hero__intro">{copy.intro}</p>
    <div class="home-paths" data-home-paths>
      <h2 class="sr-only">{PATH_UI.paths[lang]}</h2>
      <ul class="path-cards">
        {PATH_ORDER.map((id, i) => <li><PathCard id={id} lang={lang} eager priority={i === 0} /></li>)}
      </ul>
    </div>
    <form class="home-search" action={searchUrl} method="get" role="search">
      <label for="home-query">{copy.search}</label>
      <div><Icon name="search" class="size-5 shrink-0 muted" /><input id="home-query" name="q" type="search" placeholder={copy.placeholder} required /><button class="btn btn-primary btn-sm" type="submit">{t('nav.search')}</button></div>
    </form>
  </div>
</section>
