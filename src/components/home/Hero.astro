---
import CityImage from '../CityImage.astro';
import Icon from '../Icon.astro';
import { useTranslations, type Locale } from '../../i18n';
import { L } from '../../data/home';
import { hubPath } from '../../utils/i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const searchUrl = hubPath(lang, 'search');
const examples = [t('search.ex1'), t('search.ex2'), t('search.ex3')];
---
<section class="editorial-hero" aria-labelledby="home-title">
  <div class="container-page editorial-hero__grid">
    <div class="editorial-hero__copy">
      <p class="eyebrow editorial-hero__eyebrow"><span aria-hidden="true"></span>{L.heroEyebrow[lang]}</p>
      <h1 id="home-title">{t('home.hero.title')}</h1>
      <p class="editorial-hero__intro">{t('home.hero.subtitle')}</p>
      <a href={searchUrl} data-search-open class="editorial-search" data-track="search_open" data-track-label="home">
        <Icon name="search" class="size-5 shrink-0" />
        <span>{t('search.placeholder')}</span>
        <span class="editorial-search__arrow" aria-hidden="true"><Icon name="arrowRight" class="size-5 rtl:-scale-x-100" /></span>
      </a>
      <ul class="editorial-examples" aria-label={t('search.examples')}>
        {examples.map((e) => <li><a href={`${searchUrl}?q=${encodeURIComponent(e)}`}>{e}<span aria-hidden="true">↗</span></a></li>)}
      </ul>
      <div class="editorial-hero__actions">
        <a href={hubPath(lang, 'mre')} class="btn btn-primary">{t('home.path.mre')}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a>
        <a href={hubPath(lang, 'visit')} class="btn btn-ghost">{t('home.path.visit')}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a>
      </div>
    </div>
    <div class="editorial-hero__visual">
      <div class="editorial-hero__photo"><CityImage scene="home-hero" fallback="marrakech" lang={lang} width={720} sizes="(min-width:1024px) 48vw, 100vw" eager /></div>
      <a href={hubPath(lang, 'cities')} class="editorial-hero__caption"><Icon name="compass" class="size-5" /><span>{t('home.cities.title')}</span><span aria-hidden="true">↗</span></a>
      <span class="editorial-hero__vertical" aria-hidden="true">MAROC · MOROCCO · المغرب</span>
    </div>
  </div>
  <nav class="editorial-shortcuts container-page" aria-label={t('home.categories')}>
    <a href={hubPath(lang, 'guides')}><Icon name="compass" />{t('nav.allGuides')}<span aria-hidden="true">↗</span></a>
    <a href={hubPath(lang, 'cities')}><Icon name="plane" />{t('nav.cities')}<span aria-hidden="true">↗</span></a>
    <a href={hubPath(lang, 'checklists')}><Icon name="listChecks" />{t('nav.checklists')}<span aria-hidden="true">↗</span></a>
  </nav>
</section>
