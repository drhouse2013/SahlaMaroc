---
import type { Locale } from '../i18n';
import PlaceImage from './PlaceImage.astro';
import PhotoCredit from './PhotoCredit.astro';
import { placePhoto } from '../utils/photos';
interface Props { lang: Locale; city: 'fes' | 'marrakech' }
const { lang, city } = Astro.props;
const shared = {
  fr: { title: 'Trois jours, à votre rythme', intro: 'Une proposition pour alterner médina, architecture et jardins. Adaptez les étapes à vos envies et aux conditions de visite.', day: 'Jour', titles: ['Prendre ses repères', 'Regarder les détails', 'Faire une pause au jardin'], texts: ['Commencez par Bab Boujloud et découvrez la médina, sans chercher à tout voir dès le premier jour.', 'Consacrez cette journée à la médersa Al Attarine et aux métiers de la médina. Gardez du temps pour les pauses et les détours.', 'Terminez par Jnan Sbil, puis retrouvez les ruelles ou les lieux que vous souhaitez revoir.'], map: 'Repérer le lieu sur la carte', note: 'Parcours éditorial proposé, sans réservation incluse. Vérifiez les conditions d’accès, les horaires et les tarifs auprès des lieux avant de partir.', source: 'Découvrir Fès avec l’Office national marocain du tourisme', budget: 'Préparer mon budget', places: 'Explorer tous les lieux' },
  en: { title: 'Three days, at your own pace', intro: 'A suggested stay combining the medina, architecture and gardens. Adapt each day to your interests and visiting conditions.', day: 'Day', titles: ['Find your bearings', 'Look at the details', 'Take a garden break'], texts: ['Start at Bab Boujloud and explore the medina without trying to see everything on your first day.', 'Set aside this day for Al Attarine Madrasa and the medina’s crafts. Leave room for breaks and detours.', 'Finish with Jnan Sbil, then return to the lanes or places you would like to see again.'], map: 'Find this place on the map', note: 'Suggested editorial itinerary; reservations are not included. Check access, opening hours and prices with each venue before visiting.', source: 'Explore Fez with the Moroccan National Tourist Office', budget: 'Plan my budget', places: 'Explore all places' },
  es: { title: 'Tres días, a tu ritmo', intro: 'Una propuesta que combina medina, arquitectura y jardines. Adapta las etapas a tus intereses y a las condiciones de visita.', day: 'Día', titles: ['Orientarse', 'Observar los detalles', 'Descansar en el jardín'], texts: ['Empieza por Bab Boujloud y descubre la medina sin intentar verlo todo el primer día.', 'Dedica este día a la madrasa Al Attarine y a los oficios de la medina. Reserva tiempo para descansar y desviarte del camino.', 'Termina con Jnan Sbil y vuelve después a los lugares que quieras ver de nuevo.'], map: 'Localizar en el mapa', note: 'Itinerario editorial propuesto, sin reservas incluidas. Consulta las condiciones de acceso, horarios y precios antes de ir.', source: 'Descubrir Fez con la Oficina Nacional de Turismo de Marruecos', budget: 'Preparar mi presupuesto', places: 'Explorar todos los lugares' },
  de: { title: 'Drei Tage im eigenen Tempo', intro: 'Ein Vorschlag mit Medina, Architektur und Gärten. Passen Sie die Etappen Ihren Interessen und den Besuchsbedingungen an.', day: 'Tag', titles: ['Sich orientieren', 'Details entdecken', 'Eine Gartenpause einlegen'], texts: ['Beginnen Sie am Bab Boujloud und erkunden Sie die Medina, ohne am ersten Tag alles sehen zu wollen.', 'Widmen Sie diesen Tag der Al-Attarine-Madrasa und dem Handwerk in der Medina. Lassen Sie Zeit für Pausen und Umwege.', 'Besuchen Sie zum Abschluss Jnan Sbil und kehren Sie anschließend zu Orten zurück, die Sie erneut sehen möchten.'], map: 'Ort auf der Karte finden', note: 'Redaktioneller Reisevorschlag ohne Reservierungen. Prüfen Sie Zugang, Öffnungszeiten und Preise vor dem Besuch beim jeweiligen Ort.', source: 'Fès beim marokkanischen Fremdenverkehrsamt entdecken', budget: 'Budget planen', places: 'Alle Orte entdecken' },
  ar: { title: 'ثلاثة أيام على إيقاعك', intro: 'اقتراح يجمع المدينة العتيقة والعمارة والحدائق. عدّل المراحل حسب اهتماماتك وظروف الزيارة.', day: 'اليوم', titles: ['التعرّف على المكان', 'تأمّل التفاصيل', 'استراحة في الحديقة'], texts: ['ابدأ من باب بوجلود واكتشف المدينة العتيقة دون محاولة رؤية كل شيء في اليوم الأول.', 'خصّص هذا اليوم لمدرسة العطارين وحرف المدينة العتيقة، واترك وقتاً للاستراحة والتجوّل.', 'اختتم بحديقة جنان السبيل ثم عد إلى الأزقة أو الأماكن التي تود رؤيتها مجدداً.'], map: 'تحديد المكان على الخريطة', note: 'مسار تحريري مقترح لا يشمل الحجوزات. تحقّق من شروط الدخول والمواعيد والأسعار لدى كل موقع قبل الزيارة.', source: 'اكتشف فاس مع المكتب الوطني المغربي للسياحة', budget: 'إعداد الميزانية', places: 'استكشاف جميع الأماكن' },
}[lang];
const marrakech = {
  fr: { titles: ['Découvrir la médina', 'Explorer l’architecture', 'Ralentir à la Ménara'], texts: ['Prenez vos repères autour de Jemaa el-Fna et des souks. Revenez sur la place en fin de journée si vous souhaitez en découvrir une autre ambiance.', 'Consacrez un temps au palais El Badi, puis prolongez la découverte de la médina selon vos envies. Gardez une marge pour les pauses et les déplacements.', 'Réservez une promenade aux jardins de la Ménara. Adaptez l’heure à la chaleur, puis retrouvez un quartier ou une terrasse que vous avez aimé.'], source: 'Découvrir Marrakech avec l’Office national marocain du tourisme' },
  en: { titles: ['Discover the medina', 'Explore the architecture', 'Slow down at Menara'], texts: ['Find your bearings around Jemaa el-Fna and the souks. Return to the square towards evening if you would like to experience a different atmosphere.', 'Spend time at El Badi Palace, then explore more of the medina as you wish. Leave room for breaks and travel between places.', 'Set aside a walk in the Menara gardens. Choose a time that suits the heat, then return to a neighbourhood or terrace you enjoyed.'], source: 'Explore Marrakech with the Moroccan National Tourist Office' },
  es: { titles: ['Descubrir la medina', 'Explorar la arquitectura', 'Descansar en la Menara'], texts: ['Oriéntate alrededor de Jemaa el-Fna y los zocos. Vuelve a la plaza al final del día si quieres conocer otro ambiente.', 'Dedica un tiempo al palacio El Badi y continúa por la medina según tus intereses. Deja margen para las pausas y los desplazamientos.', 'Reserva un paseo por los jardines de la Menara. Adapta la hora al calor y vuelve después a un barrio o una terraza que te haya gustado.'], source: 'Descubrir Marrakech con la Oficina Nacional de Turismo de Marruecos' },
  de: { titles: ['Die Medina entdecken', 'Architektur erkunden', 'In der Menara zur Ruhe kommen'], texts: ['Orientieren Sie sich rund um den Jemaa el-Fna und die Souks. Kehren Sie gegen Abend zum Platz zurück, wenn Sie eine andere Atmosphäre erleben möchten.', 'Nehmen Sie sich Zeit für den El-Badi-Palast und erkunden Sie danach die Medina nach Ihren Wünschen. Planen Sie Pausen und Wegezeiten ein.', 'Unternehmen Sie einen Spaziergang durch die Menara-Gärten. Wählen Sie die Uhrzeit passend zur Hitze und besuchen Sie danach ein Viertel oder eine Terrasse, die Ihnen gefallen hat.'], source: 'Marrakesch beim marokkanischen Fremdenverkehrsamt entdecken' },
  ar: { titles: ['اكتشاف المدينة العتيقة', 'استكشاف العمارة', 'استراحة في المنارة'], texts: ['تعرّف على محيط جامع الفنا والأسواق. عد إلى الساحة في نهاية اليوم إذا رغبت في اكتشاف أجواء مختلفة.', 'خصّص وقتاً لقصر البديع ثم تابع اكتشاف المدينة العتيقة حسب اهتماماتك. اترك هامشاً للاستراحة والتنقل بين المواقع.', 'خصّص نزهة لحدائق المنارة. اختر الوقت المناسب للحرارة ثم عد إلى حي أو مقهى أعجبك.'], source: 'اكتشف مراكش مع المكتب الوطني المغربي للسياحة' },
}[lang];
const copy = city === 'marrakech' ? { ...shared, ...marrakech } : shared;
const preparation = {
  fr: { title: 'Avant de partir', note: 'Cochez vos préparatifs pour cette visite. Les cases sont temporaires et ne sont pas enregistrées.', items: ['Confirmer les horaires et les conditions de visite auprès des lieux.', 'Repérer le point de rendez-vous avec votre hébergement.', 'Prévoir des chaussures confortables et de l’eau.', 'Adapter le budget et les pauses au rythme du groupe.'] },
  en: { title: 'Before you set off', note: 'Tick your preparations for this visit. Checkboxes are temporary and are not saved.', items: ['Confirm opening hours and visiting conditions with each venue.', 'Locate the meeting point with your accommodation.', 'Bring comfortable shoes and water.', 'Adapt the budget and breaks to your group’s pace.'] },
  es: { title: 'Antes de salir', note: 'Marca tus preparativos para esta visita. Las casillas son temporales y no se guardan.', items: ['Confirma horarios y condiciones de visita con cada lugar.', 'Localiza el punto de encuentro con tu alojamiento.', 'Lleva calzado cómodo y agua.', 'Adapta el presupuesto y las pausas al ritmo del grupo.'] },
  de: { title: 'Vor dem Aufbruch', note: 'Haken Sie Ihre Vorbereitungen ab. Die Auswahl ist vorübergehend und wird nicht gespeichert.', items: ['Öffnungszeiten und Besuchsbedingungen bei den Orten bestätigen.', 'Den Treffpunkt mit Ihrer Unterkunft klären.', 'Bequeme Schuhe und Wasser mitnehmen.', 'Budget und Pausen an das Tempo der Gruppe anpassen.'] },
  ar: { title: 'قبل الانطلاق', note: 'حدّد التحضيرات المنجزة لهذه الزيارة. الاختيارات مؤقتة ولا تُحفظ.', items: ['تأكيد مواعيد وشروط الزيارة لدى كل موقع.', 'تحديد نقطة اللقاء مع مكان الإقامة.', 'إحضار أحذية مريحة وماء.', 'تكييف الميزانية والاستراحات مع إيقاع المجموعة.'] },
}[lang];
const stops = (city === 'marrakech' ? [
  { id: 'jemaa-el-fna', query: 'Jemaa el Fna Marrakech Morocco', name: 'Jemaa el-Fna' },
  { id: 'el-badi', query: 'El Badi Palace Marrakech Morocco', name: 'El Badi' },
  { id: 'menara', query: 'Menara Gardens Marrakech Morocco', name: 'Ménara' },
] : [
  { id: 'fes-el-bali', query: 'Bab Boujloud Fes Morocco', name: 'Bab Boujloud · Fès el-Bali' },
  { id: 'al-attarine', query: 'Al Attarine Madrasa Fes Morocco', name: 'Al Attarine' },
  { id: 'jnan-sbil', query: 'Jnan Sbil Fes Morocco', name: 'Jnan Sbil' },
]).map((s) => ({ ...s, photo: placePhoto('spot', `${city}/${s.id}`, lang) }));
---
<section id="stay-plan" class="city-stay container-page section" aria-labelledby="stay-plan-title">
  <div class="city-stay__head"><h2 id="stay-plan-title" class="section-title">{copy.title}</h2><p class="section-sub">{copy.intro}</p></div>
  <div class="city-stay__layout">
    <figure class="city-stay__photo"><PlaceImage photo={stops[1].photo} kind="monument" lang={lang} width={900} widths={[480, 900, 1200]} sizes="(min-width:900px) 42vw, 92vw" class="city-stay__image" />{stops[1].photo.credit && <PhotoCredit lang={lang} credit={stops[1].photo.credit} source={stops[1].photo.source} />}<figcaption>{stops[1].name}</figcaption></figure>
    <ol class="city-stay__days">{stops.map((stop, i) => <li><details open={i === 0}><summary><span class="city-stay__day">{copy.day} {i + 1}</span><span>{copy.titles[i]}</span></summary><div class="city-stay__body"><p>{copy.texts[i]}</p><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(stop.query)}`} target="_blank" rel="noopener noreferrer">{copy.map} ↗</a></div></details></li>)}</ol>
  </div>
  <fieldset class="city-stay__preparation"><legend>{preparation.title}</legend><p>{preparation.note}</p><div>{preparation.items.map(item => <label><input type="checkbox" /><span>{item}</span></label>)}</div></fieldset>
  <p class="city-stay__note">{copy.note}</p>
  <p class="city-stay__links"><a href="#budget">{copy.budget}</a><a href="#spots">{copy.places}</a><a href={`https://www.visitmorocco.com/fr/voyage/${city}`} target="_blank" rel="noopener noreferrer">{copy.source} ↗</a></p>
</section>
<style>
  .city-stay__preparation{margin:2rem 0 0;padding:1.5rem;border:1px solid var(--line);border-radius:12px}.city-stay__preparation legend{padding:0 .5rem;font-family:var(--font-display);font-size:1.5rem}.city-stay__preparation p{color:var(--muted);font-size:.85rem;margin:0 0 1rem}.city-stay__preparation>div{display:grid;gap:.5rem}.city-stay__preparation label{display:flex;align-items:start;gap:.75rem;min-height:44px;cursor:pointer;padding:.4rem 0;line-height:1.6}.city-stay__preparation input{width:1.15rem;height:1.15rem;margin-top:.2rem;flex:none;accent-color:var(--brand)}.city-stay__preparation input:focus-visible{outline:3px solid var(--focus);outline-offset:3px}.city-stay__preparation input:checked+span{text-decoration:line-through;color:var(--muted)}
  .city-stay__head{max-width:44rem;margin-bottom:2rem}.city-stay__layout{display:grid;gap:2rem}.city-stay__photo{position:relative;margin:0;aspect-ratio:3/2;overflow:hidden;border-radius:12px;background:var(--surface)}.city-stay__photo :global(.city-stay__image){width:100%;height:100%;object-fit:cover}.city-stay__photo figcaption{position:absolute;bottom:1rem;inset-inline-start:1rem;background:var(--surface);color:var(--text);padding:.35rem .7rem;font-size:.8rem;border-radius:4px}.city-stay__days{list-style:none;padding:0;margin:0}.city-stay__days li{border-top:1px solid var(--line)}.city-stay__days li:last-child{border-bottom:1px solid var(--line)}summary{display:flex;gap:1rem;align-items:baseline;cursor:pointer;padding:1.25rem 0;font-family:var(--font-display);font-size:clamp(1.25rem,2vw,1.75rem);line-height:1.3}summary::marker{content:''}.city-stay__day{flex:none;font-family:var(--font-sans);font-size:.8rem;color:var(--muted)}.city-stay__body{padding:0 0 1.5rem;max-width:58ch}.city-stay__body p{margin:0 0 .85rem;color:var(--muted);line-height:1.7}.city-stay__body a,.city-stay__links a{text-decoration:underline;text-underline-offset:4px}.city-stay__note{max-width:80ch;color:var(--muted);font-size:.85rem;line-height:1.6;margin:1.5rem 0 .75rem}.city-stay__links{display:flex;flex-wrap:wrap;gap:.8rem 1.5rem;font-size:.85rem}.city-stay a:focus-visible,.city-stay summary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}@media(min-width:900px){.city-stay__layout{grid-template-columns:1.15fr 1fr;gap:3rem;align-items:start}.city-stay__photo{aspect-ratio:4/3}}@media print{.city-stay__days details:not([open])>.city-stay__body{display:block!important}.city-stay__photo{max-height:16rem}}
</style>

