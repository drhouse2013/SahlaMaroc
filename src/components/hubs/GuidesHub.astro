---
/** /<lang>/guides : parcours « Commencer ici », puis tous les guides avec filtre par thème et recherche locale. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import ArticleCard from '../ArticleCard.astro';
import Icon from '../Icon.astro';
import { useTranslations, type Locale } from '../../i18n';
import { CATEGORIES, CATEGORY_ICON } from '../../i18n/categories';
import { JOURNEYS } from '../../data/journeys';
import { allLocalesAlternates, allLocalesTargets, categoryPath, entryPath, getActiveCategories, getArticleByKey, getArticles, homePath, hubPath } from '../../utils/i18n';
import { absoluteUrl, breadcrumbJsonLd, collectionPageJsonLd } from '../../utils/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const articles = await getArticles(lang);
const cats = await getActiveCategories(lang);
const norm = (x: string) => x.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const journeys = (await Promise.all(JOURNEYS.map(async (j) => ({
  ...j,
  guides: (await Promise.all(j.steps.map((k) => getArticleByKey(lang, k)))).filter((a) => a !== null),
})))).filter((j) => j.guides.length >= 2);
const self = (l: Locale) => hubPath(l, 'guides');
const url = absoluteUrl(self(lang), Astro.site);
const crumbs = [{ name: t('breadcrumb.home'), href: homePath(lang) }, { name: t('guides.title') }];
---
<BaseLayout lang={lang} title={t('guides.title')} description={t('guides.description')} alternates={allLocalesAlternates(self)} switchTargets={allLocalesTargets(self)}
  jsonLd={[breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: c.href ? absoluteUrl(c.href, Astro.site) : url }))), collectionPageJsonLd({ url, name: t('guides.title'), description: t('guides.description'), lang, items: articles.map((a) => ({ name: a.data.title, url: absoluteUrl(`/${lang}/${a.data.slug}`, Astro.site) })) })]}>
  <PageHero lang={lang} crumbs={crumbs} title={t('guides.title')} intro={t('guides.intro')} icon="book" meta={t('category.count', { n: articles.length })} />
  <div class="container-page pt-8">
    <ul class="mb-8 flex flex-wrap gap-3">
      <li><a href={hubPath(lang, 'glossary')} class="badge badge-navy min-h-10 px-4 text-sm hover:brightness-95"><Icon name="book" class="size-4" />{t('glossary.title')}</a></li>
      <li><a href={hubPath(lang, 'calendar')} class="badge badge-navy min-h-10 px-4 text-sm hover:brightness-95"><Icon name="calendar" class="size-4" />{t('calendar.title')}</a></li>
    </ul>
    {journeys.length > 0 && (
      <section aria-labelledby="start-here">
        <h2 id="start-here" class="section-title !text-2xl">{t('guides.start.title')}</h2>
        <p class="mt-2 muted">{t('guides.start.intro')}</p>
        <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 stagger-reveal" data-journeys>
          {journeys.map((j) => (
            <li class="card flex flex-col p-5">
              <span class="icon-tile size-10"><Icon name={j.icon} /></span>
              <h3 class="mt-3 text-lg leading-snug font-semibold">{t(`journey.${j.id}.title` as 'journey.buy.title')}</h3>
              <p class="mt-1 text-sm muted">{t(`journey.${j.id}.desc` as 'journey.buy.desc')}</p>
              <ol class="mt-4 grid gap-2 text-sm">
                {j.guides.map((a, i) => (
                  <li class="flex gap-2"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-[var(--surface-3)] text-[0.7rem] font-semibold" aria-hidden="true">{i + 1}</span><a href={entryPath(lang, a.data.slug)} class="link min-w-0 [overflow-wrap:anywhere]">{a.data.title}</a></li>
                ))}
              </ol>
              <p class="mt-auto pt-4 text-xs muted">{t('journey.steps', { n: j.guides.length })}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="section !pt-12" data-guides-hub data-lang={lang} data-tpl={t('guides.results')}>
      <h2 class="section-title !text-2xl">{t('nav.allGuides')}</h2>
      <div class="mt-5 grid gap-4">
        <div class="relative max-w-xl" data-js-only hidden>
          <label for="guides-q" class="sr-only">{t('guides.search.label')}</label>
          <Icon name="search" class="pointer-events-none absolute start-4 top-1/2 size-5 -translate-y-1/2 muted" />
          <input id="guides-q" type="search" autocomplete="off" enterkeyhint="search" placeholder={t('guides.search.placeholder')} class="input ps-12" data-search />
        </div>
        <ul class="flex flex-wrap gap-2" aria-label={t('guides.filter.label')} data-fallback>
          {cats.map((id) => <li><a href={categoryPath(lang, id)} class="chip"><Icon name={CATEGORY_ICON[id]} class="size-4" />{CATEGORIES[id].label[lang]}</a></li>)}
        </ul>
        <div class="flex flex-wrap gap-2" role="group" aria-label={t('guides.filter.label')} data-js-only hidden>
          <button type="button" class="chip" aria-pressed="true" data-cat="">{t('guides.filter.all')}</button>
          {cats.map((id) => <button type="button" class="chip" aria-pressed="false" data-cat={id}><Icon name={CATEGORY_ICON[id]} class="size-4" />{CATEGORIES[id].label[lang]}</button>)}
        </div>
        <p class="text-sm muted" role="status" aria-live="polite" data-status data-js-only hidden></p>
      </div>
      <p class="card mt-6 p-6 text-center" data-empty hidden>{t('guides.empty')} <button type="button" class="link font-semibold" data-reset>{t('guides.reset')}</button></p>
      {cats.map((id) => {
        const list = articles.filter((a) => a.data.category === id);
        return (
          <section class="section" aria-labelledby={`cat-${id}`} data-section={id}>
            <div class="flex flex-wrap items-end justify-between gap-3">
              <h2 id={`cat-${id}`} class="section-title !text-2xl">{CATEGORIES[id].label[lang]}</h2>
              <a href={categoryPath(lang, id)} class="btn btn-tertiary">{t('pillar.all')}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a>
            </div>
            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{list.map((a) => <div data-guide data-q={norm(`${a.data.title} ${a.data.description} ${a.data.tags.join(' ')}`)}><ArticleCard article={a} headingLevel="h3" /></div>)}</div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>
<script>
  // Filtre par thème + recherche locale. Sans JS : liste complète et liens vers les thèmes.
  const root = document.querySelector<HTMLElement>('[data-guides-hub]');
  if (root) {
    const lang = root.dataset.lang || 'fr';
    const tpl = (root.dataset.tpl || '').split('|');
    const order = lang === 'ar' ? ['zero', 'one', 'two', 'few', 'many', 'other'] : ['one', 'other'];
    const norm = (x: string) => x.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
    // Gabarit : ar = zero|one|two|few|many|other ; autres = aucun|one|other.
    const msg = (n: number) => {
      if (n === 0) return tpl[0];
      let cat = new Intl.PluralRules(lang).select(n);
      if (!order.includes(cat)) cat = 'other';
      const forms = tpl.slice(1);
      return (forms[order.indexOf(cat) - (lang === 'ar' ? 1 : 0)] ?? forms[forms.length - 1]).replaceAll('{n}', String(n));
    };
    root.querySelectorAll<HTMLElement>('[data-js-only]').forEach((e) => (e.hidden = false));
    root.querySelector<HTMLElement>('[data-fallback]')!.hidden = true;
    const q = root.querySelector<HTMLInputElement>('[data-search]')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('button[data-cat]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-guide]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-section]')];
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let cat = '';
    const apply = () => {
      const words = norm(q.value).split(/\s+/).filter(Boolean);
      let shown = 0;
      cards.forEach((c) => {
        const inCat = !cat || c.closest<HTMLElement>('[data-section]')?.dataset.section === cat;
        const ok = inCat && words.every((w) => (c.dataset.q || '').includes(w));
        c.hidden = !ok;
        if (ok) shown++;
      });
      sections.forEach((s) => (s.hidden = !s.querySelector('[data-guide]:not([hidden])')));
      empty.hidden = shown > 0;
      status.textContent = msg(shown);
    };
    chips.forEach((b) => b.addEventListener('click', () => {
      cat = b.dataset.cat || '';
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    q.addEventListener('input', apply);
    root.querySelector('[data-reset]')?.addEventListener('click', () => { q.value = ''; chips[0].click(); q.focus(); });
    apply();
  }
</script>
