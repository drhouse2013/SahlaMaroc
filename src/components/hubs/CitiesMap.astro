---
/** Carte SVG simplifiée du Maroc (sans dépendance ni requête réseau). Coordonnées WGS84 approchées. */
import { useTranslations, type Locale } from '../../i18n';
import { CITY_PAGES, cityLabel } from '../../data/cities';
import { BASE, CITY_FACTOR, COSTS_LAST_UPDATED } from '../../config/costs';
import { cityPath } from '../../utils/i18n';
import { formatDate } from '../../utils/date';
import FlagMA from '../FlagMA.astro';
import { CITY_MAP_LAND as LAND, projectCity as pt } from '../../data/mapGeometry';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
// Projection équirectangulaire (x corrigé par cos(lat0)), identique à celle du tracé généré (voir DECISIONS_LOG.md).
// Maroc dans ses frontières nationales (provinces du Sud incluses). Source : Natural Earth 1:50m (domaine public), simplifié (Douglas-Peucker).
const fmt = new Intl.NumberFormat(lang === 'ar' ? 'ar-MA-u-nu-latn' : lang, { maximumFractionDigits: 0 });
const date = formatDate(new Date(COSTS_LAST_UPDATED), lang);
// Source unique : lat/lon de CITY_PAGES. Les points trop proches (Agadir/Taghazout, Tanger/Tétouan) sont écartés à l'affichage (min. MIN unités SVG).
const MIN = 36;
const base = CITY_PAGES.flatMap((c) => {
  if (c.lat === undefined || c.lon === undefined) return [];
  let day: number | null = null;
  if (c.costCity) day = Math.round(((BASE.nightStay.mid + BASE.foodDay.mid + BASE.transportDay.mid + BASE.funDay.mid) * CITY_FACTOR[c.costCity]) / 50) * 50;
  const [x, y] = pt(c.lat, c.lon);
  return [{ id: c.id, x, y, name: cityLabel(c.id, lang), href: cityPath(lang, c.slug[lang]), day }];
});
for (let it = 0; it < 60; it++) {
  for (let i = 0; i < base.length; i++) for (let j = i + 1; j < base.length; j++) {
    const a = base[i], b = base[j];
    let dx = b.x - a.x, dy = b.y - a.y;
    const d = Math.hypot(dx, dy);
    if (d >= MIN) continue;
    if (d < 0.01) { dx = 1; dy = 0; }
    const m = (MIN - d) / 2 / (d || 1);
    a.x -= dx * m; a.y -= dy * m; b.x += dx * m; b.y += dy * m;
  }
}
const items = base.map((c) => ({ ...c, x: Math.round(c.x), y: Math.round(c.y) }));
---
<section class="container-page pt-8" aria-labelledby="cmap-title">
  <h2 id="cmap-title" class="section-title !text-2xl">{t('city.map.title')}</h2>
  <p class="mt-2 text-sm muted">{t('city.map.hint')}</p>
  <div class="cmap card relative mt-4 grid gap-4 p-4 md:grid-cols-[2fr_1fr]" data-cmap>
    <FlagMA lang={lang} bg class="cmap-flag" />
    <svg viewBox="0 0 1140 1235" role="group" aria-label={t('city.map.aria')} class="mx-auto h-auto w-full max-w-[520px]">
      <path d={LAND} class="cmap-edge" />
      <path d={LAND} class="cmap-land" />
      <path d={LAND} class="cmap-flash" pathLength="100" aria-hidden="true" />
      {items.map((c, i) => (
        <g class="cmap-pt" role="button" tabindex="0" data-id={c.id} aria-label={c.name}>
          <circle cx={c.x} cy={c.y} r="18" fill="transparent" />
          <circle cx={c.x} cy={c.y} r="12" class="cmap-halo" style={`animation-delay:${(i * 0.37) % 2.6}s`} aria-hidden="true" />
          <circle cx={c.x} cy={c.y} r="26" class="cmap-ring" aria-hidden="true" />
          <circle cx={c.x} cy={c.y} r="12" class="cmap-dot" />
        </g>
      ))}
    </svg>
    <div aria-live="polite">
      {items.map((c) => (
        <div data-panel={c.id} hidden>
          <h3 class="text-lg font-semibold">{c.name}</h3>
          {c.day !== null && (
            <p class="mt-2 text-sm"><bdi dir="ltr" class="font-bold tabular-nums">≈ {fmt.format(c.day)} MAD</bdi> <span class="muted">{t('city.budgetDay')}</span><br /><span class="muted">{date}</span></p>
          )}
          <a href={c.href} class="btn btn-ghost btn-sm mt-3">{t('city.see')}</a>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .cmap { overflow: hidden; isolation: isolate; }
  :global(.cmap-flag) { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; border-radius: inherit; opacity: .42; pointer-events: none; }
  .cmap::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(135deg, color-mix(in srgb, var(--surface) 55%, transparent), color-mix(in srgb, var(--surface) 25%, transparent)); pointer-events: none; }
  .cmap-edge { fill: none; stroke: var(--line); stroke-width: 7; stroke-linejoin: round; }
  .cmap-land { fill: color-mix(in srgb, var(--link) 12%, var(--surface)); }
  .cmap-flash { fill: none; stroke: var(--color-gold-500); stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 14 86; opacity: 0; filter: drop-shadow(0 0 6px var(--color-gold-300)); pointer-events: none; }
  .cmap-dot { fill: var(--link); stroke: var(--surface); stroke-width: 5; transition: stroke-width .2s; }
  .cmap-halo { fill: var(--link); opacity: 0; transform-box: fill-box; transform-origin: center; pointer-events: none; }
  .cmap-ring { fill: none; stroke: var(--color-terracotta-500); stroke-width: 4; opacity: 0; transform-box: fill-box; transform-origin: center; transform: scale(.6); transition: opacity .2s, transform .25s; pointer-events: none; }
  .cmap-pt { cursor: pointer; outline: none; }
  .cmap-pt:hover .cmap-dot, .cmap-pt:focus-visible .cmap-dot { stroke: currentColor; stroke-width: 8; }
  .cmap-pt[aria-pressed='true'] .cmap-dot { fill: var(--color-terracotta-600); stroke: var(--surface); stroke-width: 6; }
  .cmap-pt[aria-pressed='true'] .cmap-ring, .cmap-pt:focus-visible .cmap-ring { opacity: 1; transform: none; }
  .cmap-pt[aria-pressed='true'] .cmap-halo { fill: var(--color-terracotta-500); }
  @media (prefers-reduced-motion: no-preference) {
    .cmap-halo { animation: cmap-pulse 2.6s ease-out infinite; }
    .cmap-flash { animation: cmap-sweep 2.2s ease-in-out .2s 1 both; }
    .cmap-pt[aria-pressed='true'] .cmap-ring { animation: cmap-ring 2.2s ease-in-out infinite; }
  }
  @keyframes cmap-pulse { 0% { opacity: .5; transform: scale(1); } 70%, 100% { opacity: 0; transform: scale(3.2); } }
  @keyframes cmap-sweep { 0% { opacity: 0; stroke-dashoffset: 14; } 8%, 92% { opacity: 1; } 100% { opacity: 0; stroke-dashoffset: -86; } }
  @keyframes cmap-ring { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.12); } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-cmap]').forEach((root) => {
    const pts = root.querySelectorAll<SVGGElement>('.cmap-pt');
    const show = (id: string) => {
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== id));
      pts.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.id === id)));
    };
    pts.forEach((p) => {
      const id = p.dataset.id!;
      p.addEventListener('click', () => show(id));
      p.addEventListener('focus', () => show(id));
      p.addEventListener('mouseenter', () => show(id));
      p.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); show(id); } });
    });
    if (pts[0]) show(pts[0].dataset.id!);
  });
</script>
