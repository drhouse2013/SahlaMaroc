---
/** /<lang>/regions : hub des 12 régions officielles. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import { useTranslations, type Locale } from '../../i18n';
import { REGIONS, regionCities } from '../../data/regions';
import { allLocalesAlternates, allLocalesTargets, homePath, hubPath, regionPath } from '../../utils/i18n';
import { absoluteUrl, breadcrumbJsonLd, collectionPageJsonLd } from '../../utils/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const self = (l: Locale) => hubPath(l, 'regions');
const url = absoluteUrl(self(lang), Astro.site);
const crumbs = [{ name: t('breadcrumb.home'), href: homePath(lang) }, { name: t('nav.regions') }];
---
<BaseLayout lang={lang} title={t('region.hub.title')} description={t('region.hub.description')} alternates={allLocalesAlternates(self)} switchTargets={allLocalesTargets(self)}
  jsonLd={[breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: c.href ? absoluteUrl(c.href, Astro.site) : url }))), collectionPageJsonLd({ url, name: t('region.hub.title'), description: t('region.hub.description'), lang, items: REGIONS.map((r) => ({ name: r.name[lang], url: absoluteUrl(regionPath(lang, r.slug), Astro.site) })) })]}>
  <PageHero lang={lang} crumbs={crumbs} title={t('region.hub.title')} intro={t('region.hub.intro')} icon="mapPin" />
  <div class="container-page section">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {REGIONS.map((r) => (
        <li class="card card-hover relative flex flex-col p-5">
          <h2 class="text-xl font-semibold"><a href={regionPath(lang, r.slug)} class="after:absolute after:inset-0">{r.name[lang]}</a></h2>
          <p class="mt-1 text-sm muted">{t('region.capital')} : {r.capital[lang]}</p>
          <p class="mt-3 line-clamp-3 text-sm muted">{r.text[lang].intro}</p>
          <span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-[var(--link)]">{t('region.count', { n: regionCities(r.id).length })}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></span>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-xs muted">{t('region.source')}</p>
  </div>
</BaseLayout>
