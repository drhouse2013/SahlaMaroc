---
/** Choix explicite : suivre le système, utiliser le clair ou utiliser le sombre. */
import type { Locale } from '../i18n';
interface Props { lang: Locale; class?: string; row?: boolean }
const { lang, class: cls = '', row = false } = Astro.props;
const labels = {
  fr: { label: 'Thème', system: 'Système', light: 'Clair', dark: 'Sombre' },
  en: { label: 'Theme', system: 'System', light: 'Light', dark: 'Dark' },
  es: { label: 'Tema', system: 'Sistema', light: 'Claro', dark: 'Oscuro' },
  de: { label: 'Design', system: 'System', light: 'Hell', dark: 'Dunkel' },
  ar: { label: 'المظهر', system: 'النظام', light: 'فاتح', dark: 'داكن' },
}[lang];
---
<label class:list={[row ? 'flex w-full items-center gap-3 px-3 py-2.5 text-sm' : 'items-center', !row && !/(^|\s)(hidden|flex)\b/.test(cls) && 'inline-flex', cls]}>
  <span class:list={[!row && 'sr-only']}>{labels.label}</span>
  <select data-theme-select aria-label={labels.label} class:list={['min-h-10 cursor-pointer rounded-full border border-[var(--line-strong)] bg-[var(--surface)] py-2 ps-3 pe-7 text-xs font-medium text-[var(--text)]', row && 'ms-auto']}>
    <option value="system" selected>{labels.system}</option>
    <option value="light">{labels.light}</option>
    <option value="dark">{labels.dark}</option>
  </select>
</label>

<script>
  const syncThemeSelects = () => {
    const preference = document.documentElement.dataset.themePreference ?? 'system';
    document.querySelectorAll<HTMLSelectElement>('[data-theme-select]').forEach((select) => { select.value = preference; });
  };
  syncThemeSelects();
  document.addEventListener('sahla:theme-applied', syncThemeSelects);
  document.querySelectorAll<HTMLSelectElement>('[data-theme-select]').forEach((select) => {
    select.addEventListener('change', () => {
      document.dispatchEvent(new CustomEvent('sahla:theme-change', { detail: select.value }));
    });
  });
</script>
