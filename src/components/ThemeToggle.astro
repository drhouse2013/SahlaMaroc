---
/**
 * Bouton mode clair/sombre. L'état initial est appliqué AVANT le rendu par un script inline
 * dans <head> (BaseLayout) => pas de flash blanc. Préférence mémorisée (localStorage).
 */
import { useTranslations, type Locale } from '../i18n';
interface Props { lang: Locale; class?: string; row?: boolean }
const { lang, class: cls = '', row = false } = Astro.props;
const t = useTranslations(lang);
---

<button
  type="button"
  data-theme-toggle
  class:list={[row ? 'flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-start hover:bg-sand-100 dark:hover:bg-white/10' : 'size-10 place-items-center rounded-full hover:bg-sand-100 dark:hover:bg-white/10', !row && !/(^|\s)(hidden|flex)\b/.test(cls) && 'grid', cls]}
  aria-label={t('theme.toggle')}
  title={t('theme.toggle')}
>
  <!-- Lune (mode clair) -->
  <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
    ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
  >
  <!-- Soleil (mode sombre) -->
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
    ><circle cx="12" cy="12" r="4"></circle><path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg
  >
  {row && <span>{t('theme.toggle')}</span>}
</button>

<script>
  // Bundlé et dédupliqué par Astro (~200 octets).
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        /* navigation privée : on ignore */
      }
    }),
  );
</script>
