---
/** Encadré pour MDX : <Callout type="tip|warning|info">…</Callout> */
interface Props { type?: 'tip' | 'warning' | 'info'; title?: string }
const { type = 'tip', title } = Astro.props;
const style = {
  tip: 'border-emerald-moroccan-500 bg-emerald-moroccan-500/5',
  warning: 'border-terracotta-500 bg-terracotta-50 dark:bg-terracotta-600/10',
  info: 'border-majorelle-500 bg-majorelle-50 dark:bg-majorelle-500/10',
}[type];
const icon = { tip: '💡', warning: '⚠️', info: 'ℹ️' }[type];
---

<div class:list={['not-prose my-6 rounded-xl border-s-4 px-5 py-4', style]}>
  {title && <p class="mb-1 font-bold">{icon} {title}</p>}
  <div class="text-[0.95rem] leading-relaxed [&_a]:underline [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:ps-5"><slot /></div>
</div>
