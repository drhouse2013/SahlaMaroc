---
/** Rubrique d'une page parcours : titre + chapô à gauche, liens vers des contenus existants à droite. */
import Icon from '../Icon.astro';
import ToolGrid from '../ToolGrid.astro';
import CityGrid from '../home/CityGrid.astro';
import type { Locale } from '../../i18n';
import type { IconName } from '../../data/icons';
import { PATH_UI } from '../../data/paths';

type Link = { href: string; label: string };
export interface ResolvedRubric {
  id: string; title: string; text: string;
  guides: Link[];
  tools: (Link & { key: string; icon: IconName })[];
  cityGrid: string[];
  places: Link[];
  faq: { q: string; a: string; href: string }[];
  toolGrid: string[];
  links: Link[];
}
interface Props { lang: Locale; rubric: ResolvedRubric }
const { lang, rubric: r } = Astro.props;
const wide = r.cityGrid.length > 0;
---
<section id={`r-${r.id}`} class:list={['path-rubric', wide && 'path-rubric--wide']} aria-labelledby={`r-${r.id}-t`} data-path-rubric={r.id}>
  <div class="path-rubric__head">
    <h2 id={`r-${r.id}-t`}>{r.title}</h2>
    <p>{r.text}</p>
  </div>
  <div class="path-rubric__body">
    {wide && <CityGrid lang={lang} ids={r.cityGrid} showHeading={false} />}
    {(r.guides.length > 0 || r.tools.length > 0) && (
      <ul class="path-links">
        {r.guides.map((g) => <li><a href={g.href}><span>{g.label}</span><Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a></li>)}
        {r.tools.map((x) => <li><a href={x.href} data-track="tool_click" data-track-label={x.key}><Icon name={x.icon} class="path-links__tool size-5" /><span>{x.label}</span><span class="path-tag">{PATH_UI.calculator[lang]}</span><Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a></li>)}
      </ul>
    )}
    {r.toolGrid.length > 0 && <ToolGrid lang={lang} keys={r.toolGrid} compact />}
    {r.places.length > 0 && <ul class="path-chips">{r.places.map((p) => <li><a class="chip" href={p.href}>{p.label}</a></li>)}</ul>}
    {r.faq.length > 0 && (
      <div class="faq-list">
        {r.faq.map((f) => <div><h3>{f.q}</h3><p>{f.a}</p><a class="text-link" href={f.href}>{PATH_UI.readGuide[lang]}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a></div>)}
      </div>
    )}
    {r.links.length > 0 && <p class="path-more">{r.links.map((l) => <a class="text-link" href={l.href}>{l.label}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></a>)}</p>}
  </div>
</section>
