  regime: 'النظام', rStd: 'الرسوم والضرائب، مع التخفيض الذي تدخله أدناه إن وُجد', r90: 'تخفيض 90% (مغاربة العالم بعمر 60 سنة فأكثر)',
  other: 'التخفيض الذي أبلغتك به الجمارك (%)', otherHelp: 'اترك 0 إن كنت لا تعرف أي تخفيض: الأداة لا تطبق أي سلّم حسب العمر.',
  vtype: 'نوع المحرك (نسبة إرشادية لرسم الاستيراد)', vThermal: 'سيارة بنزين أو ديزل', vEv: 'هجينة أو كهربائية', vCustom: 'نسبة أخرى (أدخلها)',
  di: 'رسم الاستيراد (%)', tpi: 'الضريبة شبه الجبائية على الاستيراد (%)', vat: 'الضريبة على القيمة المضافة عند الاستيراد (%)',
  vage: 'عمر السيارة (بالسنوات منذ أول تسجيل)',
  r90title: 'شروط تخفيض 90%', bage: 'عمرك (بالسنوات)', resy: 'سنوات الإقامة الفعلية بالخارج',
  car: 'سيارة سياحية بـ 9 مقاعد على الأكثر بما فيها السائق (دون سيارات نفعية أو بيك أب أو منزل متنقل أو دراجة نارية أو رباعية العجلات)',
  used: 'سبق أن استفدت من هذا التخفيض', settled: 'أنا مستقر بشكل دائم في المغرب',
  total: 'الرسوم والضرائب التقديرية', ofValue: 'من القيمة المدخلة', detail: 'تفصيل الحساب', lTotal: 'المجموع المستحق للجمارك (تقديري)',
  lValue: 'القيمة المعتمدة', lAbat: 'التخفيض', lBase: 'الوعاء الخاضع للضريبة', lDi: 'رسم الاستيراد', lTpi: 'الضريبة شبه الجبائية على الاستيراد', lVat: 'الضريبة على القيمة المضافة عند الاستيراد',
  of: 'من', tagLegal: 'نسبة قانونية', tagInd: 'نسبة إرشادية', tagCond: 'إن استوفيت الشروط',
  wait: 'املأ الحقول لتظهر لك التفاصيل.', inelig: 'تخفيض 90% غير قابل للتطبيق: الشروط غير مستوفاة', fallback: 'التفصيل أدناه محسوب دون هذا التخفيض.',
  notCleared: 'لا يُحتسب أي مبلغ: السيارة التي يزيد عمرها على {ageE} سنوات لا يمكن في الأصل تخليصها جمركياً.', warnT: 'للتأكد لدى الجمارك',
  m: {
    value_required: 'أدخل القيمة التي تعتمدها الجمارك.', value_positive: 'يجب أن تكون القيمة أكبر من 0.', rate_required: 'أدخل نسبة بين 0 و100.', rate_range: 'يجب أن تكون النسبة بين 0 و100.', age_invalid: 'أدخل رقماً موجباً أو صفراً.',
    age_below: 'يجب أن يبلغ عمرك {minAge} سنة فأكثر.', residence_below: 'يجب إثبات إقامة فعلية بالخارج تفوق {minRes} سنوات.',
    vehicle_kind: 'يجب أن تكون المركبة سيارة سياحية بـ 9 مقاعد على الأكثر: تُستثنى السيارات النفعية والبيك أب والمنازل المتنقلة والدراجات النارية والرباعية العجلات.',
    already_used: 'لا يُمنح التخفيض إلا مرة واحدة في العمر.', settled: 'حسب دورية إدارة الجمارك، لا يُمنح التخفيض لمن استقر بشكل دائم في المغرب.',
    vehicle_too_old: 'السيارة التي يزيد عمرها على {ageE} سنوات لا يمكن في الأصل تخليصها جمركياً.',
    residence_borderline: 'النص يشترط «أكثر من {minRes} سنوات»: مع {minRes} سنوات بالضبط تبتّ الجمارك في الأمر.',
    vehicle_age_borderline: 'السيارة عند حد {ageE} سنوات بالضبط: تبتّ الجمارك في الأمر.',
    vehicle_age_missing: 'لم تُدخل عمر السيارة: لم تُراقَب حدود العمر ({ageG} سنوات كقاعدة عامة، وحتى {ageE} سنوات للمغربي المتقاعد بالخارج أو في حالة العودة النهائية).',
    vehicle_age_5_10: 'بين {ageG} و{ageE} سنوات: ممكن فقط للمغربي المتقاعد بالخارج (إقامة تفوق {minRes} سنوات) أو في حالة العودة النهائية، لسيارة سيدان بـ 9 مقاعد على الأكثر. للتأكد لدى الجمارك.',
    luxury_stamp: 'ابتداءً من {lux} درهم قد يُضاف رسم الطابع على السيارات مرتفعة القيمة: لا يُحتسب هنا.',
    cap_exceeded: 'في هذا الحساب، يُحتسب الجزء من القيمة الذي يفوق {cap} درهم دون تخفيض (القانون العام): تؤكد الجمارك الوعاء الدقيق.',
  },
  secT: 'ماذا تعني هذه النتيجة', offT: 'قواعد رسمية', estT: 'تقديرات', notT: 'تكاليف غير مشمولة',
  off: [
    'الضريبة على القيمة المضافة عند الاستيراد: السعر العادي 20%.',
    'تخفيض 90%: 60 سنة فأكثر، إقامة فعلية بالخارج تفوق 10 سنوات، مرة واحدة في العمر، القيمة وهي جديدة محددة في 300000 درهم، سيارة سياحية بـ 9 مقاعد على الأكثر (دورية إدارة الجمارك رقم 5945/311 بتاريخ 4 يونيو 2019، والشروط نفسها وردت في تدابير مرحبا 2026).',
  ],
  est: [
    'القيمة المدخلة: الجمارك وحدها تحدد قيمة طرازك وهو جديد والوعاء الخاضع للضريبة.',
    'رسم الاستيراد: نسب إرشادية (17.5% للبنزين أو الديزل و2.5% للهجينة أو الكهربائية) وردت في الصحافة ومصادر مهنية، ولم نجدها في موقع إدارة الجمارك. النسبة الفعلية تتوقف على البند الجمركي والمصدر.',
    'ضريبة شبه جبائية بنسبة 0.25% على الوعاء الخاضع للضريبة: النص القانوني لم نتحقق منه هنا.',
    'وعاء الضريبة على القيمة المضافة (الوعاء + رسم الاستيراد + الضريبة شبه الجبائية) وتقريب كل سطر إلى الدرهم.',
  ],
  not: [
    'أتعاب الوسيط الجمركي أو وكيل الشحن، النقل، تأمين النقل.',
    'رسم الطابع على السيارات مرتفعة القيمة وتخفيضات أخرى (مثل «التقادم بثلاث سنوات»)، تُدخل كما تبلغك بها الجمارك.',
    'غرامة تجاوز أجل القبول المؤقت (من 1000 إلى 10000 درهم حسب دورية الجمارك لسنة 2019).',
    'شهادة التعريف، الفحص التقني وإعادة الفحص، البطاقة الرمادية.',
    'الضريبة السنوية على السيارات (الملصق) والتأمين المغربي.',
  ],
  note: `نتيجة تقديرية — التأكيد لدى إدارة الجمارك. المعطيات روجعت بتاريخ ${CUSTOMS_LAST_CHECKED}. هذا الموقع لا يحدد قيمة الجمارك ولا النسب: المرجع الوحيد هو إدارة الجمارك.`,
};
const T = { fr, en, es, de, ar }[lang];
const tx = (s: string) => (lang === 'fr' ? nb(s) : s);
const txObj = (o: Record<string, string>) => Object.fromEntries(Object.entries(o).map(([k, v]) => [k, tx(v)]));
const fmtPct = (n: number) => new Intl.NumberFormat(LOCALE_META[lang].intl, { maximumFractionDigits: 2 }).format(n);
const pctSuffix = lang === 'en' || lang === 'ar' ? '%' : '\u00a0%';
const cfg = JSON.stringify({
  p: V,
  locale: LOCALE_META[lang].intl,
  m: txObj(T.m),
  l: txObj({ lTotal: T.lTotal, inelig: T.inelig, fallback: T.fallback, notCleared: T.notCleared, warnT: T.warnT, wait: T.wait, lValue: T.lValue, lAbat: T.lAbat, lBase: T.lBase, lDi: T.lDi, lTpi: T.lTpi, lVat: T.lVat, of: T.of, tagLegal: T.tagLegal, tagInd: T.tagInd, tagCond: T.tagCond }),
});
---
<div data-customs data-cfg={cfg}>
<CalcShell id="customs" note={tx(T.note)}>
  <Fragment slot="form">
    <label class="full">{tx(T.value)}<input name="value" type="number" inputmode="numeric" min="0" step="1000" value="100000" aria-describedby="customs-value-help" /><span id="customs-value-help" class="text-xs font-normal muted">{tx(T.valueHelp)}</span></label>
    <label class="full">{tx(T.regime)}
      <select name="regime"><option value="standard">{tx(T.rStd)}</option><option value="abatement90">{tx(T.r90)}</option></select>
    </label>
    <label class="full" data-show="standard">{tx(T.other)}<input name="other" type="number" inputmode="decimal" min="0" max="100" step="1" value="0" aria-describedby="customs-other-help" /><span id="customs-other-help" class="text-xs font-normal muted">{tx(T.otherHelp)}</span></label>
    <label class="full">{tx(T.vtype)}
      <select name="vtype"><option value="thermal">{T.vThermal} ({fmtPct(V.diThermalPct)} {lang === 'fr' ? ' %' : '%'})</option><option value="ev">{T.vEv} ({fmtPct(V.diEvHybridPct)} {lang === 'fr' ? ' %' : '%'})</option><option value="custom">{tx(T.vCustom)}</option></select>
    </label>
    <label>{tx(T.di)}<input name="di" type="number" inputmode="decimal" min="0" max="100" step="0.5" value={V.diThermalPct} /></label>
    <label>{tx(T.tpi)}<input name="tpi" type="number" inputmode="decimal" min="0" max="100" step="0.05" value={V.tpiPct} /></label>
    <label>{tx(T.vat)}<input name="vat" type="number" inputmode="decimal" min="0" max="100" step="1" value={V.vatPct} /></label>
    <label>{tx(T.vage)}<input name="vage" type="number" inputmode="numeric" min="0" step="1" value="2" /></label>
    <div class="full grid gap-4 rounded-2xl border border-[var(--line)] p-4 sm:grid-cols-2" data-show="abatement90" hidden>
      <p class="full text-sm font-semibold">{tx(T.r90title)}</p>
      <label>{tx(T.bage)}<input name="bage" type="number" inputmode="numeric" min="0" step="1" value="62" /></label>
      <label>{tx(T.resy)}<input name="resy" type="number" inputmode="decimal" min="0" step="1" value="15" /></label>
      <label class="full flex !grid-cols-none items-start !flex-row gap-2"><input name="car" type="checkbox" class="!w-auto mt-0.5 size-4 shrink-0 accent-terracotta-500" checked /> <span>{tx(T.car)}</span></label>
      <label class="full flex !grid-cols-none items-start !flex-row gap-2"><input name="used" type="checkbox" class="!w-auto mt-0.5 size-4 shrink-0 accent-terracotta-500" /> <span>{tx(T.used)}</span></label>
      <label class="full flex !grid-cols-none items-start !flex-row gap-2"><input name="settled" type="checkbox" class="!w-auto mt-0.5 size-4 shrink-0 accent-terracotta-500" /> <span>{tx(T.settled)}</span></label>
    </div>
  </Fragment>
  <Fragment slot="result">
    <p class="text-sm text-white/85">{tx(T.total)}</p>
    <p class="big"><span data-out="total">—</span> DH</p>
    <p class="text-sm text-white/85"><span data-out="pct">—</span> {tx(T.ofValue)}</p>
    <div data-out="msgs" class="mt-3 grid gap-2 text-sm" role="status"></div>
    <dl data-out="lines"></dl>
  </Fragment>
</CalcShell>
<section class="not-prose mt-6 grid gap-4 md:grid-cols-3" aria-labelledby="customs-sec">
  <h2 id="customs-sec" class="sr-only">{tx(T.secT)}</h2>
  <div class="card p-4"><h3 class="font-semibold">{tx(T.offT)}</h3><ul class="mt-2 grid gap-2 text-sm">{T.off.map((x) => <li>{tx(x)}</li>)}</ul></div>
  <div class="card p-4"><h3 class="font-semibold">{tx(T.estT)}</h3><ul class="mt-2 grid gap-2 text-sm">{T.est.map((x) => <li>{tx(x)}</li>)}</ul></div>
  <div class="card p-4"><h3 class="font-semibold">{tx(T.notT)}</h3><ul class="mt-2 grid gap-2 text-sm">{T.not.map((x) => <li>{tx(x)}</li>)}</ul></div>
</section>
</div>
<script>
  import { computeCustoms, parseNum, type CustomsParams } from '../../utils/customs.mjs';

  type Cfg = { p: CustomsParams & { luxuryThreshold: number }; locale: string; m: Record<string, string>; l: Record<string, string> };
  const FIELD: Record<string, string> = { value: 'value', diPct: 'di', tpiPct: 'tpi', vatPct: 'vat', otherAbatementPct: 'other', vehicleAge: 'vage', beneficiaryAge: 'bage', residenceYears: 'resy' };

  document.querySelectorAll<HTMLElement>('[data-customs]').forEach((root) => {
    const cfg = JSON.parse(root.dataset.cfg!) as Cfg;
    const form = root.querySelector('form')!;
    const fmt = new Intl.NumberFormat(cfg.locale, { maximumFractionDigits: 0 });
    const fmtR = new Intl.NumberFormat(cfg.locale, { maximumFractionDigits: 2 });
    const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const sel = (n: string) => form.elements.namedItem(n) as HTMLSelectElement;
    const num = (n: string) => parseNum(f(n).value);
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const subst = (s: string) => s
      .replace(/\{minAge\}/g, String(cfg.p.minAge)).replace(/\{minRes\}/g, String(cfg.p.minResidenceYears))
      .replace(/\{ageG\}/g, String(cfg.p.ageGeneral)).replace(/\{ageE\}/g, String(cfg.p.ageExtended))
      .replace(/\{cap\}/g, fmt.format(cfg.p.capMad)).replace(/\{lux\}/g, fmt.format(cfg.p.luxuryThreshold));

    /** Message d'erreur propre à l'outil (même style que la validation générique de CalcShell). */
    const setErr = (name: string, text: string) => {
      const input = f(name);
      const label = input.closest('label')!;
      label.querySelector('.calc-err[data-own]')?.remove();
      if (text) {
        input.setAttribute('aria-invalid', 'true');
        const span = document.createElement('span');
        span.className = 'calc-err'; span.dataset.own = '1'; span.setAttribute('role', 'alert'); span.textContent = text;
        label.appendChild(span);
      } else if (!label.querySelector('.calc-err')) {
        input.removeAttribute('aria-invalid');
      }
    };

    const toggle = () => {
      const r = sel('regime').value;
      root.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => { el.hidden = el.dataset.show !== r; });
    };

    const run = () => {
      toggle();
      const regime = sel('regime').value as 'standard' | 'abatement90';
      const res = computeCustoms({
        value: num('value'), regime, otherAbatementPct: num('other'),
        diPct: num('di'), tpiPct: num('tpi'), vatPct: num('vat'), vehicleAge: num('vage'),
        beneficiaryAge: num('bage'), residenceYears: num('resy'),
        passengerCar: f('car').checked, alreadyUsed: f('used').checked, settled: f('settled').checked,
      }, cfg.p);
      Object.values(FIELD).forEach((n) => setErr(n, ''));
      const msgs = out('msgs'); const lines = out('lines');
      msgs.replaceChildren(); lines.replaceChildren();
      if (!res.ok) {
        res.errors.forEach((e) => { const n = FIELD[e.field]; if (n) setErr(n, subst(cfg.m[e.code] ?? '')); });
        out('total').textContent = '—'; out('pct').textContent = '—';
        const p = document.createElement('p'); p.textContent = cfg.l.wait; msgs.appendChild(p);
        return;
      }
      const note = (text: string, strong = false) => { const p = document.createElement('p'); p.textContent = subst(text); if (strong) p.className = 'font-semibold'; return p; };
      if (res.eligible90 === false) {
        msgs.appendChild(note(cfg.l.inelig, true));
        const ul = document.createElement('ul'); ul.className = 'grid gap-1 ps-4 list-disc';
        res.blockers.forEach((b) => { const li = document.createElement('li'); li.textContent = subst(cfg.m[b] ?? b); ul.appendChild(li); });
        msgs.appendChild(ul);
        if (res.cleared) msgs.appendChild(note(cfg.l.fallback));
      }
      if (!res.cleared) {
        msgs.appendChild(note(cfg.l.notCleared, true));
        out('total').textContent = '—'; out('pct').textContent = '—';
        return;
      }
      if (res.warnings.length) {
        msgs.appendChild(note(cfg.l.warnT, true));
        const ul = document.createElement('ul'); ul.className = 'grid gap-1 ps-4 list-disc';
        res.warnings.forEach((w) => { const li = document.createElement('li'); li.textContent = subst(cfg.m[w] ?? w); ul.appendChild(li); });
        msgs.appendChild(ul);
      }
      const tag = (id: string) => (id === 'vat' ? cfg.l.tagLegal : id === 'di' || id === 'tpi' ? cfg.l.tagInd : id === 'abatement' && res.applied === 'abatement90' ? cfg.l.tagCond : '');
      const label: Record<string, string> = { value: cfg.l.lValue, abatement: cfg.l.lAbat, base: cfg.l.lBase, di: cfg.l.lDi, tpi: cfg.l.lTpi, vat: cfg.l.lVat };
      res.lines.forEach((ln) => {
        const row = document.createElement('div');
        const dt = document.createElement('dt');
        dt.append(label[ln.id]);
        const small = document.createElement('span');
        small.className = 'block text-xs text-white/70';
        const parts: string[] = [];
        if (ln.ratePct !== null) parts.push(`${fmtR.format(ln.ratePct)} % ${cfg.l.of} ${fmt.format(ln.base ?? 0)}`);
        const tg = tag(ln.id); if (tg) parts.push(tg);
        small.textContent = parts.join(' · ');
        if (parts.length) dt.appendChild(small);
        const dd = document.createElement('dd');
        dd.textContent = `${ln.amount < 0 ? '− ' : ''}${fmt.format(Math.abs(ln.amount))} DH`;
        row.append(dt, dd); lines.appendChild(row);
      });
      const tot = document.createElement('div'); tot.className = '!border-0 text-base';
      const tdt = document.createElement('dt'); tdt.className = 'font-semibold'; tdt.textContent = cfg.l.lTotal;
      const tdd = document.createElement('dd'); tdd.textContent = `${fmt.format(res.total)} DH`;
      tot.append(tdt, tdd); lines.appendChild(tot);
      out('total').textContent = fmt.format(res.total);
      out('pct').textContent = fmtR.format(res.totalPctOfValue ?? 0) + ' %';
    };

    sel('vtype').addEventListener('change', () => {
      const t = sel('vtype').value;
      if (t === 'thermal') f('di').value = String(cfg.p.diThermalPct);
      else if (t === 'ev') f('di').value = String(cfg.p.diEvHybridPct);
    });
    f('di').addEventListener('input', () => {
      const d = num('di');
      sel('vtype').value = d === cfg.p.diThermalPct ? 'thermal' : d === cfg.p.diEvHybridPct ? 'ev' : 'custom';
    });
    form.addEventListener('input', run);
    form.addEventListener('change', run);
    run();
  });
</script>
