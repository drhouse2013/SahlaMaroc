---
/**
 * Calculateur des frais d'achat immobilier au Maroc (+ aide Daam Sakane).
 * Taux par défaut : src/config/mre.ts (indicatifs, modifiables par l'utilisateur).
 */
import { type Locale, LOCALE_META } from '../../i18n';
import CalcShell from './CalcShell.astro';
import { PROPERTY_FEES as F, DAAM_SAKANE, MRE_LAST_CHECKED } from '../../config/mre';
const lang = (Astro.currentLocale ?? 'en') as Locale;
const T = {
  fr: { price: 'Prix du bien (DH)', type: 'Type de bien', housing: 'Logement (appartement, maison)', land: 'Terrain nu / local commercial', reg: 'Droits d’enregistrement (%)', cf: 'Conservation foncière (%)', notary: 'Honoraires notaire (%)', vat: 'TVA sur honoraires (%)', misc: 'Débours divers (DH)', aid: 'Logement neuf, 1ʳᵉ acquisition : appliquer l’aide Daam Sakane', total: 'Frais d’achat estimés', ofPrice: 'du prix', lReg: 'Enregistrement', lCf: 'Conservation foncière', lNot: 'Notaire (TTC)', lMisc: 'Débours', lAid: 'Aide Daam Sakane', lPay: 'Total à prévoir', note: `Estimation indicative (taux usuels vérifiés le ${MRE_LAST_CHECKED}). Seul votre notaire peut établir le montant exact. Aide Daam Sakane : logement neuf, première acquisition, conditions sur daamsakane.ma.` },
  en: { price: 'Property price (MAD)', type: 'Property type', housing: 'Home (flat, house)', land: 'Bare land / commercial', reg: 'Registration duty (%)', cf: 'Land registry (%)', notary: 'Notary fees (%)', vat: 'VAT on notary fees (%)', misc: 'Other costs (MAD)', aid: 'New home, first purchase: apply Daam Sakane housing aid', total: 'Estimated buying costs', ofPrice: 'of the price', lReg: 'Registration', lCf: 'Land registry', lNot: 'Notary (incl. VAT)', lMisc: 'Other costs', lAid: 'Daam Sakane aid', lPay: 'Total to budget', note: `Indicative estimate (usual rates checked on ${MRE_LAST_CHECKED}). Only your notary can give the exact amount. Daam Sakane aid: new home, first purchase, conditions on daamsakane.ma.` },
  es: { price: 'Precio del inmueble (MAD)', type: 'Tipo de inmueble', housing: 'Vivienda (piso, casa)', land: 'Terreno / local comercial', reg: 'Impuesto de registro (%)', cf: 'Registro de la propiedad (%)', notary: 'Honorarios del notario (%)', vat: 'IVA sobre honorarios (%)', misc: 'Otros gastos (MAD)', aid: 'Vivienda nueva, primera compra: aplicar la ayuda Daam Sakane', total: 'Gastos de compra estimados', ofPrice: 'del precio', lReg: 'Registro', lCf: 'Registro de la propiedad', lNot: 'Notario (IVA incl.)', lMisc: 'Otros gastos', lAid: 'Ayuda Daam Sakane', lPay: 'Total a presupuestar', note: `Estimación orientativa (tasas habituales comprobadas el ${MRE_LAST_CHECKED}). Solo tu notario puede dar el importe exacto. Ayuda Daam Sakane: vivienda nueva, primera compra, condiciones en daamsakane.ma.` },
  de: { price: 'Kaufpreis der Immobilie (MAD)', type: 'Art der Immobilie', housing: 'Wohnimmobilie (Wohnung, Haus)', land: 'Unbebautes Grundstück / Gewerbe', reg: 'Registrierungsgebühr (%)', cf: 'Grundbuchamt (%)', notary: 'Notargebühren (%)', vat: 'MwSt. auf Notargebühren (%)', misc: 'Sonstige Kosten (MAD)', aid: 'Neubau, Ersterwerb: Förderung Daam Sakane anrechnen', total: 'Geschätzte Kaufnebenkosten', ofPrice: 'des Kaufpreises', lReg: 'Registrierung', lCf: 'Grundbuchamt', lNot: 'Notar (inkl. MwSt.)', lMisc: 'Sonstige Kosten', lAid: 'Förderung Daam Sakane', lPay: 'Gesamtbudget', note: `Unverbindliche Schätzung (übliche Sätze, geprüft am ${MRE_LAST_CHECKED}). Den genauen Betrag kann nur dein Notar nennen. Daam Sakane: Neubau, Ersterwerb, Bedingungen auf daamsakane.ma.` },
  ar: { price: 'سعر العقار (درهم)', type: 'نوع العقار', housing: 'سكن (شقة، منزل)', land: 'أرض عارية / محل تجاري', reg: 'رسوم التسجيل (%)', cf: 'المحافظة العقارية (%)', notary: 'أتعاب الموثق (%)', vat: 'الضريبة على القيمة المضافة على الأتعاب (%)', misc: 'مصاريف أخرى (درهم)', aid: 'سكن جديد، أول اقتناء: تطبيق دعم السكن «دعم سكن»', total: 'تكاليف الشراء التقديرية', ofPrice: 'من السعر', lReg: 'التسجيل', lCf: 'المحافظة العقارية', lNot: 'الموثق (شامل الضريبة)', lMisc: 'مصاريف أخرى', lAid: 'دعم سكن', lPay: 'المجموع المتوقع', note: `تقدير تقريبي (النسب المعتادة روجعت بتاريخ ${MRE_LAST_CHECKED}). وحده الموثق يمكنه تحديد المبلغ الدقيق. دعم سكن: سكن جديد، أول اقتناء، الشروط على daamsakane.ma.` },
}[lang];
const cfg = JSON.stringify({ F, DAAM_SAKANE, locale: LOCALE_META[lang].intl });
---
<CalcShell id="property-fees" note={T.note}>
  <Fragment slot="form">
    <label class="full">{T.price}<input name="price" type="number" inputmode="numeric" min="0" step="10000" value="900000" /></label>
    <label class="full">{T.type}
      <select name="type"><option value="housing">{T.housing}</option><option value="land">{T.land}</option></select>
    </label>
    <label>{T.reg}<input name="reg" type="number" min="0" step="0.1" value={F.registrationHousing} /></label>
    <label>{T.cf}<input name="cf" type="number" min="0" step="0.1" value={F.landRegistry} /></label>
    <label>{T.notary}<input name="notary" type="number" min="0" step="0.1" value={F.notary} /></label>
    <label>{T.vat}<input name="vat" type="number" min="0" step="1" value={F.notaryVat} /></label>
    <label>{T.misc}<input name="misc" type="number" min="0" step="100" value={F.misc} /></label>
    <label class="full flex !grid-cols-none items-center !flex-row gap-2"><input name="aid" type="checkbox" class="!w-auto size-4 accent-terracotta-500" /> {T.aid}</label>
  </Fragment>
  <Fragment slot="result">
    <p class="text-sm text-white/85">{T.total}</p>
    <p class="big"><span data-out="fees">—</span> DH</p>
    <p class="text-sm text-white/85"><span data-out="pct">—</span> % {T.ofPrice}</p>
    <dl>
      <div><dt>{T.lReg}</dt><dd data-out="reg">—</dd></div>
      <div><dt>{T.lCf}</dt><dd data-out="cf">—</dd></div>
      <div><dt>{T.lNot}</dt><dd data-out="not">—</dd></div>
      <div><dt>{T.lMisc}</dt><dd data-out="misc">—</dd></div>
      <div><dt>{T.lAid}</dt><dd data-out="aid">—</dd></div>
      <div class="!border-0 text-base"><dt class="font-semibold">{T.lPay}</dt><dd data-out="pay">—</dd></div>
    </dl>
  </Fragment>
</CalcShell>
<script define:vars={{ cfg }} is:inline>
  (function () {
    var c = JSON.parse(cfg);
    document.querySelectorAll('[data-calc="property-fees"]').forEach(function (root) {
      var form = root.querySelector('form');
      var fmt = function (n) { return new Intl.NumberFormat(c.locale, { maximumFractionDigits: 0 }).format(n); };
      var v = function (n) { var x = parseFloat(String(form.elements[n].value).replace(',', '.')); return isFinite(x) ? x : 0; };
      var out = function (k, t) { root.querySelector('[data-out="' + k + '"]').textContent = t; };
      form.elements.type.addEventListener('change', function () {
        form.elements.reg.value = form.elements.type.value === 'land' ? c.F.registrationLand : c.F.registrationHousing;
      });
      function run() {
        var p = v('price');
        var reg = p * v('reg') / 100;
        var cf = p * v('cf') / 100 + (p > 0 ? c.F.landRegistryFixed : 0);
        var notHT = Math.max(p * v('notary') / 100, p > 0 ? c.F.notaryMin : 0);
        var not = notHT * (1 + v('vat') / 100);
        var misc = v('misc');
        var fees = reg + cf + not + misc;
        var aid = 0;
        if (form.elements.aid.checked && form.elements.type.value === 'housing') {
          for (var i = 0; i < c.DAAM_SAKANE.length; i++) { if (p <= c.DAAM_SAKANE[i].maxPrice) { aid = c.DAAM_SAKANE[i].aid; break; } }
        }
        out('fees', fmt(fees)); out('pct', p ? (fees / p * 100).toFixed(1) : '0');
        out('reg', fmt(reg)); out('cf', fmt(cf)); out('not', fmt(not)); out('misc', fmt(misc));
        out('aid', aid ? '− ' + fmt(aid) : '—'); out('pay', fmt(p + fees - aid) + ' DH');
      }
      form.addEventListener('input', run); form.addEventListener('change', run); run();
    });
  })();
</script>
