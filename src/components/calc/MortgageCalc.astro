---
/** Simulateur de crédit immobilier (mensualité constante). Taux saisi par l'utilisateur. */
import { type Locale, LOCALE_META } from '../../i18n';
import CalcShell from './CalcShell.astro';
const lang = (Astro.currentLocale ?? 'en') as Locale;
const T = {
  fr: { price: 'Prix du bien (DH)', down: 'Apport personnel (DH)', rate: 'Taux annuel (%)', years: 'Durée (années)', income: 'Revenus nets mensuels (DH, optionnel)', monthly: 'Mensualité estimée', perMonth: 'DH / mois', loan: 'Montant emprunté', interest: 'Coût des intérêts', total: 'Total remboursé', ratio: 'Part de vos revenus', note: 'Simulation hors assurance emprunteur et frais de dossier. Les banques marocaines proposent des offres dédiées aux MRE : comparez plusieurs propositions écrites.' },
  en: { price: 'Property price (MAD)', down: 'Down payment (MAD)', rate: 'Annual rate (%)', years: 'Term (years)', income: 'Net monthly income (MAD, optional)', monthly: 'Estimated monthly payment', perMonth: 'MAD / month', loan: 'Loan amount', interest: 'Total interest', total: 'Total repaid', ratio: 'Share of your income', note: 'Excludes borrower insurance and arrangement fees. Moroccan banks offer dedicated MRE mortgages: compare several written offers.' },
  es: { price: 'Precio del inmueble (MAD)', down: 'Aportación propia (MAD)', rate: 'Tipo anual (%)', years: 'Plazo (años)', income: 'Ingresos netos mensuales (MAD, opcional)', monthly: 'Cuota mensual estimada', perMonth: 'MAD / mes', loan: 'Importe del préstamo', interest: 'Total de intereses', total: 'Total devuelto', ratio: 'Parte de tus ingresos', note: 'No incluye seguro del prestatario ni gastos de apertura. Los bancos marroquíes ofrecen hipotecas específicas para MRE: compara varias ofertas por escrito.' },
  de: { price: 'Kaufpreis (MAD)', down: 'Eigenkapital (MAD)', rate: 'Jahreszins (%)', years: 'Laufzeit (Jahre)', income: 'Monatliches Nettoeinkommen (MAD, optional)', monthly: 'Geschätzte Monatsrate', perMonth: 'MAD / Monat', loan: 'Darlehensbetrag', interest: 'Zinskosten gesamt', total: 'Insgesamt zurückgezahlt', ratio: 'Anteil an deinem Einkommen', note: 'Ohne Restschuldversicherung und Bearbeitungsgebühren. Marokkanische Banken bieten spezielle Kredite für Auslandsmarokkaner (MRE) an: vergleiche mehrere schriftliche Angebote.' },
  ar: { price: 'سعر العقار (درهم)', down: 'المساهمة الشخصية (درهم)', rate: 'السعر السنوي (%)', years: 'المدة (سنوات)', income: 'الدخل الشهري الصافي (درهم، اختياري)', monthly: 'القسط الشهري التقديري', perMonth: 'درهم / شهر', loan: 'مبلغ القرض', interest: 'مجموع الفوائد', total: 'مجموع المبلغ المسدد', ratio: 'نسبة من دخلك', note: 'لا يشمل تأمين المقترض ورسوم الملف. تقدم الأبناك المغربية عروضاً خاصة بمغاربة العالم: قارن عدة عروض مكتوبة.' },
}[lang];
const locale = LOCALE_META[lang].intl;
---
<CalcShell id="mortgage" note={T.note}>
  <Fragment slot="form">
    <label>{T.price}<input name="price" type="number" min="0" step="10000" value="900000" /></label>
    <label>{T.down}<input name="down" type="number" min="0" step="10000" value="200000" /></label>
    <label>{T.rate}<input name="rate" type="number" min="0" step="0.05" value="5" /></label>
    <label>{T.years}<input name="years" type="number" min="1" max="30" value="20" /></label>
    <label class="full">{T.income}<input name="income" type="number" min="0" step="500" placeholder="15000" /></label>
  </Fragment>
  <Fragment slot="result">
    <p class="text-sm text-white/85">{T.monthly}</p>
    <p class="big"><span data-out="m">—</span></p>
    <p class="text-sm text-white/85">{T.perMonth}</p>
    <dl>
      <div><dt>{T.loan}</dt><dd data-out="loan">—</dd></div>
      <div><dt>{T.interest}</dt><dd data-out="int">—</dd></div>
      <div><dt>{T.total}</dt><dd data-out="tot">—</dd></div>
      <div><dt>{T.ratio}</dt><dd data-out="ratio">—</dd></div>
    </dl>
  </Fragment>
</CalcShell>
<script define:vars={{ locale }} is:inline>
  (function () {
    document.querySelectorAll('[data-calc="mortgage"]').forEach(function (root) {
      var form = root.querySelector('form');
      var fmt = function (n) { return new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(n); };
      var v = function (n) { var x = parseFloat(String(form.elements[n].value).replace(',', '.')); return isFinite(x) ? x : 0; };
      var out = function (k, t) { root.querySelector('[data-out="' + k + '"]').textContent = t; };
      function run() {
        var loan = Math.max(0, v('price') - v('down'));
        var n = Math.max(1, Math.round(v('years') * 12));
        var r = v('rate') / 100 / 12;
        var m = r > 0 ? loan * r / (1 - Math.pow(1 + r, -n)) : loan / n;
        var tot = m * n;
        out('m', fmt(m)); out('loan', fmt(loan) + ' DH'); out('int', fmt(tot - loan) + ' DH'); out('tot', fmt(tot) + ' DH');
        var inc = v('income'); out('ratio', inc > 0 ? Math.round(m / inc * 100) + ' %' : '—');
      }
      form.addEventListener('input', run); run();
    });
  })();
</script>
