---
/**
 * Horaires de prière au Maroc : calcul 100 % local (src/utils/prayer.mjs), aucune requête réseau.
 * Méthode « Maroc – ministère des Habous ». La géolocalisation n'est demandée qu'après un clic ;
 * seule la ville choisie est mémorisée (localStorage) sur l'appareil.
 */
import { type Locale, LOCALE_META } from '../../i18n';
import CalcShell from './CalcShell.astro';
import { PRAYER_CITIES, DEFAULT_PRAYER_CITY } from '../../data/prayer-cities';
const lang = (Astro.currentLocale ?? 'en') as Locale;
const intl = LOCALE_META[lang].intl;
const T = {
  fr: { city: 'Ville', locate: 'Me localiser', privacy: 'Votre position n’est lue qu’après votre clic, reste dans votre navigateur et n’est jamais envoyée ni enregistrée. Seule la ville choisie est mémorisée sur votre appareil.', names: ['Fajr (Sobh)', 'Chourouq', 'Dhohr', 'Asr', 'Maghrib', 'Icha'], next: 'Prochaine prière', inT: 'dans', h: 'h', min: 'min', now: 'Heure actuelle', tz: 'Heure du Maroc', hijri: 'Date hégirienne indicative', hijriNote: 'indicatif, le calendrier officiel dépend de l’observation de la lune', tomorrow: 'demain', locating: 'Localisation en cours…', located: 'Ville la plus proche : {city} ({km} km).', far: 'Votre position est éloignée du Maroc : choisissez une ville dans la liste (ville affichée : {city}).', denied: 'Localisation refusée ou indisponible : ville par défaut, {city}. Choisissez-en une dans la liste.', unsupported: 'Localisation indisponible sur cet appareil : choisissez une ville dans la liste.', noscript: 'Ce calculateur nécessite JavaScript pour afficher les horaires.', note: 'Horaires calculés (méthode du ministère des Habous : Fajr 19°, Icha 17°, Asr ombre ×1). Ils peuvent différer de quelques minutes du calendrier officiel du ministère des Habous et des Affaires islamiques, seul à faire foi.' },
  en: { city: 'City', locate: 'Find my location', privacy: 'Your position is read only after you click, stays in your browser and is never sent or stored. Only the chosen city is remembered on your device.', names: ['Fajr', 'Sunrise', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'], next: 'Next prayer', inT: 'in', h: 'h', min: 'min', now: 'Current time', tz: 'Morocco time', hijri: 'Indicative Hijri date', hijriNote: 'indicative: the official calendar depends on moon sighting', tomorrow: 'tomorrow', locating: 'Locating…', located: 'Nearest city: {city} ({km} km).', far: 'Your position is far from Morocco: pick a city from the list (showing {city}).', denied: 'Location refused or unavailable: default city, {city}. Pick one from the list.', unsupported: 'Location is not available on this device: pick a city from the list.', noscript: 'This tool needs JavaScript to display the times.', note: 'Calculated times (Moroccan Ministry of Habous method: Fajr 19°, Isha 17°, Asr shadow ×1). They can differ by a few minutes from the official calendar of the Ministry of Habous and Islamic Affairs, which is the only authoritative source.' },
  es: { city: 'Ciudad', locate: 'Localizarme', privacy: 'Tu posición solo se lee después de tu clic, se queda en tu navegador y nunca se envía ni se guarda. Solo se recuerda la ciudad elegida en tu dispositivo.', names: ['Fajr', 'Amanecer (Shuruq)', 'Dhuhr', 'Asr', 'Magrib', 'Isha'], next: 'Próxima oración', inT: 'en', h: 'h', min: 'min', now: 'Hora actual', tz: 'Hora de Marruecos', hijri: 'Fecha hegirana orientativa', hijriNote: 'orientativa: el calendario oficial depende de la observación de la luna', tomorrow: 'mañana', locating: 'Localizando…', located: 'Ciudad más cercana: {city} ({km} km).', far: 'Tu posición está lejos de Marruecos: elige una ciudad de la lista (se muestra {city}).', denied: 'Localización rechazada o no disponible: ciudad por defecto, {city}. Elige una de la lista.', unsupported: 'La localización no está disponible en este dispositivo: elige una ciudad de la lista.', noscript: 'Esta herramienta necesita JavaScript para mostrar los horarios.', note: 'Horarios calculados (método del Ministerio de Habous: Fajr 19°, Isha 17°, Asr sombra ×1). Pueden diferir unos minutos del calendario oficial del Ministerio de Habous y Asuntos Islámicos, el único que hace fe.' },
  de: { city: 'Stadt', locate: 'Mich orten', privacy: 'Dein Standort wird erst nach deinem Klick gelesen, bleibt in deinem Browser und wird weder gesendet noch gespeichert. Nur die gewählte Stadt wird auf deinem Gerät gemerkt.', names: ['Fadschr', 'Sonnenaufgang (Schuruq)', 'Dhuhr', 'Asr', 'Maghrib', 'Ischa'], next: 'Nächstes Gebet', inT: 'in', h: 'Std.', min: 'Min.', now: 'Aktuelle Uhrzeit', tz: 'Marokkanische Zeit', hijri: 'Hidschri-Datum (Richtwert)', hijriNote: 'Richtwert: der offizielle Kalender hängt von der Mondsichtung ab', tomorrow: 'morgen', locating: 'Standort wird ermittelt …', located: 'Nächste Stadt: {city} ({km} km).', far: 'Dein Standort ist weit von Marokko entfernt: Wähle eine Stadt aus der Liste (angezeigt: {city}).', denied: 'Ortung abgelehnt oder nicht verfügbar: Standardstadt {city}. Wähle eine aus der Liste.', unsupported: 'Ortung ist auf diesem Gerät nicht verfügbar: Wähle eine Stadt aus der Liste.', noscript: 'Für die Anzeige der Zeiten wird JavaScript benötigt.', note: 'Berechnete Zeiten (Methode des marokkanischen Habous-Ministeriums: Fadschr 19°, Ischa 17°, Asr Schatten ×1). Sie können um einige Minuten vom offiziellen Kalender des Ministeriums für Habous und islamische Angelegenheiten abweichen, der allein maßgeblich ist.' },
  ar: { city: 'المدينة', locate: 'حدّد موقعي', privacy: 'لا يُقرأ موقعك إلا بعد نقرك على الزر، ويبقى في متصفحك ولا يُرسل ولا يُحفظ. تُحفظ فقط المدينة المختارة على جهازك.', names: ['الفجر', 'الشروق', 'الظهر', 'العصر', 'المغرب', 'العشاء'], next: 'الصلاة القادمة', inT: 'بعد', h: 'س', min: 'د', now: 'الساعة الآن', tz: 'التوقيت القانوني للمغرب', hijri: 'التاريخ الهجري (تقريبي)', hijriNote: 'تقريبي: التقويم الرسمي يعتمد على رؤية الهلال', tomorrow: 'غداً', locating: 'جارٍ تحديد الموقع…', located: 'أقرب مدينة: {city} ({km} كلم).', far: 'موقعك بعيد عن المغرب: اختر مدينة من القائمة (المدينة المعروضة: {city}).', denied: 'تعذّر تحديد الموقع أو تم رفضه: المدينة الافتراضية {city}. اختر مدينة من القائمة.', unsupported: 'تحديد الموقع غير متاح على هذا الجهاز: اختر مدينة من القائمة.', noscript: 'تحتاج هذه الأداة إلى جافاسكربت لعرض المواقيت.', note: 'مواقيت محسوبة (طريقة وزارة الأوقاف المغربية: الفجر 19°، العشاء 17°، العصر بظل المثل). قد تختلف بضع دقائق عن التقويم الرسمي لوزارة الأوقاف والشؤون الإسلامية، وهو وحده المعتمد.' },
}[lang];
const sorted = [...PRAYER_CITIES].sort((a, b) => a.name[lang].localeCompare(b.name[lang], intl));
const cfg = JSON.stringify({ t: T, def: DEFAULT_PRAYER_CITY, locale: intl });
---
<CalcShell id="prayer-times" note={T.note}>
  <Fragment slot="form">
    <div class="full prayer-root" data-cfg={cfg} hidden></div>
    <label class="full">{T.city}
      <select name="city" autocomplete="off">
        {sorted.map((c) => <option value={c.id} data-lat={c.lat} data-lng={c.lng} data-elev={c.elevation} selected={c.id === DEFAULT_PRAYER_CITY}>{c.name[lang]}</option>)}
      </select>
    </label>
    <div class="full grid gap-2">
      <button type="button" class="btn btn-secondary justify-self-start" data-locate>{T.locate}</button>
      <p class="text-xs muted" data-geo-status role="status"></p>
      <p class="text-xs muted">{T.privacy}</p>
    </div>
    <noscript><p class="full text-sm">{T.noscript}</p></noscript>
  </Fragment>
  <Fragment slot="result">
    <p class="text-sm text-white/85"><span data-out="city">—</span> · <span data-out="date">—</span></p>
    <p class="text-xs text-white/75" data-out-wrap="hijri" hidden>{T.hijri} : <span data-out="hijri">—</span> (<span>{T.hijriNote}</span>)</p>
    <p class="mt-3 text-sm text-white/85">{T.now} <span class="text-xs">({T.tz}, <span data-out="tz">UTC+0</span>)</span></p>
    <p class="big" aria-live="off" data-out="clock">--:--</p>
    <p class="mt-3 text-sm text-white/85">{T.next}</p>
    <p class="text-lg font-semibold"><span data-out="next">—</span> <span class="tabular-nums" data-out="nextTime">--:--</span></p>
    <p class="text-sm text-gold-300" aria-live="off" data-out="countdown">—</p>
    <p class="sr-only" aria-live="polite" data-out="announce"></p>
    <dl class="prayer-list" aria-label={T.next}>
      {T.names.map((n, i) => <div data-p={['fajr', 'sunrise', 'dhuhr', 'asr', 'maghrib', 'isha'][i]}><dt>{n}</dt><dd class="tabular-nums" dir="ltr" data-t>--:--</dd></div>)}
    </dl>
  </Fragment>
</CalcShell>
<style is:global>
  .calc .prayer-list div { padding: 0.35rem 0.5rem; border-radius: 0.6rem; border-bottom-color: rgb(255 255 255 / 0.16); }
  .calc .prayer-list div[aria-current="true"] { background: rgb(255 255 255 / 0.16); border-bottom-color: transparent; outline: 1px solid var(--color-gold-300); }
  .calc .prayer-list div[aria-current="true"] dt, .calc .prayer-list div[aria-current="true"] dd { color: var(--color-gold-300); font-weight: 700; }
  .calc [data-out="clock"] { direction: ltr; unicode-bidi: plaintext; }
</style>
<script>
  import { prayerTimes, formatHM, nextPrayer, nearestCity, moroccoOffsetMinutes, PRAYER_ORDER } from '../../utils/prayer.mjs';

  const KEY = 'sahla:prayer-city';
  document.querySelectorAll<HTMLElement>('[data-calc="prayer-times"]').forEach((root) => {
    const cfg = JSON.parse(root.querySelector<HTMLElement>('.prayer-root')!.dataset.cfg!);
    const T = cfg.t as Record<string, any>;
    const select = root.querySelector<HTMLSelectElement>('select[name="city"]')!;
    const status = root.querySelector<HTMLElement>('[data-geo-status]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const fill = (s: string, v: Record<string, string | number>) => Object.entries(v).reduce((a, [k, x]) => a.replace(`{${k}}`, String(x)), s);
    const cities = Array.from(select.options).map((o) => ({ id: o.value, name: o.text, lat: +o.dataset.lat!, lng: +o.dataset.lng!, elevation: +o.dataset.elev! }));
    const cur = () => cities.find((c) => c.id === select.value) ?? cities[0];
    let lastNext = '';

    const parts = (ms: number) => { const d = new Date(ms); return { year: d.getUTCFullYear(), month: d.getUTCMonth() + 1, day: d.getUTCDate(), min: d.getUTCHours() * 60 + d.getUTCMinutes(), sec: d.getUTCSeconds() }; };

    function render() {
      const c = cur();
      const nowUtc = Date.now();
      const off = moroccoOffsetMinutes(parts(nowUtc));
      const L = parts(nowUtc + off * 60000);
      const tomorrow = parts(nowUtc + off * 60000 + 86400000);
      const args = (p: { year: number; month: number; day: number }) => ({ year: p.year, month: p.month, day: p.day, lat: c.lat, lng: c.lng, elevation: c.elevation });
      const today = prayerTimes(args(L));
      const tom = prayerTimes(args(tomorrow));
      PRAYER_ORDER.forEach((k) => { root.querySelector(`[data-p="${k}"] [data-t]`)!.textContent = formatHM(today[k]); });
      const nx = nextPrayer(today, tom, L.min, L.sec);
      root.querySelectorAll<HTMLElement>('[data-p]').forEach((row) => {
        if (row.dataset.p === nx.key && nx.minutes < 1440) row.setAttribute('aria-current', 'true'); else row.removeAttribute('aria-current');
      });
      const name = T.names[PRAYER_ORDER.indexOf(nx.key)];
      const left = Math.max(1, Math.ceil(nx.in));
      const hh = Math.floor(left / 60), mm = left % 60;
      out('city').textContent = c.name;
      out('clock').textContent = formatHM(L.min);
      out('tz').textContent = 'UTC' + (off >= 0 ? '+' : '−') + Math.abs(off / 60);
      out('next').textContent = name;
      out('nextTime').textContent = formatHM(nx.minutes) + (nx.minutes >= 1440 ? ' (' + T.tomorrow + ')' : '');
      out('countdown').textContent = T.inT + ' ' + (hh ? hh + ' ' + T.h + ' ' : '') + String(mm).padStart(2, '0') + ' ' + T.min;
      // annonce lecteur d'écran uniquement quand la prochaine prière change (pas toutes les 30 s)
      if (nx.key + nx.minutes !== lastNext) { lastNext = nx.key + nx.minutes; out('announce').textContent = T.next + ' : ' + name + ' ' + formatHM(nx.minutes); }
      try {
        const base = new Date(Date.UTC(L.year, L.month - 1, L.day));
        out('date').textContent = new Intl.DateTimeFormat(cfg.locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(base);
        const hf = new Intl.DateTimeFormat(cfg.locale.split('-u-')[0] + '-u-ca-islamic-umalqura-nu-latn', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
        const wrap = root.querySelector<HTMLElement>('[data-out-wrap="hijri"]')!;
        if (hf.resolvedOptions().calendar === 'islamic-umalqura') { out('hijri').textContent = hf.format(base); wrap.hidden = false; } else wrap.hidden = true;
      } catch { /* Intl indisponible : on n'affiche pas la date */ }
    }

    const save = () => { try { localStorage.setItem(KEY, select.value); } catch { /* stockage indisponible */ } };
    try { const s = localStorage.getItem(KEY); if (s && cities.some((c) => c.id === s)) select.value = s; } catch { /* idem */ }

    select.addEventListener('change', () => { save(); status.textContent = ''; render(); });

    root.querySelector('[data-locate]')!.addEventListener('click', () => {
      if (!('geolocation' in navigator)) { status.textContent = T.unsupported; return; }
      status.textContent = T.locating;
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const n = nearestCity(cities, pos.coords.latitude, pos.coords.longitude)!;
          const km = Math.round(n.km);
          if (km > 600) { status.textContent = fill(T.far, { city: cur().name }); return; }
          select.value = n.city.id; save(); render();
          status.textContent = fill(T.located, { city: n.city.name, km });
        },
        () => {
          let s: string | null = null;
          try { s = localStorage.getItem(KEY); } catch { /* idem */ }
          if (!s) select.value = cfg.def;
          render();
          status.textContent = fill(T.denied, { city: cur().name });
        },
        { timeout: 10000, maximumAge: 600000 },
      );
    });

    let timer: number | undefined;
    const start = () => { stop(); render(); timer = window.setInterval(render, 30000); };
    const stop = () => { if (timer !== undefined) { window.clearInterval(timer); timer = undefined; } };
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });
    if (!document.hidden) start();
  });
</script>
