---
/**
 * Horaires du Ramadan 2027 : imsak (= Fajr) et iftar (= Maghrib), jour par jour, calcul 100 % local
 * (src/utils/prayer.mjs, méthode Habous), aucune requête réseau. Dates prévisionnelles : début attendu le
 * 8 février 2027, à confirmer par le ministère des Habous après l'observation du croissant.
 */
import { type Locale, LOCALE_META } from '../../i18n';
import CalcShell from './CalcShell.astro';
import { PRAYER_CITIES, DEFAULT_PRAYER_CITY } from '../../data/prayer-cities';
const lang = (Astro.currentLocale ?? 'en') as Locale;
const intl = LOCALE_META[lang].intl;
const T = {
  fr: { city: 'Ville', start: 'Premier jour du Ramadan', s8: 'Lundi 8 février 2027 (date attendue)', s9: 'Mardi 9 février 2027 (si le croissant n’est pas observé)', day: 'Jour', date: 'Date', imsak: 'Imsak (Fajr)', iftar: 'Iftar (Maghrib)', today: 'Aujourd’hui', first: 'Premier jour', imsakLbl: 'Imsak (début du jeûne)', iftarLbl: 'Iftar (rupture du jeûne)', hint: 'Les 30 jours du mois sont affichés ; le mois peut n’en compter que 29.', caption: 'Horaires de l’imsak et de l’iftar, jour par jour', note: 'Dates prévisionnelles (début attendu le 8 février 2027) : elles dépendent de l’observation du croissant et de l’annonce officielle du ministère des Habous et des Affaires islamiques, seule à faire foi. Imsak = heure du Fajr (19°), sans marge de précaution. Horaires calculés, à quelques minutes près du calendrier officiel. Heure légale du Maroc : GMT+0 toute l’année depuis le 20/09/2026.' },
  en: { city: 'City', start: 'First day of Ramadan', s8: 'Monday 8 February 2027 (expected date)', s9: 'Tuesday 9 February 2027 (if the crescent is not sighted)', day: 'Day', date: 'Date', imsak: 'Imsak (Fajr)', iftar: 'Iftar (Maghrib)', today: 'Today', first: 'First day', imsakLbl: 'Imsak (fast begins)', iftarLbl: 'Iftar (fast ends)', hint: 'All 30 days are shown; the month may have only 29.', caption: 'Imsak and iftar times, day by day', note: 'Provisional dates (start expected on 8 February 2027): they depend on the crescent sighting and on the official announcement of the Ministry of Habous and Islamic Affairs, which is the only authoritative source. Imsak = Fajr time (19°), with no safety margin. Calculated times, within a few minutes of the official calendar. Morocco legal time: GMT+0 all year since 20/09/2026.' },
  es: { city: 'Ciudad', start: 'Primer día de Ramadán', s8: 'Lunes 8 de febrero de 2027 (fecha prevista)', s9: 'Martes 9 de febrero de 2027 (si no se observa la luna creciente)', day: 'Día', date: 'Fecha', imsak: 'Imsak (Fajr)', iftar: 'Iftar (Magrib)', today: 'Hoy', first: 'Primer día', imsakLbl: 'Imsak (inicio del ayuno)', iftarLbl: 'Iftar (fin del ayuno)', hint: 'Se muestran los 30 días; el mes puede tener solo 29.', caption: 'Horarios de imsak e iftar, día a día', note: 'Fechas provisionales (inicio previsto el 8 de febrero de 2027): dependen de la observación de la luna creciente y del anuncio oficial del Ministerio de Habous y Asuntos Islámicos, el único que hace fe. Imsak = hora del Fajr (19°), sin margen de precaución. Horarios calculados, con una diferencia de pocos minutos respecto al calendario oficial. Hora legal de Marruecos: GMT+0 todo el año desde el 20/09/2026.' },
  de: { city: 'Stadt', start: 'Erster Ramadantag', s8: 'Montag, 8. Februar 2027 (erwartetes Datum)', s9: 'Dienstag, 9. Februar 2027 (falls die Sichel nicht gesichtet wird)', day: 'Tag', date: 'Datum', imsak: 'Imsak (Fadschr)', iftar: 'Iftar (Maghrib)', today: 'Heute', first: 'Erster Tag', imsakLbl: 'Imsak (Beginn des Fastens)', iftarLbl: 'Iftar (Fastenbrechen)', hint: 'Angezeigt werden alle 30 Tage; der Monat kann nur 29 haben.', caption: 'Imsak- und Iftar-Zeiten, Tag für Tag', note: 'Vorläufige Daten (erwarteter Beginn am 8. Februar 2027): Sie hängen von der Sichtung der Mondsichel und der offiziellen Bekanntgabe des Ministeriums für Habous und islamische Angelegenheiten ab, die allein maßgeblich ist. Imsak = Zeit des Fadschr (19°), ohne Sicherheitspuffer. Berechnete Zeiten, wenige Minuten vom offiziellen Kalender entfernt. Marokkanische Zeit: ganzjährig GMT+0 seit dem 20.09.2026.' },
  ar: { city: 'المدينة', start: 'أول أيام رمضان', s8: 'الاثنين 8 فبراير 2027 (التاريخ المتوقع)', s9: 'الثلاثاء 9 فبراير 2027 (إن لم يُرَ الهلال)', day: 'اليوم', date: 'التاريخ', imsak: 'الإمساك (الفجر)', iftar: 'الإفطار (المغرب)', today: 'اليوم', first: 'اليوم الأول', imsakLbl: 'الإمساك (بداية الصيام)', iftarLbl: 'الإفطار (نهاية الصيام)', hint: 'تُعرض أيام الشهر الثلاثون؛ وقد يكون الشهر تسعة وعشرين يوماً.', caption: 'مواقيت الإمساك والإفطار يوماً بيوم', note: 'تواريخ تقديرية (بداية متوقعة في 8 فبراير 2027): تتوقف على رؤية الهلال وعلى الإعلان الرسمي لوزارة الأوقاف والشؤون الإسلامية، وهو وحده المعتمد. الإمساك = وقت الفجر (19°) دون هامش احتياط. مواقيت محسوبة تقترب من التقويم الرسمي بفارق دقائق. التوقيت القانوني للمغرب: GMT+0 طوال السنة منذ 20/09/2026.' },
}[lang];
const sorted = [...PRAYER_CITIES].sort((a, b) => a.name[lang].localeCompare(b.name[lang], intl));
const cfg = JSON.stringify({ t: T, locale: intl });
---
<div data-ramadan-wrap>
<CalcShell id="ramadan-times" note={T.note}>
  <Fragment slot="form">
    <div class="full ramadan-root" data-cfg={cfg} hidden></div>
    <label class="full">{T.city}
      <select name="city" autocomplete="off">
        {sorted.map((c) => <option value={c.id} data-lat={c.lat} data-lng={c.lng} data-elev={c.elevation} selected={c.id === DEFAULT_PRAYER_CITY}>{c.name[lang]}</option>)}
      </select>
    </label>
    <label class="full">{T.start}
      <select name="start" autocomplete="off">
        <option value="8" selected>{T.s8}</option>
        <option value="9">{T.s9}</option>
      </select>
    </label>
    <p class="full text-xs muted">{T.hint}</p>
  </Fragment>
  <Fragment slot="result">
    <p class="text-sm text-white/85"><span data-out="city">—</span> · <span data-out="label">—</span></p>
    <p class="mt-3 text-sm text-white/85">{T.imsakLbl}</p>
    <p class="big" dir="ltr" data-out="imsak">--:--</p>
    <p class="mt-3 text-sm text-white/85">{T.iftarLbl}</p>
    <p class="big" dir="ltr" data-out="iftar">--:--</p>
  </Fragment>
</CalcShell>
<div class="ramadan-table not-prose my-6 overflow-x-auto rounded-2xl border border-[var(--line)]">
  <table class="w-full text-sm">
    <caption class="sr-only">{T.caption}</caption>
    <thead><tr><th scope="col">{T.day}</th><th scope="col">{T.date}</th><th scope="col">{T.imsak}</th><th scope="col">{T.iftar}</th></tr></thead>
    <tbody data-rows></tbody>
  </table>
</div>
</div>
<style is:global>
  .ramadan-table th, .ramadan-table td { padding: 0.5rem 0.75rem; text-align: start; border-bottom: 1px solid var(--line); }
  .ramadan-table thead th { background: var(--surface); font-weight: 600; }
  .ramadan-table td.t { font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: plaintext; }
  .ramadan-table tr[aria-current="true"] { background: rgb(212 160 23 / 0.18); font-weight: 700; }
</style>
<script>
  import { prayerTimes, formatHM } from '../../utils/prayer.mjs';

  const KEY = 'sahla:prayer-city';
  document.querySelectorAll<HTMLElement>('[data-ramadan-wrap]').forEach((wrap) => {
    const root = wrap.querySelector<HTMLElement>('[data-calc="ramadan-times"]')!;
    const cfg = JSON.parse(root.querySelector<HTMLElement>('.ramadan-root')!.dataset.cfg!);
    const T = cfg.t as Record<string, string>;
    const city = root.querySelector<HTMLSelectElement>('select[name="city"]')!;
    const start = root.querySelector<HTMLSelectElement>('select[name="start"]')!;
    const tbody = wrap.querySelector<HTMLElement>('[data-rows]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const fmt = new Intl.DateTimeFormat(cfg.locale, { weekday: 'short', day: 'numeric', month: 'long', timeZone: 'UTC' });
    const nf = new Intl.NumberFormat(cfg.locale.split('-u-')[0]);

    function render() {
      const o = city.options[city.selectedIndex];
      const lat = +o.dataset.lat!, lng = +o.dataset.lng!, elevation = +o.dataset.elev!;
      const t0 = Date.UTC(2027, 1, +start.value); // 8 ou 9 février 2027
      const now = new Date();
      const todayMs = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
      let focus = -1;
      const rows: string[] = [];
      const cells: { imsak: string; iftar: string }[] = [];
      for (let i = 0; i < 30; i++) {
        const d = new Date(t0 + i * 86400000);
        const tt = prayerTimes({ year: d.getUTCFullYear(), month: d.getUTCMonth() + 1, day: d.getUTCDate(), lat, lng, elevation });
        const isToday = d.getTime() === todayMs;
        if (isToday) focus = i;
        cells.push({ imsak: formatHM(tt.fajr), iftar: formatHM(tt.maghrib) });
        rows.push(`<tr${isToday ? ' aria-current="true"' : ''}><td>${nf.format(i + 1)}</td><td>${fmt.format(d)}${isToday ? ' · ' + T.today : ''}</td><td class="t">${cells[i].imsak}</td><td class="t">${cells[i].iftar}</td></tr>`);
      }
      tbody.innerHTML = rows.join('');
      const k = focus >= 0 ? focus : 0;
      out('city').textContent = o.text;
      out('label').textContent = (focus >= 0 ? T.today : T.first) + ' · ' + fmt.format(new Date(t0 + k * 86400000));
      out('imsak').textContent = cells[k].imsak;
      out('iftar').textContent = cells[k].iftar;
    }

    try { const s = localStorage.getItem(KEY); if (s && Array.from(city.options).some((o) => o.value === s)) city.value = s; } catch { /* stockage indisponible */ }
    city.addEventListener('change', () => { try { localStorage.setItem(KEY, city.value); } catch { /* idem */ } render(); });
    start.addEventListener('change', render);
    render();
  });
</script>
