  secT: 'ما الذي تبينه هذه النتيجة', offT: 'القواعد الرسمية', estT: 'التقديرات ومدخلاتك', notT: 'غير مشمول',
  off: [
    'نسبة 20% على الربح الصافي، مع حد أدنى 3% من ثمن البيع حتى في غياب الربح (الدليل الضريبي لمغاربة العالم، الوزارة المكلفة بالمغاربة المقيمين بالخارج، يوليوز 2025).',
    'إعفاء السكن الرئيسي المشغول منذ 5 سنوات على الأقل (غير مُكرى، مرة واحدة كل 5 سنوات، التفويت خلال السنة التي تلي الشغور)، مع حد أدنى 3% على الجزء من الثمن الذي يتجاوز 4.000.000 درهم.',
    'إعفاءات: تفويتات السنة التي لا تتجاوز 140.000 درهم في مجموعها؛ أول تفويت لسكن اجتماعي (4 سنوات سكن، من 50 إلى 80 م²، وبحد أقصى 250.000 درهم دون احتساب الضريبة على القيمة المضافة).',
    'التصريح بالطريقة الإلكترونية والأداء داخل 30 يوماً من تاريخ التفويت.',
  ],
  est: [
    'معامل إعادة التقييم من إدخالك: الجدول الرسمي غير مدمج في الأداة.',
    'يؤخذ ثمن الشراء والمصاريف كما تدخلها؛ وتُعتمد النسبة الجزافية 15% من ثمن الشراء إذا كانت مصاريفك الفعلية أقل.',
    'الإدارة وحدها تكيّف السكن الرئيسي وتتحقق من المستندات.',
  ],
  not: [
    'فوائد القرض وعمولة الوكالة ومصاريف البيع: تحقق لدى المديرية العامة للضرائب أو موثق قبل خصمها.',
    'أتعاب الموثق ورسوم المحافظة العقارية، والضريبة على القيمة المضافة عند الاقتضاء.',
    'الحالات الخاصة (الشياع، الهبة، الشركات، الأراضي الفلاحية).',
  ],
  note: `نتيجة تقديرية — تؤكدها المديرية العامة للضرائب. تم التحقق من المعطيات في ${CAPITAL_GAINS_LAST_CHECKED}. هذا الموقع لا يغني عن المديرية العامة للضرائب ولا عن الموثق.`,
};
const T = { fr, en, es, de, ar }[lang];
const tx = (s: string) => (lang === 'fr' ? nb(s) : s);
const fmtN = (n: number) => new Intl.NumberFormat(LOCALE_META[lang].intl, { maximumFractionDigits: 0 }).format(n);
const sub = (s: string) => s
  .replace(/\{flat\}/g, String(V.acquisitionCostFlatPct)).replace(/\{mainY\}/g, String(V.mainResidenceYears))
  .replace(/\{socY\}/g, String(V.socialYears)).replace(/\{areaMin\}/g, String(V.socialAreaMin)).replace(/\{areaMax\}/g, String(V.socialAreaMax))
  .replace(/\{socPrice\}/g, fmtN(V.socialPriceCapMad)).replace(/\{small\}/g, fmtN(V.smallSalesCapMad));
const txs = (s: string) => tx(sub(s));
const cfg = JSON.stringify({
  p: V,
  locale: LOCALE_META[lang].intl,
  m: Object.fromEntries(Object.entries(T.m).map(([k, v]) => [k, txs(v)])),
  l: Object.fromEntries(Object.entries({
    wait: T.wait, lPrice: T.lPrice, lReval: T.lReval, lCosts: T.lCosts, lWorks: T.lWorks, lBase: T.lBase, lProfit: T.lProfit, lLoss: T.lLoss,
    lRate: T.lRate, lMin: T.lMin, lTax: T.lTax, lNet: T.lNet, kFlat: T.kFlat, kActual: T.kActual, applied: T.applied,
    notApplied: T.notApplied, fallback: T.fallback, warnT: T.warnT,
  }).map(([k, v]) => [k, tx(v)])),
});
---
<div data-capgain data-cfg={cfg}>
<CalcShell id="capgain" note={tx(T.note)}>
  <Fragment slot="form">
    <label>{tx(T.price)}<input name="price" type="number" inputmode="numeric" min="0" step="10000" value="1000000" /></label>
    <label>{tx(T.acq)}<input name="acq" type="number" inputmode="numeric" min="0" step="10000" value="600000" /></label>
    <label class="full">{tx(T.coef)}<input name="coef" type="number" inputmode="decimal" min="1" step="0.01" value="1" aria-describedby="capgain-coef-help" /><span id="capgain-coef-help" class="text-xs font-normal muted">{tx(T.coefHelp)}</span></label>
    <label>{txs(T.costs)}<input name="costs" type="number" inputmode="numeric" min="0" step="1000" value="0" aria-describedby="capgain-costs-help" /><span id="capgain-costs-help" class="text-xs font-normal muted">{txs(T.costsHelp)}</span></label>
    <label>{tx(T.works)}<input name="works" type="number" inputmode="numeric" min="0" step="1000" value="0" /></label>
    <label class="full">{tx(T.exemption)}
      <select name="exemption">
        <option value="none">{tx(T.eNone)}</option>
        <option value="main">{txs(T.eMain)}</option>
        <option value="social">{tx(T.eSocial)}</option>
        <option value="small">{tx(T.eSmall)}</option>
      </select>
    </label>
    <div class="full grid gap-4 rounded-2xl border border-[var(--line)] p-4 sm:grid-cols-2" data-show="main" hidden>
      <label>{tx(T.occ)}<input name="occ" type="number" inputmode="decimal" min="0" step="1" value="6" /></label>
      <label>{tx(T.vac)}<input name="vac" type="number" inputmode="numeric" min="0" step="1" value="0" /></label>
      <label class="full flex !grid-cols-none items-start !flex-row gap-2"><input name="rented" type="checkbox" class="!w-auto mt-0.5 size-4 shrink-0 accent-terracotta-500" /> <span>{tx(T.rented)}</span></label>
      <label class="full flex !grid-cols-none items-start !flex-row gap-2"><input name="used" type="checkbox" class="!w-auto mt-0.5 size-4 shrink-0 accent-terracotta-500" /> <span>{txs(T.used)}</span></label>
    </div>
    <div class="full grid gap-4 rounded-2xl border border-[var(--line)] p-4 sm:grid-cols-2" data-show="social" hidden>
      <label>{tx(T.occ)}<input name="sococc" type="number" inputmode="decimal" min="0" step="1" value="4" /></label>
      <label>{tx(T.area)}<input name="area" type="number" inputmode="decimal" min="0" step="1" value="70" /></label>
      <label class="full flex !grid-cols-none items-start !flex-row gap-2"><input name="first" type="checkbox" class="!w-auto mt-0.5 size-4 shrink-0 accent-terracotta-500" checked /> <span>{tx(T.first)}</span></label>
    </div>
    <div class="full grid gap-4 rounded-2xl border border-[var(--line)] p-4" data-show="small" hidden>
      <label>{tx(T.yearTotal)}<input name="year" type="number" inputmode="numeric" min="0" step="1000" value="100000" /></label>
    </div>
  </Fragment>
  <Fragment slot="result">
    <p class="text-sm text-white/85">{tx(T.total)}</p>
    <p class="big"><span data-out="total">—</span> {lang === 'ar' ? 'درهم' : 'DH'}</p>
    <p class="text-sm text-white/85"><span data-out="pct">—</span> {tx(T.ofPrice)}</p>
    <div data-out="msgs" class="mt-3 grid gap-2 text-sm" role="status"></div>
    <dl data-out="lines"></dl>
  </Fragment>
</CalcShell>
<section class="not-prose mt-6 grid gap-4 md:grid-cols-3" aria-labelledby="capgain-sec">
  <h2 id="capgain-sec" class="sr-only">{tx(T.secT)}</h2>
  <div class="card p-4"><h3 class="font-semibold">{tx(T.offT)}</h3><ul class="mt-2 grid gap-2 text-sm">{T.off.map((x) => <li>{txs(x)}</li>)}</ul></div>
  <div class="card p-4"><h3 class="font-semibold">{tx(T.estT)}</h3><ul class="mt-2 grid gap-2 text-sm">{T.est.map((x) => <li>{txs(x)}</li>)}</ul></div>
  <div class="card p-4"><h3 class="font-semibold">{tx(T.notT)}</h3><ul class="mt-2 grid gap-2 text-sm">{T.not.map((x) => <li>{txs(x)}</li>)}</ul></div>
</section>
</div>
<script>
  import { computeCapitalGain, parseNum, type CapitalGainParams } from '../../utils/capitalgain.mjs';

  type Cfg = { p: CapitalGainParams; locale: string; m: Record<string, string>; l: Record<string, string> };
  const FIELD: Record<string, string> = { price: 'price', acquisitionPrice: 'acq', coefficient: 'coef', acquisitionCosts: 'costs', works: 'works' };

  document.querySelectorAll<HTMLElement>('[data-capgain]').forEach((root) => {
    const cfg = JSON.parse(root.dataset.cfg!) as Cfg;
    const form = root.querySelector('form')!;
    const fmt = new Intl.NumberFormat(cfg.locale, { maximumFractionDigits: 0 });
    const fmtR = new Intl.NumberFormat(cfg.locale, { maximumFractionDigits: 2 });
    const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const sel = (n: string) => form.elements.namedItem(n) as HTMLSelectElement;
    const num = (n: string) => parseNum(f(n).value);
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const unit = document.documentElement.lang === 'ar' ? 'درهم' : 'DH';

    const setErr = (name: string, text: string) => {
      const input = f(name);
      const label = input.closest('label')!;
      label.querySelector('.calc-err[data-own]')?.remove();
      if (text) {
        input.setAttribute('aria-invalid', 'true');
        const span = document.createElement('span');
        span.className = 'calc-err'; span.dataset.own = '1'; span.setAttribute('role', 'alert'); span.textContent = text;
        label.appendChild(span);
      } else if (!label.querySelector('.calc-err')) {
        input.removeAttribute('aria-invalid');
      }
    };
    const para = (text: string, strong = false) => { const p = document.createElement('p'); p.textContent = text; if (strong) p.className = 'font-semibold'; return p; };
    const list = (codes: string[]) => {
      const ul = document.createElement('ul'); ul.className = 'grid gap-1 ps-4 list-disc';
      codes.forEach((c) => { const li = document.createElement('li'); li.textContent = cfg.m[c] ?? c; ul.appendChild(li); });
      return ul;
    };

    const run = () => {
      const exemption = sel('exemption').value as 'none' | 'main' | 'social' | 'small';
      root.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => { el.hidden = el.dataset.show !== exemption; });
      const res = computeCapitalGain({
        price: num('price'), acquisitionPrice: num('acq'), coefficient: num('coef'), acquisitionCosts: num('costs'), works: num('works'),
        exemption,
        occupancyYears: exemption === 'social' ? num('sococc') : num('occ'),
        rented: f('rented').checked, usedRecently: f('used').checked, vacancyMonths: num('vac'),
        areaM2: num('area'), firstSale: f('first').checked, yearSalesTotal: num('year'),
      }, cfg.p);
      Object.values(FIELD).forEach((n) => setErr(n, ''));
      const msgs = out('msgs'); const lines = out('lines');
      msgs.replaceChildren(); lines.replaceChildren();
      if (!res.ok) {
        res.errors.forEach((e) => { const n = FIELD[e.field]; if (n) setErr(n, cfg.m[e.code] ?? ''); });
        out('total').textContent = '—'; out('pct').textContent = '—';
        msgs.appendChild(para(cfg.l.wait));
        return;
      }
      if (res.exemption !== 'none') {
        if (res.eligible) msgs.appendChild(para(cfg.l.applied, true));
        else { msgs.appendChild(para(cfg.l.notApplied, true)); msgs.appendChild(list(res.blockers)); msgs.appendChild(para(cfg.l.fallback)); }
        if (res.warnings.length) { msgs.appendChild(para(cfg.l.warnT, true)); msgs.appendChild(list(res.warnings)); }
      }
      const row = (label: string, amount: number, sub = '', neg = false) => {
        const r = document.createElement('div');
        const dt = document.createElement('dt'); dt.append(label);
        if (sub) { const s = document.createElement('span'); s.className = 'block text-xs text-white/70'; s.textContent = sub; dt.appendChild(s); }
        const dd = document.createElement('dd'); dd.textContent = `${neg && amount > 0 ? '− ' : ''}${fmt.format(amount)} ${unit}`;
        r.append(dt, dd); lines.appendChild(r);
      };
      const price = num('price');
      row(cfg.l.lPrice, price);
      row(cfg.l.lReval, res.revalued, `× ${fmtR.format(num('coef'))}`, true);
      row(cfg.l.lCosts, res.costsUsed, res.costsKind === 'flat' ? cfg.l.kFlat : cfg.l.kActual, true);
      if (res.works > 0) row(cfg.l.lWorks, res.works, '', true);
      row(cfg.l.lBase, res.acquisitionBase);
      if (res.loss) row(cfg.l.lLoss, Math.abs(res.profit));
      else row(cfg.l.lProfit, res.profit);
      if (res.applied === 'none') {
        row(cfg.l.lRate, Math.round(Math.max(res.profit, 0) * cfg.p.ratePct / 100));
        row(cfg.l.lMin, res.minTax);
      }
      const tot = document.createElement('div'); tot.className = '!border-0 text-base';
      const tdt = document.createElement('dt'); tdt.className = 'font-semibold'; tdt.textContent = cfg.l.lTax;
      const tdd = document.createElement('dd'); tdd.textContent = `${fmt.format(res.tax)} ${unit}`;
      tot.append(tdt, tdd); lines.appendChild(tot);
      row(cfg.l.lNet, res.netProceeds);
      out('total').textContent = fmt.format(res.tax);
      out('pct').textContent = fmtR.format((res.tax / price) * 100) + ' %';
    };

    form.addEventListener('input', run);
    form.addEventListener('change', run);
    run();
  });
</script>
