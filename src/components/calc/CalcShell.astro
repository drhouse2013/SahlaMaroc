---
/**
 * Cadre commun des calculateurs : formulaire à gauche, résultat à droite.
 * - Badge « Résultat estimatif » sur chaque résultat.
 * - Validation générique : champs numériques négatifs ou invalides signalés (aria-invalid + message),
 *   dates de sortie antérieures à l'entrée signalées (calculateur des 180 jours).
 * - Événements analytics : calculator_start (première saisie), calculator_complete (résultat consulté).
 */
import Icon from '../Icon.astro';
import { useTranslations, type Locale } from '../../i18n';
interface Props { id: string; note?: string }
const { id, note } = Astro.props;
const lang = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(lang);
---
<div class="calc not-prose my-8 overflow-hidden rounded-xl border border-[var(--line)] bg-[var(--surface)] shadow-[var(--shadow-sm)]" data-calc={id} data-msg-invalid={t('calc.invalid')} data-msg-date={t('calc.invalidDate')}>
  <div class="grid md:grid-cols-[1.1fr_0.9fr]">
    <form class="grid content-start gap-4 p-5 sm:grid-cols-2 sm:p-6" onsubmit="return false" novalidate>
      <slot name="form" />
    </form>
    <div class="calc-result bg-navy-700 p-5 text-white sm:p-6 dark:bg-navy-800">
      <p class="calc-badge mb-3 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold text-gold-300"><Icon name="info" class="size-3.5" />{t('calc.estimate')}</p>
      <slot name="result" />
    </div>
  </div>
  {note && <p class="flex gap-2 border-t border-[var(--line)] px-5 py-3 text-xs muted sm:px-6"><Icon name="info" class="mt-0.5 size-3.5 shrink-0" />{note}</p>}
</div>

<style is:global>
  .calc label { display: grid; gap: 0.35rem; font-size: 0.9rem; font-weight: 600; align-content: start; }
  .calc input:not([type="checkbox"]), .calc select {
    width: 100%; min-height: 2.75rem; border-radius: .5rem; border: 1px solid var(--line-strong); background: var(--surface);
    padding: 0.55rem 0.8rem; font: inherit; color: var(--text); font-variant-numeric: tabular-nums;
  }
  .calc input:focus-visible, .calc select:focus-visible, .calc button:focus-visible, .calc a:focus-visible, .calc summary:focus-visible {
    outline: 2px solid var(--focus); outline-offset: 2px; border-color: var(--focus); box-shadow: none;
  }
  .calc-result :focus-visible { outline-color: #fff; box-shadow: none; }
  .calc button, .calc summary, .calc a.btn, .calc [role="button"] { min-height: 2.75rem; min-width: 2.75rem; }
  .calc input[type="checkbox"], .calc input[type="radio"] { width: 1.5rem; height: 1.5rem; }
  .calc label:has(> input[type="checkbox"]), .calc label:has(> input[type="radio"]) { min-height: 2.75rem; align-items: center; }
  @media (prefers-reduced-motion: reduce) { .calc * { transition: none !important; animation: none !important; } }
  .calc input[aria-invalid="true"] { border-color: var(--color-terracotta-500); }
  .calc .calc-err { font-size: .78rem; font-weight: 500; color: var(--color-terracotta-600); }
  .dark .calc .calc-err { color: var(--color-terracotta-300); }
  .calc .full { grid-column: 1 / -1; }
  .calc .big { font-family: var(--font-display); font-size: clamp(2rem, 1.5rem + 1.8vw, 2.75rem); line-height: 1.1; font-weight: 560; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .calc dl { display: grid; gap: 0.5rem; margin-top: 1.25rem; font-size: 0.9rem; }
  .calc dl div { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid rgb(255 255 255 / 0.16); padding-bottom: 0.4rem; }
  .calc dt { color: rgb(255 255 255 / .82); }
  .calc dd { font-weight: 600; font-variant-numeric: tabular-nums; text-align: end; }
  .calc .calc-badge { background: rgb(255 255 255 / .12); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const form = root.querySelector('form')!;
    const id = root.dataset.calc;
    const track = (n: string) => (window as unknown as { sahlaTrack?: (n: string, d?: object) => void }).sahlaTrack?.(n, { calculator: id });
    // Zone live limitée au montant principal (et non à tout le résultat).
    const big = root.querySelector<HTMLElement>('.calc-result .big');
    if (big) { big.setAttribute('aria-live', 'polite'); big.setAttribute('aria-atomic', 'true'); }
    // Clavier numérique mobile.
    form.querySelectorAll<HTMLInputElement>('input[type="number"]').forEach((i) => {
      if (!i.hasAttribute('inputmode')) i.setAttribute('inputmode', i.step && i.step.includes('.') || i.step === 'any' ? 'decimal' : 'numeric');
    });
    let n = 0;
    let started = false;
    let completed = false;

    const showErr = (input: HTMLInputElement, text: string) => {
      const label = input.closest('label') ?? input.parentElement!;
      let err = label.querySelector<HTMLElement>('.calc-err');
      if (text) {
        input.setAttribute('aria-invalid', 'true');
        if (!err) {
          err = document.createElement('span'); err.className = 'calc-err'; err.setAttribute('role', 'alert');
          err.id = `calc-err-${id}-${++n}`; label.appendChild(err);
        }
        input.setAttribute('aria-describedby', err.id);
        err.textContent = text;
      } else {
        input.removeAttribute('aria-invalid');
        input.removeAttribute('aria-describedby');
        err?.remove();
      }
    };

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.type === 'number') {
        const raw = el.value.trim();
        const n = Number(raw.replace(',', '.'));
        const min = el.min !== '' ? Number(el.min) : 0;
        showErr(el, raw !== '' && (!Number.isFinite(n) || n < min) ? root.dataset.msgInvalid! : '');
      }
      if (el.type === 'date') {
        form.querySelectorAll<HTMLInputElement>('input[type="date"][name^="out"]').forEach((out) => {
          const inp = form.querySelector<HTMLInputElement>(`input[name="in${out.name.slice(3)}"]`);
          showErr(out, inp?.value && out.value && out.value < inp.value ? root.dataset.msgDate! : '');
        });
      }
      if (!started) { started = true; track('calculator_start'); }
      if (!completed) { completed = true; window.setTimeout(() => track('calculator_complete'), 2000); }
    });
  });
</script>
