---
/**
 * Calculateur des frais d'autoroute Maroc (ADM) — ville à ville, par classe de véhicule.
 * Logique pure : src/utils/highway-toll.mjs. Données tarifaires : à jour par rapport à ADM.
 */
import { type Locale, LOCALE_META } from '../../i18n';
import CalcShell from './CalcShell.astro';
import { TOLL_RATES, CITIES, VEHICLE_CLASSES, getAvailableDepartureCities, getAvailableDestinationCities } from '../../utils/highway-toll.mjs';

const lang = (Astro.currentLocale ?? 'en') as Locale;
const intl = LOCALE_META[lang].intl;

const T = {
  fr: {
    title: 'Frais d\'autoroute Maroc',
    from: 'Ville de départ',
    to: 'Ville d\'arrivée',
    vehicle: 'Classe de véhicule',
    calculate: 'Calculer',
    toll: 'Tarif estimé',
    dh: 'DH',
    note: 'Tarifs à titre informatif — pour confirmation, consulter ADM. Mise à jour : octobre 2026.',
    loading: 'Chargement…',
    error: 'Erreur',
    error_same_city: 'Veuillez choisir deux villes différentes.',
    error_no_route: 'Aucune route trouvée entre ces deux villes.',
    error_required: 'Veuillez remplir tous les champs.',
    select: '— Choisir une ville —',
    selectDest: '— Choisir une destination —',
    selectVehicle: '— Choisir une classe —',
  },
  en: {
    title: 'Morocco Highway Toll Calculator',
    from: 'Departure city',
    to: 'Destination city',
    vehicle: 'Vehicle class',
    calculate: 'Calculate',
    toll: 'Estimated toll',
    dh: 'MAD',
    note: 'Rates are for information only — confirm with ADM. Updated: October 2026.',
    loading: 'Loading…',
    error: 'Error',
    error_same_city: 'Please choose two different cities.',
    error_no_route: 'No route found between these cities.',
    error_required: 'Please fill in all fields.',
    select: '— Choose a city —',
    selectDest: '— Choose a destination —',
    selectVehicle: '— Choose a class —',
  },
  es: {
    title: 'Calculadora de peajes de autopista de Marruecos',
    from: 'Ciudad de salida',
    to: 'Ciudad de destino',
    vehicle: 'Clase de vehículo',
    calculate: 'Calcular',
    toll: 'Peaje estimado',
    dh: 'MAD',
    note: 'Las tarifas son orientativas — confirme con ADM. Actualizado: octubre de 2026.',
    loading: 'Cargando…',
    error: 'Error',
    error_same_city: 'Seleccione dos ciudades diferentes.',
    error_no_route: 'No se encontró ruta entre estas ciudades.',
    error_required: 'Rellene todos los campos.',
    select: '— Elegir una ciudad —',
    selectDest: '— Elegir un destino —',
    selectVehicle: '— Elegir una clase —',
  },
  de: {
    title: 'Marokko-Autobahngebührenrechner',
    from: 'Abfahrtsstadt',
    to: 'Zielstadt',
    vehicle: 'Fahrzeugklasse',
    calculate: 'Berechnen',
    toll: 'Geschätzte Gebühr',
    dh: 'MAD',
    note: 'Tarife nur zu Informationszwecken — bei ADM bestätigen. Aktualisiert: Oktober 2026.',
    loading: 'Wird geladen…',
    error: 'Fehler',
    error_same_city: 'Bitte wählen Sie zwei verschiedene Städte.',
    error_no_route: 'Keine Route zwischen diesen Städten gefunden.',
    error_required: 'Bitte füllen Sie alle Felder aus.',
    select: '— Stadt wählen —',
    selectDest: '— Ziel wählen —',
    selectVehicle: '— Klasse wählen —',
  },
  ar: {
    title: 'حاسبة رسوم الطرق السريعة بالمغرب',
    from: 'مدينة الانطلاق',
    to: 'مدينة الوصول',
    vehicle: 'فئة المركبة',
    calculate: 'حساب',
    toll: 'الرسم المقدر',
    dh: 'درهم',
    note: 'الأسعار لأغراض إعلامية فقط — تأكد من ADM. تم التحديث: أكتوبر 2026.',
    loading: 'جاري التحميل…',
    error: 'خطأ',
    error_same_city: 'يرجى اختيار مدينتين مختلفتين.',
    error_no_route: 'لم يتم العثور على مسار بين هذه المدن.',
    error_required: 'يرجى ملء جميع الحقول.',
    select: '— اختر مدينة —',
    selectDest: '— اختر وجهة —',
    selectVehicle: '— اختر فئة —',
  },
}[lang];

const availableCities = getAvailableDepartureCities();
const cfg = JSON.stringify({
  t: T,
  locale: intl,
  vehicleClasses: VEHICLE_CLASSES,
  cities: CITIES,
  lang,
});
---

<div data-highway-toll-wrap>
<CalcShell id="highway-toll" note={T.note}>
  <Fragment slot="form">
    <label class="full">{T.from}
      <select name="from" required>
        <option value="">{T.select}</option>
        {availableCities.map((cityId) => (
          <option value={cityId}>{CITIES[cityId]?.[lang] || cityId}</option>
        ))}
      </select>
    </label>

    <label class="full">{T.to}
      <select name="to" required>
        <option value="">{T.selectDest}</option>
      </select>
    </label>

    <fieldset class="full">
      <legend class="text-sm font-semibold mb-2">{T.vehicle}</legend>
      <div class="grid gap-3 sm:grid-cols-3">
        {/* Classe 1 — Voiture légère */}
        <label class="vehicle-card flex flex-col items-center gap-2 cursor-pointer rounded-xl border border-[var(--line)] p-3 transition-colors has-[:checked]:border-majorelle-500 has-[:checked]:bg-majorelle-50 dark:has-[:checked]:bg-majorelle-900/30">
          <input type="radio" name="vehicle" value={1} class="sr-only" />
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 40" class="h-10 w-auto" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 28h52v4a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-4z" fill="currentColor" opacity=".12"/>
            <path d="M10 28l4-12a2 2 0 0 1 1.9-1.4h32.2A2 2 0 0 1 50 16l4 12"/>
            <rect x="4" y="28" width="56" height="6" rx="2"/>
            <circle cx="16" cy="34" r="4" fill="currentColor" opacity=".25"/>
            <circle cx="48" cy="34" r="4" fill="currentColor" opacity=".25"/>
            <line x1="22" y1="20" x2="22" y2="28"/>
            <line x1="42" y1="20" x2="42" y2="28"/>
          </svg>
          <span class="text-xs font-medium text-center">{VEHICLE_CLASSES[1]?.[lang]}</span>
        </label>
        {/* Classe 2 — Fourgon / Minibus */}
        <label class="vehicle-card flex flex-col items-center gap-2 cursor-pointer rounded-xl border border-[var(--line)] p-3 transition-colors has-[:checked]:border-majorelle-500 has-[:checked]:bg-majorelle-50 dark:has-[:checked]:bg-majorelle-900/30">
          <input type="radio" name="vehicle" value={2} class="sr-only" />
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 40" class="h-10 w-auto" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="10" width="48" height="24" rx="3" fill="currentColor" opacity=".12"/>
            <path d="M4 13a3 3 0 0 1 3-3h42a3 3 0 0 1 3 3v2H4z"/>
            <rect x="4" y="10" width="48" height="24" rx="3"/>
            <path d="M52 20h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-6"/>
            <circle cx="16" cy="34" r="4" fill="currentColor" opacity=".25"/>
            <circle cx="44" cy="34" r="4" fill="currentColor" opacity=".25"/>
            <line x1="18" y1="15" x2="18" y2="28"/>
            <line x1="30" y1="15" x2="30" y2="28"/>
            <line x1="42" y1="15" x2="42" y2="28"/>
          </svg>
          <span class="text-xs font-medium text-center">{VEHICLE_CLASSES[2]?.[lang]}</span>
        </label>
        {/* Classe 3 — Camion / Poids lourd */}
        <label class="vehicle-card flex flex-col items-center gap-2 cursor-pointer rounded-xl border border-[var(--line)] p-3 transition-colors has-[:checked]:border-majorelle-500 has-[:checked]:bg-majorelle-50 dark:has-[:checked]:bg-majorelle-900/30">
          <input type="radio" name="vehicle" value={3} class="sr-only" />
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 72 40" class="h-10 w-auto" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="8" width="42" height="22" rx="2" fill="currentColor" opacity=".12"/>
            <rect x="2" y="8" width="42" height="22" rx="2"/>
            <path d="M44 14h14a4 4 0 0 1 4 4v12a2 2 0 0 1-2 2H44"/>
            <path d="M44 14l8 0l6 8v8" fill="currentColor" opacity=".08"/>
            <circle cx="14" cy="32" r="4" fill="currentColor" opacity=".25"/>
            <circle cx="28" cy="32" r="4" fill="currentColor" opacity=".25"/>
            <circle cx="56" cy="32" r="4" fill="currentColor" opacity=".25"/>
          </svg>
          <span class="text-xs font-medium text-center">{VEHICLE_CLASSES[3]?.[lang]}</span>
        </label>
      </div>
    </fieldset>
  </Fragment>

  <Fragment slot="result">
    <p class="text-sm text-white/85">{T.toll}</p>
    <p class="big" dir="ltr">
      <span data-out="toll">—</span>
      <span class="text-base text-white/70 ml-1">{T.dh}</span>
    </p>
    <div data-out="msgs" class="mt-3 grid gap-2 text-sm" role="status"></div>
  </Fragment>
</CalcShell>
</div>

<style is:global>
  [data-highway-toll-wrap] fieldset {
    border: none;
    padding: 0;
  }
  [data-highway-toll-wrap] legend {
    padding: 0;
    margin-bottom: 0.5rem;
  }
  [data-highway-toll-wrap] .vehicle-card:has(:focus-visible) {
    outline: 3px solid var(--color-majorelle-500);
    outline-offset: 2px;
  }
</style>

<script define:vars={{ cfg }}>
  import { calculateToll, getAvailableDestinationCities } from '../../utils/highway-toll.mjs';

  const config = JSON.parse(cfg);

  document.querySelectorAll('[data-highway-toll-wrap]').forEach((wrap) => {
    const root = wrap.querySelector('[data-calc="highway-toll"]');
    const fromSelect = root.querySelector('select[name="from"]');
    const toSelect = root.querySelector('select[name="to"]');
    const vehicleRadios = root.querySelectorAll('input[name="vehicle"]');
    const tollOut = root.querySelector('[data-out="toll"]');
    const msgsOut = root.querySelector('[data-out="msgs"]');
    const nf = new Intl.NumberFormat(config.locale, { maximumFractionDigits: 0 });

    const updateDestinations = () => {
      const fromCity = fromSelect.value;
      const destinations = fromCity ? getAvailableDestinationCities(fromCity) : [];
      const currentTo = toSelect.value;

      toSelect.innerHTML = `<option value="">${config.t.selectDest}</option>`;
      destinations.forEach((cityId) => {
        const opt = document.createElement('option');
        opt.value = cityId;
        opt.textContent = config.cities[cityId]?.[config.lang] || cityId;
        toSelect.appendChild(opt);
      });

      if (destinations.includes(currentTo)) {
        toSelect.value = currentTo;
      } else {
        toSelect.value = '';
      }

      calculate();
    };

    const calculate = () => {
      const fromCity = fromSelect.value;
      const toCity = toSelect.value;
      const vehicleClass = root.querySelector('input[name="vehicle"]:checked')?.value;

      msgsOut.replaceChildren();
      tollOut.textContent = '—';

      if (!fromCity || !toCity || !vehicleClass) {
        if (fromCity && toCity && !vehicleClass) return;
        return;
      }

      const result = calculateToll(fromCity, toCity, Number(vehicleClass));

      if (!result.ok) {
        const errorMsg = document.createElement('p');
        errorMsg.className = 'text-red-400 font-semibold';
        errorMsg.setAttribute('role', 'alert');

        if (result.errors.includes('same_city')) {
          errorMsg.textContent = config.t.error_same_city;
        } else if (result.errors.includes('no_route')) {
          errorMsg.textContent = config.t.error_no_route;
        } else {
          errorMsg.textContent = config.t.error_required;
        }

        msgsOut.appendChild(errorMsg);
        return;
      }

      tollOut.textContent = nf.format(result.toll);
    };

    fromSelect.addEventListener('change', updateDestinations);
    toSelect.addEventListener('change', calculate);
    vehicleRadios.forEach((radio) => radio.addEventListener('change', calculate));
  });
</script>
