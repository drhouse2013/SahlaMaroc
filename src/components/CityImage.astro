---
/** Photo de scène (manifeste) ; ville sans photo vérifiée => <PhotoPlaceholder> ; scène thématique (sahara, atlas…) => illustration SVG. Le conteneur parent fournit forme et taille. */
import { Image } from 'astro:assets';
import type { Locale } from '../i18n';
import type { Scene } from '../data/home';
import { cityById, cityLabel } from '../data/cities';
import { illustration } from '../utils/illustrations';
import { placePhoto } from '../utils/photos';
import PlaceImage from './PlaceImage.astro';
import PhotoCredit from './PhotoCredit.astro';

interface Props { scene: Scene | 'home-hero'; lang: Locale; width?: number; widths?: number[]; sizes?: string; eager?: boolean; priority?: boolean; fallback?: Scene }
const { scene, lang, width = 520, widths, sizes, eager = false, priority = eager, fallback } = Astro.props;
const isHero = scene === 'home-hero';
const photo = placePhoto(isHero ? 'hero' : 'city', scene, lang);
const isPlace = isHero || !!cityById(scene);
const cls = 'h-full w-full object-cover transition duration-500 group-hover:scale-105';
---
{photo.image || isPlace ? (
  <>
    <PlaceImage photo={photo} kind={isHero ? 'hero' : 'city'} lang={lang} name={isHero ? undefined : cityLabel(scene, lang)} width={width} widths={widths} sizes={sizes} eager={eager} priority={priority} class={cls} />
    {photo.credit && <PhotoCredit lang={lang} credit={photo.credit} source={photo.source} />}
  </>
) : (
  <Image src={illustration((fallback ?? scene) as Scene)} alt="" width={width} class={cls} loading={eager ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} />
)}
