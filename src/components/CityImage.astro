---
/** Photo de scène (manifeste) avec repli sur l'illustration SVG. Le conteneur parent fournit forme et taille. */
import { Image } from 'astro:assets';
import type { Locale } from '../i18n';
import type { Scene } from '../data/home';
import { illustration } from '../utils/illustrations';
import { getPhoto, photoCreditLabel } from '../utils/photos';

interface Props { scene: Scene | 'home-hero'; lang: Locale; width?: number; widths?: number[]; sizes?: string; eager?: boolean; fallback?: Scene }
const { scene, lang, width = 520, widths, sizes, eager = false, fallback } = Astro.props;
const photo = getPhoto(scene, lang);
const cls = 'h-full w-full object-cover transition duration-500 group-hover:scale-105';
---
{photo ? (
  <>
    <Image src={photo.src} alt={photo.alt} width={width} widths={widths ?? [width, width * 2]} sizes={sizes ?? `${width}px`} class={cls} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
    {photo.credit && <span dir="auto" class="absolute inset-x-0 bottom-0 truncate bg-black/55 px-2 py-0.5 text-center text-[0.65rem] leading-tight text-white/90">{photoCreditLabel(lang, photo.credit)}</span>}
  </>
) : (
  <Image src={illustration((fallback ?? scene) as Scene)} alt="" width={width} class={cls} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
)}
