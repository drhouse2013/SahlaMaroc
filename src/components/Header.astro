---
/**
 * En-tête de la maquette Sahla Maroc : logo horizontal, navigation à sous-menus, recherche,
 * langue, thème et accès au carnet (« Mon espace »).
 * - Desktop (≥ 900 px) : menu complet, sous-menus <details> (fonctionnent sans JavaScript).
 * - Mobile : logo + recherche + menu déroulant (la barre basse reste gérée par MobileNav).
 * - La recherche ouvre la fenêtre instantanée (SearchBox, attribut data-search-open).
 */
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { brandName } from '../utils/seo';
import { INVEST_HUB } from '../data/paths';
import { useTranslations, type Locale } from '../i18n';
import { CATEGORIES, CATEGORY_ICON } from '../i18n/categories';
import { categoryPath, getPageUrl, homePath, hubPath, getActiveCategories, type Alternates } from '../utils/i18n';

interface Props { lang: Locale; switchTargets?: Alternates }
const { lang, switchTargets } = Astro.props;
const t = useTranslations(lang);
const brand = brandName(lang);
const brandTail = brand.split(' ')[1] ?? '';
const toolUrl = (await getPageUrl(lang, 'calculators')) ?? homePath(lang);
const cats = await getActiveCategories(lang);
const path = Astro.url.pathname;
const account = { fr: 'Mon espace', en: 'My space', es: 'Mi espacio', de: 'Mein Bereich', ar: 'مساحتي' }[lang];
const accountHint = { fr: 'Ouvrir mon carnet de voyage', en: 'Open my travel notebook', es: 'Abrir mi cuaderno', de: 'Reiseheft öffnen', ar: 'افتح دفتري' }[lang];
const themeLabel = { fr: 'Thème', en: 'Theme', es: 'Tema', de: 'Design', ar: 'المظهر' }[lang];
// Libellés courts de navigation (la maquette tient sur une ligne à 1290 px).
const shortLabel = {
  demarches: { fr: 'Démarches', en: 'Paperwork', es: 'Trámites', de: 'Formalitäten', ar: 'الإجراءات' },
  invest: { fr: 'Investir', en: 'Invest', es: 'Invertir', de: 'Investieren', ar: 'استثمار' },
  tools: { fr: 'Outils', en: 'Tools', es: 'Herramientas', de: 'Rechner', ar: 'أدوات' },
};

// « Démarches » n'existe que si la catégorie a des guides publiés dans cette langue.
const hasDemarches = cats.includes('demarches');
const demarchesHref = hasDemarches ? categoryPath(lang, 'demarches') : hubPath(lang, 'mre');
const demarchesLabel = hasDemarches ? shortLabel.demarches[lang] : t('nav.mre');

type SubLink = { href: string; label: string };
type NavItem = { href: string; label: string; sub?: SubLink[] };

const navItems: NavItem[] = [
  { href: homePath(lang), label: t('nav.home') },
  {
    href: hubPath(lang, 'guides'),
    label: t('nav.guides'),
    sub: [
      { href: hubPath(lang, 'guides'), label: t('nav.allGuides') },
      ...(cats.includes('retour') ? [{ href: categoryPath(lang, 'retour'), label: CATEGORIES.retour.label[lang] }] : []),
      ...(cats.includes('immobilier') ? [{ href: categoryPath(lang, 'immobilier'), label: CATEGORIES.immobilier.label[lang] }] : []),
      ...(cats.includes('tours') ? [{ href: categoryPath(lang, 'tours'), label: CATEGORIES.tours.label[lang] }] : []),
    ],
  },
  {
    href: demarchesHref,
    label: demarchesLabel,
    sub: [
      { href: demarchesHref, label: demarchesLabel },
      ...(cats.includes('arrival') ? [{ href: categoryPath(lang, 'arrival'), label: CATEGORIES.arrival.label[lang] }] : []),
      { href: hubPath(lang, 'calendar'), label: t('nav.calendar') },
      { href: hubPath(lang, 'glossary'), label: t('nav.glossary') },
    ],
  },
  {
    href: hubPath(lang, 'invest'),
    label: shortLabel.invest[lang],
    sub: [
      { href: hubPath(lang, 'invest'), label: INVEST_HUB[lang].nav },
      ...(cats.includes('immobilier') ? [{ href: categoryPath(lang, 'immobilier'), label: CATEGORIES.immobilier.label[lang] }] : []),
      ...(cats.includes('money') ? [{ href: categoryPath(lang, 'money'), label: CATEGORIES.money.label[lang] }] : []),
    ],
  },
  {
    href: hubPath(lang, 'visit'),
    label: t('nav.visit'),
    sub: [
      { href: hubPath(lang, 'visit'), label: t('nav.visit') },
      { href: hubPath(lang, 'cities'), label: t('nav.cities') },
      { href: hubPath(lang, 'regions'), label: t('nav.regions') },
    ],
  },
  {
    href: toolUrl,
    label: shortLabel.tools[lang],
    sub: [
      { href: toolUrl, label: t('nav.tools') },
      { href: hubPath(lang, 'checklists'), label: t('nav.checklists') },
      { href: hubPath(lang, 'search'), label: t('nav.search') },
      { href: hubPath(lang, 'news'), label: t('nav.news') },
    ],
  },
];
const searchHref = hubPath(lang, 'search');
const isCurrent = (href: string) => path === href || (href !== homePath(lang) && path.startsWith(href + '/'));
const isFrench = lang === 'fr';
---

<header class="tpl-header">
  <div class="tpl-header__inner">
    <a href={homePath(lang)} class="tpl-brand" aria-label={`${brand} — ${t('nav.home')}`}>
      {isFrench ? (
        <>
          <img class="logo-light" src="/assets/logos/logo-horizontal-clair.svg" alt={brand} width="435" height="92" loading="eager" />
          <img class="logo-dark" src="/assets/logos/logo-horizontal-sombre.svg" alt={brand} width="435" height="92" loading="eager" />
        </>
      ) : (
        <span class="tpl-brand__fallback">
          <Logo class="h-9 w-8" />
          <span dir="ltr">Sahla <span class="italic">{brandTail}</span></span>
        </span>
      )}
    </a>
    <div class="tpl-header__divider" aria-hidden="true"></div>

    <nav class="tpl-nav" aria-label={t('nav.main')}>
      {navItems.map((item) => (
        item.sub ? (
          <details class="tpl-nav__item" data-nav-menu>
            <summary class="tpl-nav__link" aria-current={isCurrent(item.href) ? 'page' : item.sub.some((s) => isCurrent(s.href)) ? 'location' : undefined}>
              {item.label}
              <Icon name="chevronDown" class="size-3.5 tpl-nav__chev" />
            </summary>
            <div class="tpl-nav__menu">{item.sub.map((s) => <a href={s.href}>{s.label}</a>)}{item.href === toolUrl && <div class="tpl-menu-theme"><ThemeToggle lang={lang} /></div>}</div>
          </details>
        ) : (
          <a class="tpl-nav__item tpl-nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
        )
      ))}
    </nav>

    <div class="tpl-controls">
      <a href={searchHref} data-search-open class="tpl-iconbtn" aria-label={t('nav.search')}><Icon name="search" class="size-5" /></a>
      <div class="tpl-lang-wrap"><LanguageSwitcher lang={lang} targets={switchTargets ?? {}} /></div>
      <button type="button" class="tpl-iconbtn tpl-theme" data-theme-cycle aria-label={themeLabel}>
        <Icon name="sun" class="size-4 tpl-theme__sun" /><Icon name="moon" class="size-4 tpl-theme__moon" />
      </button>
      <button type="button" class="tpl-account" data-notebook-open aria-label={accountHint}>
        <Icon name="userRound" class="size-4" /><span>{account}</span>
      </button>
      <details class="tpl-burger-wrap" data-nav-menu>
        <summary class="tpl-burger" aria-label={t('nav.menu')}><Icon name="menu" class="size-6" /></summary>
        <div class="tpl-nav__menu tpl-nav__menu--mobile">
          <p class="tpl-nav__mobile-title">{t('nav.main')}</p>
          {navItems.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : item.sub?.some((s) => isCurrent(s.href)) ? 'location' : undefined}>{item.label}</a>
          ))}
          <hr />
          {cats.map((id) => (
            <a href={categoryPath(lang, id)}><Icon name={CATEGORY_ICON[id]} class="size-4" />{CATEGORIES[id].label[lang]}</a>
          ))}
          <hr />
          <a href={hubPath(lang, 'checklists')}>{t('nav.checklists')}</a>
          <a href={hubPath(lang, 'glossary')}>{t('nav.glossary')}</a>
          <a href={hubPath(lang, 'calendar')}>{t('nav.calendar')}</a>
          <a href={hubPath(lang, 'news')}>{t('nav.news')}</a>
          <div class="tpl-nav__mobile-theme"><ThemeToggle lang={lang} row /></div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Menus <details> : un seul ouvert à la fois, fermeture au clic extérieur et à Échap.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-nav-menu], details[data-lang-switcher]'));
  menus.forEach((m) => m.addEventListener('toggle', () => { if (m.open) menus.forEach((o) => o !== m && (o.open = false)); }));
  document.addEventListener('click', (e) => menus.forEach((m) => { if (m.open && !m.contains(e.target as Node)) m.open = false; }));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus.forEach((m) => { if (m.open) { m.open = false; m.querySelector('summary')?.focus(); } });
  });

  // « Mon espace » ouvre le carnet de voyage (composant TravelNotebook).
  document.querySelectorAll('[data-notebook-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const notebook = document.querySelector<HTMLDetailsElement>('details[data-notebook]');
      if (!notebook) return;
      notebook.open = true;
      notebook.scrollIntoView({ block: 'nearest' });
      notebook.querySelector<HTMLElement>('summary')?.focus();
    });
  });

  // Bouton thème compact : système → clair → sombre (le select complet reste dans le menu mobile).
  document.querySelectorAll<HTMLButtonElement>('[data-theme-cycle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const order = ['system', 'light', 'dark'] as const;
      const current = document.documentElement.dataset.themePreference ?? 'system';
      const next = order[(order.indexOf(current as (typeof order)[number]) + 1) % order.length];
      btn.dataset.themeNext = next;
      document.dispatchEvent(new CustomEvent('sahla:theme-change', { detail: next }));
    });
  });
</script>
