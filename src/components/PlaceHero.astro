---
/** En-tête des pages lieu (ville, région) : photo authentique plein cadre + crédit lié à la source, puis panneau titre/intro qui la chevauche. Sans photo vérifiée : <PhotoPlaceholder>. Sans `photo` : en-tête simple. */
import Breadcrumbs from './Breadcrumbs.astro';
import PlaceImage from './PlaceImage.astro';
import type { Locale } from '../i18n';
import { type PlaceKind, type PlacePhoto } from '../utils/photos';
import PhotoCredit from './PhotoCredit.astro';
interface Props { lang: Locale; crumbs: { name: string; href?: string }[]; title: string; intro?: string; meta?: string; photo?: PlacePhoto; kind?: PlaceKind; name?: string }
const { lang, crumbs, title, intro, meta, photo, kind = 'city', name = title } = Astro.props;
---
<header class="place-hero" data-place-hero>
  {photo && (
    <div class:list={['place-hero__media', !photo.image && 'place-hero__media--ph']}>
      <PlaceImage photo={photo} kind={kind} lang={lang} name={name} width={1600} widths={[640, 1024, 1600]} sizes="100vw" class="h-full w-full object-cover" eager />
      {photo.credit && <PhotoCredit lang={lang} credit={photo.credit} source={photo.source} />}
    </div>
  )}
  <div class="container-page relative">
    <div class:list={['place-hero__panel', photo && 'place-hero__panel--over']}>
      <Breadcrumbs items={crumbs} lang={lang} />
      <h1 class="mt-5 text-3xl font-semibold tracking-tight sm:text-[2.75rem]">{title}</h1>
      <slot />
      {intro && <p class="mt-4 max-w-3xl text-lg muted">{intro}</p>}
      {meta && <p class="mt-3 text-sm muted">{meta}</p>}
    </div>
  </div>
</header>
<style>
  .place-hero { border-bottom: 1px solid var(--line); padding-bottom: 2rem; }
  .place-hero__media { position: relative; width: 100%; height: 75vw; overflow: hidden; background: var(--surface); }
  @media (min-width: 640px) { .place-hero__media { height: min(43vw, 34rem); } }
  .place-hero__media--ph { height: 48vw; min-height: 11rem; }
  @media (min-width: 768px) { .place-hero__media--ph :global(.photo-ph) { padding-bottom: 6rem; } }
  @media (min-width: 640px) { .place-hero__media--ph { height: min(26vw, 20rem); } }
  .place-hero__panel { padding-top: 2rem; }
  .place-hero__panel--over { position: relative; background: var(--surface-2); border-radius: 12px 12px 0 0; padding: 1.25rem 0 0; max-width: 48rem; }
  @media (min-width: 768px) { .place-hero__panel--over { margin-top: -6rem; padding: 2rem 2rem 0; } }
</style>
