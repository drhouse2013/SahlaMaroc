---
/** En-tête des pages lieu (ville, région) : photo authentique plein cadre + crédit lié à la source, puis panneau titre/intro qui la chevauche. Repli : illustration SVG ou en-tête simple. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Locale } from '../i18n';
import { photoCreditLabel, type CityPhoto } from '../utils/photos';
interface Props { lang: Locale; crumbs: { name: string; href?: string }[]; title: string; intro?: string; meta?: string; photo?: CityPhoto | null; fallback?: ImageMetadata }
const { lang, crumbs, title, intro, meta, photo, fallback } = Astro.props;
const img = photo?.src ?? fallback;
---
<header class="place-hero" data-place-hero>
  {img && (
    <div class="place-hero__media">
      <Image src={img} alt={photo?.alt ?? ''} width={1600} widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
      {photo?.credit && (
        photo.source
          ? <a href={photo.source} rel="noopener" target="_blank" dir="auto" class="place-hero__credit">{photoCreditLabel(lang, photo.credit)}</a>
          : <span dir="auto" class="place-hero__credit">{photoCreditLabel(lang, photo.credit)}</span>
      )}
    </div>
  )}
  <div class="container-page relative">
    <div class:list={['place-hero__panel', img && 'place-hero__panel--over']}>
      <Breadcrumbs items={crumbs} lang={lang} />
      <h1 class="mt-5 text-3xl font-semibold tracking-tight sm:text-[2.75rem]">{title}</h1>
      <slot />
      {intro && <p class="mt-4 max-w-3xl text-lg muted">{intro}</p>}
      {meta && <p class="mt-3 text-sm muted">{meta}</p>}
    </div>
  </div>
</header>
<style>
  .place-hero { border-bottom: 1px solid var(--line); padding-bottom: 2rem; }
  .place-hero__media { position: relative; width: 100%; height: 75vw; overflow: hidden; background: var(--surface); }
  @media (min-width: 640px) { .place-hero__media { height: min(43vw, 34rem); } }
  .place-hero__credit { position: absolute; inset-inline-end: 0; bottom: 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: rgb(0 0 0 / .6); color: #fff; font-size: .7rem; line-height: 1.2; padding: .3rem .6rem; border-start-start-radius: 8px; }
  a.place-hero__credit:hover, a.place-hero__credit:focus-visible { text-decoration: underline; }
  .place-hero__panel { padding-top: 2rem; }
  .place-hero__panel--over { position: relative; background: var(--surface-2); border-radius: 12px 12px 0 0; padding: 1.25rem 0 0; max-width: 48rem; }
  @media (min-width: 768px) { .place-hero__panel--over { margin-top: -6rem; padding: 2rem 2rem 0; } }
</style>
