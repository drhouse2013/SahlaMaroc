---
/** Galerie « Lieux à visiter » : filtres par type, 6 premiers lieux puis « Voir tous » (sans JS : tout est visible). */
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
import type { Spot, SpotKind } from '../data/spots';
import PlaceImage from './PlaceImage.astro';
import { placePhoto } from '../utils/photos';
import PhotoCredit from './PhotoCredit.astro';
import { pluralize } from '../utils/plural';

interface Props { lang: Locale; cityId: string; spots: Spot[] }
const { lang, cityId, spots } = Astro.props;
const t = useTranslations(lang);
const LIMIT = 6;
const items = spots.map((s) => ({ s, photo: placePhoto('spot', `${cityId}/${s.id}`, lang) }));
const ORDER: SpotKind[] = ['monument', 'place', 'beach', 'nature', 'market', 'museum', 'viewpoint'];
const kinds = ORDER.filter((k) => spots.some((s) => s.kind === k));
const countOf = (k: string) => (k === 'all' ? spots.length : spots.filter((s) => s.kind === k).length);
const countLabel = (n: number) => pluralize(lang, n, t('spots.count'));
// Libellés pré-calculés (pluriel côté serveur) pour le script client.
const labels = Object.fromEntries(['all', ...kinds].map((k) => [k, { count: countLabel(countOf(k)), more: t('spots.showAll', { n: countOf(k) }) }]));
---
<div class="spots mt-5" data-spots-root data-labels={JSON.stringify(labels)} data-limit={LIMIT} data-less={t('spots.showLess')}>
  {kinds.length > 1 && (
    <div data-spots-bar hidden>
      <div role="group" aria-label={t('spots.filters')} class="flex flex-wrap gap-2">
        {['all', ...kinds].map((k, i) => (
          <button type="button" class="spot-chip" data-kind={k} aria-pressed={i === 0 ? 'true' : 'false'}>
            {k === 'all' ? t('spots.all') : t(`spots.kindPl.${k}` as "spots.kindPl.monument")} <span class="spot-chip-n" aria-hidden="true">{countOf(k)}</span>
          </button>
        ))}
      </div>
    </div>
  )}
  <p class="mt-3 text-sm muted" data-spots-count role="status" aria-live="polite">{countLabel(spots.length)}</p>
  <ul class="spots-grid mt-4 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3" data-spots>
    {items.map(({ s, photo }, i) => (
      <li class="spot-card card group overflow-hidden" style={`--i:${i % 6}`} data-spot={s.id} data-kind={s.kind}>
        <div class="relative aspect-[4/3] overflow-hidden bg-[var(--surface-2,rgba(128,128,128,.12))]">
          <PlaceImage photo={photo} kind={s.kind} lang={lang} name={s.name[lang] ?? s.name.fr} width={480} widths={[480, 720]} sizes="(min-width:1280px) 280px, (min-width:640px) 45vw, 92vw" class="spot-img h-full w-full object-cover" />
          {photo.credit && <PhotoCredit lang={lang} credit={photo.credit} source={photo.source} />}
          <span class="spot-badge absolute start-2 top-2">{t(`spots.kind.${s.kind}`)}</span>
        </div>
        <div class="p-4">
          <h3 class="font-semibold">{s.name[lang] ?? s.name.fr}</h3>
          <p class="mt-1 text-sm muted">{s.text[lang] ?? s.text.fr}</p>
        </div>
      </li>
    ))}
  </ul>
  {spots.length > LIMIT && (
    <p class="mt-5 text-center"><button type="button" class="btn btn-ghost btn-sm" data-spots-more aria-expanded="false" hidden>{t('spots.showAll', { n: spots.length })}</button></p>
  )}
</div>
<style>
  .spot-chip { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.5rem; padding: .3rem .85rem; border-radius: 999px; border: 1px solid var(--line-strong, var(--line)); background: var(--surface); color: var(--text); font-size: .85rem; font-weight: 600; cursor: pointer; transition: background-color .2s, border-color .2s; }
  .spot-chip:hover { border-color: var(--text); }
  .spot-chip-n { font-weight: 500; opacity: .7; font-variant-numeric: tabular-nums; }
  .spot-chip[aria-pressed="true"] { background: var(--color-navy-700); color: #fff; border-color: var(--color-navy-700); }
  :global(.dark) .spot-chip[aria-pressed="true"] { background: var(--color-sand-50); color: var(--color-navy-800); border-color: var(--color-sand-50); }
  .spot-badge { display: inline-flex; padding: .2rem .65rem; border-radius: 999px; background: #14161f; color: #fff; border: 1px solid rgb(255 255 255 / .28); font-size: .75rem; font-weight: 600; line-height: 1.3; box-shadow: 0 1px 3px rgb(0 0 0 / .3); }
  .spot-card { transition: transform .25s ease, box-shadow .25s ease; }
  .spot-card:hover, .spot-card:focus-within { transform: translateY(-3px); box-shadow: 0 10px 24px rgb(0 0 0 / .14); }
  .spot-img { transition: transform .5s ease; }
  .spot-card:hover .spot-img { transform: scale(1.05); }
  .spot-card[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .spot-card { animation: spot-in .5s ease both; animation-delay: calc(var(--i) * 60ms); }
    @keyframes spot-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .spot-card, .spot-img, .spot-chip { transition: none; }
    .spot-card:hover, .spot-card:hover .spot-img { transform: none; }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-spots-root]').forEach((root) => {
    const labels = JSON.parse(root.dataset.labels ?? '{}') as Record<string, { count: string; more: string }>;
    const limit = Number(root.dataset.limit) || 6;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-spot]')];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('.spot-chip')];
    const more = root.querySelector<HTMLButtonElement>('[data-spots-more]');
    const counter = root.querySelector<HTMLElement>('[data-spots-count]');
    let kind = 'all', expanded = false;
    const render = () => {
      const match = cards.filter((c) => kind === 'all' || c.dataset.kind === kind);
      cards.forEach((c) => { const i = match.indexOf(c); c.hidden = i < 0 || (!expanded && i >= limit); });
      chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kind === kind)));
      if (counter) counter.textContent = labels[kind]?.count ?? '';
      if (more) {
        more.hidden = match.length <= limit;
        more.setAttribute('aria-expanded', String(expanded));
        more.textContent = expanded ? root.dataset.less ?? '' : labels[kind]?.more ?? '';
      }
    };
    chips.forEach((b) => b.addEventListener('click', () => { kind = b.dataset.kind ?? 'all'; expanded = false; render(); }));
    more?.addEventListener('click', () => { expanded = !expanded; render(); });
    root.querySelector<HTMLElement>('[data-spots-bar]')?.removeAttribute('hidden');
    render();
  });
</script>
