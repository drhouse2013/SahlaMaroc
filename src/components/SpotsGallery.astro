---
/** Galerie « Lieux à visiter » : cartes photo (repli icône), badge de type, description. */
import { Image } from 'astro:assets';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
import type { Spot } from '../data/spots';
import { getSpotPhoto, photoCreditLabel } from '../utils/photos';

interface Props { lang: Locale; cityId: string; spots: Spot[] }
const { lang, cityId, spots } = Astro.props;
const t = useTranslations(lang);
const items = spots.map((s) => ({ s, photo: getSpotPhoto(cityId, s.id, lang) }));
---
<ul class="spots-grid mt-5 grid list-none gap-4 p-0 sm:grid-cols-2 xl:grid-cols-3" data-spots>
  {items.map(({ s, photo }, i) => (
    <li class="spot-card card group overflow-hidden" style={`--i:${i % 6}`} data-spot={s.id}>
      <div class="relative aspect-[4/3] overflow-hidden bg-[var(--surface-2,rgba(128,128,128,.12))]">
        {photo ? (
          <>
            <Image src={photo.src} alt={photo.alt} width={480} widths={[360, 480, 720]} sizes="(min-width:1280px) 280px, (min-width:640px) 45vw, 92vw" class="spot-img h-full w-full object-cover" loading="lazy" />
            {photo.credit && <span dir="auto" class="absolute inset-x-0 bottom-0 truncate bg-black/55 px-2 py-0.5 text-center text-[0.65rem] leading-tight text-white/90">{photoCreditLabel(lang, photo.credit)}</span>}
          </>
        ) : (
          <div class="flex h-full w-full items-center justify-center muted" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-12 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          </div>
        )}
        <span class="badge badge-gold absolute start-2 top-2">{t(`spots.kind.${s.kind}`)}</span>
      </div>
      <div class="p-4">
        <h3 class="font-semibold">{s.name[lang] ?? s.name.fr}</h3>
        <p class="mt-1 text-sm muted">{s.text[lang] ?? s.text.fr}</p>
      </div>
    </li>
  ))}
</ul>
<style>
  .spot-card { transition: transform .25s ease, box-shadow .25s ease; }
  .spot-card:hover, .spot-card:focus-within { transform: translateY(-3px); box-shadow: 0 10px 24px rgb(0 0 0 / .14); }
  .spot-img { transition: transform .5s ease; }
  .spot-card:hover .spot-img { transform: scale(1.05); }
  @media (prefers-reduced-motion: no-preference) {
    .spot-card { animation: spot-in .5s ease both; animation-delay: calc(var(--i) * 60ms); }
    @keyframes spot-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .spot-card, .spot-img { transition: none; }
    .spot-card:hover, .spot-card:hover .spot-img { transform: none; }
  }
</style>
