---
/**
 * <LanguageSwitcher lang targets />
 * Menu 100 % HTML (<details>) : accessible au clavier, fonctionne sans JavaScript.
 * - Si la page existe dans une langue => lien direct vers SA traduction (slug traduit).
 * - Sinon => lien vers l'accueil de cette langue (jamais de 404).
 */
import Icon from './Icon.astro';
import { LOCALES, LOCALE_META, useTranslations, type Locale } from '../i18n';
import type { Alternates } from '../utils/i18n';

interface Props { lang: Locale; targets: Alternates }
const { lang, targets } = Astro.props;
const t = useTranslations(lang);
---

<details class="group relative" data-lang-switcher>
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-2.5 py-1.5 text-xs sm:text-sm font-medium text-white/90 hover:text-white hover:bg-white/10 transition-colors [&::-webkit-details-marker]:hidden"
    aria-label={`${t('lang.switch')} (${LOCALE_META[lang].label})`}
  >
    <span class="text-sm leading-none" aria-hidden="true">{LOCALE_META[lang].flag}</span>
    <span class="uppercase font-semibold tracking-wide">{lang}</span>
    <Icon name="chevronDown" class="size-3 transition group-open:rotate-180 opacity-70" />
  </summary>
  <ul class="absolute end-0 z-50 mt-2 w-48 overflow-hidden rounded-xl bg-white text-gray-900 shadow-2xl border border-[#ede3d5] py-1.5" aria-label={t('lang.label')}>
    {LOCALES.map((code) => {
      const meta = LOCALE_META[code];
      return (
        <li>
          <a
            href={targets[code] ?? `/${code}`}
            hreflang={meta.hreflang}
            lang={meta.hreflang}
            dir={meta.dir}
            data-lang-link={code}
            aria-current={code === lang ? 'true' : undefined}
            class:list={[
              'flex items-center justify-between gap-3 px-4 py-2 text-xs sm:text-sm transition-colors',
              code === lang ? 'bg-[#fbf5ec] font-bold text-[#c05621]' : 'text-gray-800 hover:bg-[#fbf5ec] hover:text-[#c05621]'
            ]}
          >
            <span class="flex items-center gap-2">
              <span aria-hidden="true">{meta.flag}</span>
              <span>{meta.label}</span>
            </span>
            <span class="text-xs uppercase text-gray-400 font-mono" aria-hidden="true">{code}</span>
          </a>
        </li>
      );
    })}
  </ul>
</details>
