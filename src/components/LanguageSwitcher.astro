---
/**
 * <LanguageSwitcher lang alternates />
 * Menu déroulant 100 % HTML (<details>) : zéro JavaScript, accessible au clavier.
 * - Si la page existe dans une langue => lien direct vers SA traduction (slug traduit).
 * - Sinon => lien vers l'accueil de cette langue (jamais de 404).
 */
import { LOCALES, LOCALE_META, useTranslations, type Locale } from '../i18n';
import type { Alternates } from '../utils/i18n';

interface Props {
  lang: Locale;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const current = LOCALE_META[lang];
---

<details class="group relative" data-lang-switcher>
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium hover:bg-sand-100 dark:hover:bg-white/10 [&::-webkit-details-marker]:hidden"
    aria-label={t('lang.switch')}
  >
    <span aria-hidden="true">{current.flag}</span>
    <span class="uppercase">{lang}</span>
    <svg class="size-3 transition group-open:rotate-180" viewBox="0 0 12 12" aria-hidden="true"
      ><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg
    >
  </summary>
  <ul
    class="absolute end-0 z-50 mt-2 w-44 overflow-hidden rounded-xl border border-ink-900/10 bg-white py-1 shadow-lg dark:border-white/10 dark:bg-ink-900"
  >
    {
      LOCALES.map((code) => {
        const meta = LOCALE_META[code];
        const href = alternates[code] ?? `/${code}`;
        return (
          <li>
            <a
              href={href}
              hreflang={meta.hreflang}
              lang={meta.hreflang}
              dir={meta.dir}
              aria-current={code === lang ? 'true' : undefined}
              class:list={[
                'flex items-center gap-3 px-4 py-2 text-sm hover:bg-sand-100 dark:hover:bg-white/10',
                code === lang && 'font-bold text-terracotta-600 dark:text-terracotta-100',
              ]}
            >
              <span aria-hidden="true">{meta.flag}</span>
              {meta.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</details>
