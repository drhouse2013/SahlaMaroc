---
/**
 * <LanguageSwitcher lang targets />
 * Menu 100 % HTML (<details>) : accessible au clavier, fonctionne sans JavaScript.
 * - Si la page existe dans une langue => lien direct vers SA traduction (slug traduit).
 * - Sinon => lien vers l'accueil de cette langue (jamais de 404).
 */
import Icon from './Icon.astro';
import { LOCALES, LOCALE_META, useTranslations, type Locale } from '../i18n';
import type { Alternates } from '../utils/i18n';

interface Props { lang: Locale; targets: Alternates }
const { lang, targets } = Astro.props;
const t = useTranslations(lang);
---

<details class="group relative" data-lang-switcher>
  <summary
    class="flex min-h-10 cursor-pointer list-none items-center gap-1.5 rounded-full px-2 text-sm font-medium hover:bg-sand-100 sm:px-3 dark:hover:bg-white/10 [&::-webkit-details-marker]:hidden"
    aria-label={`${t('lang.switch')} (${LOCALE_META[lang].label})`}
  >
    <Icon name="globe" class="size-4" />
    <span class="uppercase">{lang}</span>
    <Icon name="chevronDown" class="size-3.5 transition group-open:rotate-180" />
  </summary>
  <ul class="card absolute end-0 z-50 mt-2 w-48 overflow-hidden py-1 shadow-[var(--shadow-lg)]" aria-label={t('lang.label')}>
    {LOCALES.map((code) => {
      const meta = LOCALE_META[code];
      return (
        <li>
          <a
            href={targets[code] ?? `/${code}`}
            hreflang={meta.hreflang}
            lang={meta.hreflang}
            dir={meta.dir}
            data-lang-link={code}
            aria-current={code === lang ? 'true' : undefined}
            class:list={['flex min-h-10 items-center justify-between gap-3 px-4 py-2 text-sm hover:bg-sand-100 dark:hover:bg-white/10', code === lang && 'font-semibold text-terracotta-600 dark:text-terracotta-300']}
          >
            {meta.label}
            <span class="text-xs uppercase muted" aria-hidden="true">{code}</span>
          </a>
        </li>
      );
    })}
  </ul>
</details>
