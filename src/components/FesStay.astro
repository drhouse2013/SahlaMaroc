---
import type { Locale } from '../i18n';
import PlaceImage from './PlaceImage.astro';
import PhotoCredit from './PhotoCredit.astro';
import { placePhoto } from '../utils/photos';
interface Props { lang: Locale }
const { lang } = Astro.props;
const copy = {
  fr: { title: 'Trois jours, à votre rythme', intro: 'Une proposition pour alterner médina, architecture et jardins. Adaptez les étapes à vos envies et aux conditions de visite.', day: 'Jour', titles: ['Prendre ses repères', 'Regarder les détails', 'Faire une pause au jardin'], texts: ['Commencez par Bab Boujloud et découvrez la médina, sans chercher à tout voir dès le premier jour.', 'Consacrez cette journée à la médersa Al Attarine et aux métiers de la médina. Gardez du temps pour les pauses et les détours.', 'Terminez par Jnan Sbil, puis retrouvez les ruelles ou les lieux que vous souhaitez revoir.'], map: 'Repérer le lieu sur la carte', note: 'Parcours éditorial proposé, sans réservation incluse. Vérifiez les conditions d’accès, les horaires et les tarifs auprès des lieux avant de partir.', source: 'Découvrir Fès avec l’Office national marocain du tourisme', budget: 'Préparer mon budget', places: 'Explorer tous les lieux' },
  en: { title: 'Three days, at your own pace', intro: 'A suggested stay combining the medina, architecture and gardens. Adapt each day to your interests and visiting conditions.', day: 'Day', titles: ['Find your bearings', 'Look at the details', 'Take a garden break'], texts: ['Start at Bab Boujloud and explore the medina without trying to see everything on your first day.', 'Set aside this day for Al Attarine Madrasa and the medina’s crafts. Leave room for breaks and detours.', 'Finish with Jnan Sbil, then return to the lanes or places you would like to see again.'], map: 'Find this place on the map', note: 'Suggested editorial itinerary; reservations are not included. Check access, opening hours and prices with each venue before visiting.', source: 'Explore Fez with the Moroccan National Tourist Office', budget: 'Plan my budget', places: 'Explore all places' },
  es: { title: 'Tres días, a tu ritmo', intro: 'Una propuesta que combina medina, arquitectura y jardines. Adapta las etapas a tus intereses y a las condiciones de visita.', day: 'Día', titles: ['Orientarse', 'Observar los detalles', 'Descansar en el jardín'], texts: ['Empieza por Bab Boujloud y descubre la medina sin intentar verlo todo el primer día.', 'Dedica este día a la madrasa Al Attarine y a los oficios de la medina. Reserva tiempo para descansar y desviarte del camino.', 'Termina con Jnan Sbil y vuelve después a los lugares que quieras ver de nuevo.'], map: 'Localizar en el mapa', note: 'Itinerario editorial propuesto, sin reservas incluidas. Consulta las condiciones de acceso, horarios y precios antes de ir.', source: 'Descubrir Fez con la Oficina Nacional de Turismo de Marruecos', budget: 'Preparar mi presupuesto', places: 'Explorar todos los lugares' },
  de: { title: 'Drei Tage im eigenen Tempo', intro: 'Ein Vorschlag mit Medina, Architektur und Gärten. Passen Sie die Etappen Ihren Interessen und den Besuchsbedingungen an.', day: 'Tag', titles: ['Sich orientieren', 'Details entdecken', 'Eine Gartenpause einlegen'], texts: ['Beginnen Sie am Bab Boujloud und erkunden Sie die Medina, ohne am ersten Tag alles sehen zu wollen.', 'Widmen Sie diesen Tag der Al-Attarine-Madrasa und dem Handwerk in der Medina. Lassen Sie Zeit für Pausen und Umwege.', 'Besuchen Sie zum Abschluss Jnan Sbil und kehren Sie anschließend zu Orten zurück, die Sie erneut sehen möchten.'], map: 'Ort auf der Karte finden', note: 'Redaktioneller Reisevorschlag ohne Reservierungen. Prüfen Sie Zugang, Öffnungszeiten und Preise vor dem Besuch beim jeweiligen Ort.', source: 'Fès beim marokkanischen Fremdenverkehrsamt entdecken', budget: 'Budget planen', places: 'Alle Orte entdecken' },
  ar: { title: 'ثلاثة أيام على إيقاعك', intro: 'اقتراح يجمع المدينة العتيقة والعمارة والحدائق. عدّل المراحل حسب اهتماماتك وظروف الزيارة.', day: 'اليوم', titles: ['التعرّف على المكان', 'تأمّل التفاصيل', 'استراحة في الحديقة'], texts: ['ابدأ من باب بوجلود واكتشف المدينة العتيقة دون محاولة رؤية كل شيء في اليوم الأول.', 'خصّص هذا اليوم لمدرسة العطارين وحرف المدينة العتيقة، واترك وقتاً للاستراحة والتجوّل.', 'اختتم بحديقة جنان السبيل ثم عد إلى الأزقة أو الأماكن التي تود رؤيتها مجدداً.'], map: 'تحديد المكان على الخريطة', note: 'مسار تحريري مقترح لا يشمل الحجوزات. تحقّق من شروط الدخول والمواعيد والأسعار لدى كل موقع قبل الزيارة.', source: 'اكتشف فاس مع المكتب الوطني المغربي للسياحة', budget: 'إعداد الميزانية', places: 'استكشاف جميع الأماكن' },
}[lang];
const stops = [
  { id: 'fes-el-bali', query: 'Bab Boujloud Fes Morocco', name: 'Bab Boujloud · Fès el-Bali' },
  { id: 'al-attarine', query: 'Al Attarine Madrasa Fes Morocco', name: 'Al Attarine' },
  { id: 'jnan-sbil', query: 'Jnan Sbil Fes Morocco', name: 'Jnan Sbil' },
].map((s) => ({ ...s, photo: placePhoto('spot', `fes/${s.id}`, lang) }));
---
<section id="stay-plan" class="fes-stay container-page section" aria-labelledby="stay-plan-title">
  <div class="fes-stay__head"><h2 id="stay-plan-title" class="section-title">{copy.title}</h2><p class="section-sub">{copy.intro}</p></div>
  <div class="fes-stay__layout">
    <figure class="fes-stay__photo"><PlaceImage photo={stops[1].photo} kind="monument" lang={lang} width={900} widths={[480, 900, 1200]} sizes="(min-width:900px) 42vw, 92vw" class="fes-stay__image" />{stops[1].photo.credit && <PhotoCredit lang={lang} credit={stops[1].photo.credit} source={stops[1].photo.source} />}<figcaption>{stops[1].name}</figcaption></figure>
    <ol class="fes-stay__days">{stops.map((stop, i) => <li><details open={i === 0}><summary><span class="fes-stay__day">{copy.day} {i + 1}</span><span>{copy.titles[i]}</span></summary><div class="fes-stay__body"><p>{copy.texts[i]}</p><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(stop.query)}`} target="_blank" rel="noopener noreferrer">{copy.map} ↗</a></div></details></li>)}</ol>
  </div>
  <p class="fes-stay__note">{copy.note}</p>
  <p class="fes-stay__links"><a href="#budget">{copy.budget}</a><a href="#spots">{copy.places}</a><a href="https://www.visitmorocco.com/fr/voyage/fes" target="_blank" rel="noopener noreferrer">{copy.source} ↗</a></p>
</section>
<style>
  .fes-stay__head{max-width:44rem;margin-bottom:2rem}.fes-stay__layout{display:grid;gap:2rem}.fes-stay__photo{position:relative;margin:0;aspect-ratio:3/2;overflow:hidden;border-radius:12px;background:var(--surface)}.fes-stay__photo :global(.fes-stay__image){width:100%;height:100%;object-fit:cover}.fes-stay__photo figcaption{position:absolute;inset:auto auto 1rem 1rem;background:var(--surface);color:var(--text);padding:.35rem .7rem;font-size:.8rem;border-radius:4px}.fes-stay__days{list-style:none;padding:0;margin:0}.fes-stay__days li{border-top:1px solid var(--line)}.fes-stay__days li:last-child{border-bottom:1px solid var(--line)}summary{display:flex;gap:1rem;align-items:baseline;cursor:pointer;padding:1.25rem 0;font-family:var(--font-display);font-size:clamp(1.25rem,2vw,1.75rem);line-height:1.3}summary::marker{content:''}.fes-stay__day{flex:none;font-family:var(--font-sans);font-size:.8rem;color:var(--muted)}.fes-stay__body{padding:0 0 1.5rem;max-width:58ch}.fes-stay__body p{margin:0 0 .85rem;color:var(--muted);line-height:1.7}.fes-stay__body a,.fes-stay__links a{text-decoration:underline;text-underline-offset:4px}.fes-stay__note{max-width:80ch;color:var(--muted);font-size:.85rem;line-height:1.6;margin:1.5rem 0 .75rem}.fes-stay__links{display:flex;flex-wrap:wrap;gap:.8rem 1.5rem;font-size:.85rem}.fes-stay a:focus-visible,.fes-stay summary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}@media(min-width:900px){.fes-stay__layout{grid-template-columns:1.15fr 1fr;gap:3rem;align-items:start}.fes-stay__photo{aspect-ratio:4/3}}@media print{details .fes-stay__body{display:block!important}.fes-stay__photo{max-height:16rem}}
</style>
