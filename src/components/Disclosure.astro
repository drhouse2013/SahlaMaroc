---
/** Mention d'affiliation en haut des articles monétisés (exigée par la FTC / l'ARPP et les programmes d'affiliation). */
import { useTranslations, type Locale } from '../i18n';
import { getPageUrl } from '../utils/i18n';
import Icon from './Icon.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = await getPageUrl(lang, 'disclosure');
---

<p class="not-prose flex items-start gap-2 rounded-xl bg-majorelle-50 px-4 py-3 text-sm leading-relaxed text-ink-900/70 dark:bg-white/5 dark:text-sand-100/70">
  <Icon name="info" class="mt-1 size-4 shrink-0" />
  <span>{t('disclosure.short')}{href && <>{' '}<a href={href} class="underline underline-offset-2">{t('disclosure.link')}</a></>}</span>
</p>
