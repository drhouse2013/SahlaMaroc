---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import GuideVisual from './GuideVisual.astro';
import { CATEGORIES, CATEGORY_ICON } from '../i18n/categories';
import { entryPath } from '../utils/i18n';

/** row : ligne de liste éditoriale (sans visuel, filet géré par le parent `.row-list`). */
interface Props { article: CollectionEntry<'articles'>; size?: 'sm' | 'md' | 'lg' | 'row'; headingLevel?: 'h2' | 'h3'; showCategory?: boolean }
const { article, size = 'md', headingLevel = 'h3', showCategory = true } = Astro.props;
const d = article.data;
const lg = size === 'lg';
const H = headingLevel;
const read = {fr:'Lire le guide',en:'Read the guide',es:'Leer la guía',de:'Guide lesen',ar:'قراءة الدليل'}[d.lang];
---

{size === 'row' ? (
  <article class="group relative grid grid-cols-[1fr_auto] items-start gap-4 py-5">
    <div class="min-w-0">
      {showCategory && <p class="eyebrow mb-2 text-[var(--accent)]">{CATEGORIES[d.category].label[d.lang]}</p>}
      <H class="text-xl leading-snug"><a href={entryPath(d.lang, d.slug)} class="after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">{d.title}</a></H>
      <p class="mt-2 line-clamp-2 text-[0.95rem] leading-relaxed muted">{d.description}</p>
    </div>
    <Icon name="arrowRight" class="mt-1 size-5 text-[var(--muted)] transition-colors group-hover:text-[var(--link)] rtl:-scale-x-100" />
  </article>
) : size === 'sm' ? (
  <article class="group relative flex gap-3 rounded-2xl p-3 transition hover:bg-[var(--surface-3)]">
    <span class="icon-tile size-10"><Icon name={CATEGORY_ICON[d.category]} /></span>
    <div class="min-w-0">
      <H class="text-[0.98rem] leading-snug font-semibold"><a href={entryPath(d.lang, d.slug)} class="after:absolute after:inset-0 group-hover:text-terracotta-600 dark:group-hover:text-terracotta-300">{d.title}</a></H>
    </div>
  </article>
) : (
  <article class:list={['group card card-hover relative flex h-full overflow-hidden', lg ? 'flex-col md:flex-row' : 'flex-col']}>
    <div class:list={['relative overflow-hidden border-b border-[var(--line)]', lg ? 'md:w-1/2 md:shrink-0 md:border-e md:border-b-0' : '']}>
      <GuideVisual article={article} large={lg} />
    </div>
    <div class:list={['flex flex-1 flex-col justify-center', lg ? 'p-6 md:p-9' : 'p-5']}>
      <p class="eyebrow mb-3 text-[var(--accent)]">{CATEGORIES[d.category].label[d.lang]}</p>
      <H class:list={['leading-snug font-semibold', lg ? 'text-2xl md:text-3xl' : 'text-lg']}>
        <a href={entryPath(d.lang, d.slug)} class="after:absolute after:inset-0 group-hover:text-terracotta-600 dark:group-hover:text-terracotta-300">{d.title}</a>
      </H>
      <p class="mt-3 line-clamp-3 text-sm leading-relaxed muted">{d.description}</p>
      <p class="mt-auto flex items-center justify-between gap-3 pt-6 text-sm font-semibold" aria-hidden="true">{read}<Icon name="arrowRight" class="size-4 rtl:-scale-x-100" /></p>
    </div>
  </article>
)}
