---
import type { Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const copy = {
  fr: { title: 'Votre trajet, en direct.', intro: 'Deux interlocuteurs pour organiser un trajet en autocar ou préparer une location de voiture.', categories: ['Voyager en autocar', 'Louer une voiture'], descriptions: ['Consultez les départs, les agences et les options de billet auprès de CTM. Repérez votre gare de départ et les conditions de bagages avant de réserver.', 'Comparez les agences et les véhicules proposés par Hertz Maroc. Confirmez la caution, les documents demandés et les conditions de restitution pour votre réservation.'], website: 'Consulter les offres', terms: 'Lire les conditions', contact: 'Contacter', method: 'Nos critères de sélection', criteria: 'Nous avons consulté les sites des opérateurs, leur offre au Maroc, un moyen de contact et leurs conditions publiques. Cette sélection éditoriale porte sur ces informations accessibles ; elle ne repose pas sur un trajet ou une location testés par Sahla Maroc.', note: 'La réservation et le contrat se font directement auprès du prestataire. Comparez le prix total, les conditions de modification et les prestations incluses avant de choisir.', checked: 'Sources consultées le 2 novembre 2026.' },
  en: { title: 'Your journey, direct.', intro: 'Two contacts for arranging a coach journey or planning a car rental.', categories: ['Travel by coach', 'Rent a car'], descriptions: ['Check departures, agencies and ticket options directly with CTM. Locate your departure station and review baggage conditions before booking.', 'Compare the agencies and vehicles offered by Hertz Morocco. Confirm the deposit, required documents and return arrangements for your booking.'], website: 'View offers', terms: 'Read the terms', contact: 'Contact', method: 'Our selection criteria', criteria: 'We consulted the operators’ websites, their services in Morocco, a contact channel and their published terms. This editorial selection concerns publicly available information; Sahla Maroc has not tested a journey or rental with these operators.', note: 'Book and enter into a contract directly with the provider. Compare the total price, change conditions and included services before choosing.', checked: 'Sources checked on 2 November 2026.' },
  es: { title: 'Tu trayecto, directamente.', intro: 'Dos contactos para organizar un viaje en autocar o preparar un alquiler de coche.', categories: ['Viajar en autocar', 'Alquilar un coche'], descriptions: ['Consulta las salidas, agencias y opciones de billete directamente con CTM. Localiza la estación de salida y revisa las condiciones del equipaje antes de reservar.', 'Compara las agencias y los vehículos de Hertz Marruecos. Confirma la fianza, los documentos necesarios y las condiciones de devolución de tu reserva.'], website: 'Consultar las ofertas', terms: 'Leer las condiciones', contact: 'Contactar', method: 'Nuestros criterios de selección', criteria: 'Consultamos las webs de los operadores, sus servicios en Marruecos, un canal de contacto y sus condiciones públicas. Esta selección editorial se basa en esa información accesible; Sahla Maroc no ha probado un viaje ni un alquiler con estos operadores.', note: 'La reserva y el contrato se realizan directamente con el proveedor. Compara el precio total, las condiciones de cambio y los servicios incluidos antes de elegir.', checked: 'Fuentes consultadas el 2 de noviembre de 2026.' },
  de: { title: 'Ihre Reise, direkt geplant.', intro: 'Zwei Anlaufstellen für eine Fernbusfahrt oder die Planung eines Mietwagens.', categories: ['Mit dem Fernbus reisen', 'Ein Auto mieten'], descriptions: ['Prüfen Sie Abfahrten, Verkaufsstellen und Ticketoptionen direkt bei CTM. Klären Sie den Abfahrtsbahnhof und die Gepäckbedingungen vor der Buchung.', 'Vergleichen Sie Stationen und Fahrzeuge von Hertz Marokko. Bestätigen Sie Kaution, erforderliche Dokumente und Rückgabebedingungen für Ihre Buchung.'], website: 'Angebote ansehen', terms: 'Bedingungen lesen', contact: 'Kontakt', method: 'Unsere Auswahlkriterien', criteria: 'Wir haben die Websites der Anbieter, ihr Angebot in Marokko, einen Kontaktweg und ihre veröffentlichten Bedingungen geprüft. Diese redaktionelle Auswahl bezieht sich auf öffentlich zugängliche Informationen; Sahla Maroc hat keine Fahrt oder Anmietung bei diesen Anbietern getestet.', note: 'Buchung und Vertrag erfolgen direkt beim Anbieter. Vergleichen Sie Gesamtpreis, Änderungsbedingungen und enthaltene Leistungen vor Ihrer Entscheidung.', checked: 'Quellen am 2. November 2026 geprüft.' },
  ar: { title: 'خطّط لتنقلك مباشرة.', intro: 'جهتان لتنظيم رحلة بالحافلة أو التحضير لاستئجار سيارة.', categories: ['السفر بالحافلة', 'استئجار سيارة'], descriptions: ['راجع الرحلات والوكالات وخيارات التذاكر مباشرة لدى CTM. حدّد محطة الانطلاق واطلع على شروط الأمتعة قبل الحجز.', 'قارن وكالات وسيارات هرتز المغرب. أكّد مبلغ الضمان والوثائق المطلوبة وشروط إعادة السيارة الخاصة بحجزك.'], website: 'عرض الخيارات', terms: 'قراءة الشروط', contact: 'التواصل مع', method: 'معايير الاختيار', criteria: 'راجعنا مواقع الشركات وخدماتها في المغرب ووسيلة للتواصل معها وشروطها المنشورة. يستند هذا الاختيار التحريري إلى المعلومات المتاحة للعموم؛ لم يختبر Sahla Maroc رحلة أو استئجاراً لدى هاتين الجهتين.', note: 'يتم الحجز والتعاقد مباشرة مع مقدم الخدمة. قارن الثمن الإجمالي وشروط التعديل والخدمات المشمولة قبل الاختيار.', checked: 'رُوجعت المصادر في 2 نوفمبر 2026.' },
}[lang];
const providers = [
  { name: 'CTM', url: 'https://ctm.ma/', terms: 'https://ctm.ma/cgv/', contact: 'https://ctm.ma/aide-reclamation-ctm/' },
  { name: 'Hertz Maroc', url: 'https://www.hertz.ma/', terms: 'https://www.hertz.ma/location-voiture-maroc/conditions-generales-location', contact: 'https://www.hertz.ma/contactez-nous' },
];
---
<section id="travel-providers" class="travel-providers" aria-labelledby="travel-providers-title">
  <header class="reveal"><h2 id="travel-providers-title">{copy.title}</h2><p>{copy.intro}</p></header>
  <ul>{providers.map((provider, i) => <li class="reveal">
    <div class="travel-providers__identity"><h3>{provider.name}</h3><p>{copy.categories[i]}</p></div>
    <div class="travel-providers__detail"><p>{copy.descriptions[i]}</p><nav aria-label={`${provider.name} — ${copy.categories[i]}`}><a href={provider.url} rel="external">{copy.website} <span aria-hidden="true">↗</span></a><a href={provider.terms} rel="external">{copy.terms}</a><a href={provider.contact} rel="external" aria-label={`${copy.contact} ${provider.name}`}>{copy.contact} {provider.name}</a></nav></div>
  </li>)}</ul>
  <details><summary>{copy.method}</summary><p>{copy.criteria}</p><p><time datetime="2026-11-02">{copy.checked}</time></p></details>
  <p class="travel-providers__note">{copy.note}</p>
</section>
<style>
  .travel-providers{padding-block:clamp(3rem,7vw,6rem);border-bottom:1px solid var(--line)}header{max-width:48rem;margin-bottom:2.5rem}h2{font-family:var(--font-display);font-size:clamp(2rem,4vw,3.5rem);line-height:1.15;text-wrap:balance;margin:0 0 1rem}header p,.travel-providers__detail p{color:var(--muted);line-height:1.7;margin:0;max-width:65ch}ul{list-style:none;margin:0;padding:0}li{display:grid;grid-template-columns:minmax(12rem,1fr) minmax(0,2fr);gap:2rem;padding-block:2rem;border-top:1px solid var(--line)}h3{font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.3rem);line-height:1.2;margin:0 0 .5rem}.travel-providers__identity p{margin:0;color:var(--muted);font-size:.9rem}nav{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-top:1rem}a{display:inline-flex;align-items:center;min-height:44px;color:var(--link);text-decoration:underline;text-underline-offset:.3em}a:focus-visible,summary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}details{max-width:75ch;border-top:1px solid var(--line);padding-top:1rem}summary{min-height:44px;cursor:pointer;font-weight:600;padding-block:.65rem}details p,.travel-providers__note{font-size:.9rem;line-height:1.7;color:var(--muted)}details p{margin:.5rem 0 1rem}.travel-providers__note{max-width:75ch;margin:1rem 0 0}@media(max-width:650px){li{grid-template-columns:1fr;gap:1rem}nav{gap:.25rem 1rem}}
</style>
