---
/** Placeholder « Photo à venir » pour un lieu sans photo vérifiée. Remplit son parent (position: relative + ratio fixe => aucun CLS). Jamais une fausse photo. */
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
import type { PlaceKind } from '../utils/photos';

interface Props { kind: PlaceKind; lang: Locale; name?: string }
const { kind, lang, name } = Astro.props;
const t = useTranslations(lang);
const ICON: Record<PlaceKind, string> = {
  monument: 'M3 21h18M5 21V10m4 11V10m6 11V10m4 11V10M2 10l10-7 10 7',
  place: 'M3 21h18M6 21V8l6-4 6 4v13M10 21v-6h4v6',
  beach: 'M2 19c3 0 3-2 5.5-2S10 19 12.5 19s3-2 5.5-2 2 2 4 2M12 3v9m0-9c4 0 7 3 7 6H5c0-3 3-6 7-6Z',
  nature: 'M12 21v-6m0 0c-4 0-6-3-6-6 3 0 6 2 6 6Zm0 0c0-4 3-6 6-6 0 3-2 6-6 6M12 3v6',
  market: 'M4 9h16l-1.5-5h-13L4 9Zm1 0v11h14V9M9 20v-6h6v6',
  museum: 'M3 21h18M4 10l8-6 8 6M6 10v8m4-8v8m4-8v8m4-8v8',
  viewpoint: 'M2 20 9 8l4 7 3-4 6 9H2Z',
  city: 'M3 21h18M5 21V9l5-3v15m0-9 5-3 4 3v12M8 12h.01M8 16h.01M15 14h.01M15 18h.01',
  region: 'M2 20 9 8l4 7 3-4 6 9H2Z',
  hero: 'M2 20 9 8l4 7 3-4 6 9H2Z',
};
---
<div class="photo-ph" data-placeholder data-place-kind={kind} role="img" aria-label={name ? t('photo.soonFor', { name }) : t('photo.soon')}>
  <span class="photo-ph__medal" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={ICON[kind]} /></svg>
  </span>
  <span class="photo-ph__label" aria-hidden="true">{t('photo.soon')}</span>
</div>
<style>
  .photo-ph { position: absolute; inset: 0; container-type: size; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .65rem; overflow: hidden; color: var(--brand); background-color: color-mix(in srgb, var(--brand) 5%, var(--surface-2)); }
  /* Motif losange discret (réseau de deux diagonales), estompé au centre pour laisser respirer l'icône. */
  .photo-ph::before { content: ''; position: absolute; inset: 0; background-image: repeating-linear-gradient(45deg, transparent 0 .85rem, color-mix(in srgb, var(--brand) 12%, transparent) .85rem calc(.85rem + 1px)), repeating-linear-gradient(-45deg, transparent 0 .85rem, color-mix(in srgb, var(--brand) 12%, transparent) .85rem calc(.85rem + 1px)); -webkit-mask-image: radial-gradient(ellipse at center, transparent 18%, #000 85%); mask-image: radial-gradient(ellipse at center, transparent 18%, #000 85%); }
  .photo-ph__medal { position: relative; width: clamp(2.75rem, 24cqmin, 5.5rem); aspect-ratio: 1; border-radius: 50%; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
  .photo-ph__medal svg { position: absolute; inset: 22%; width: 56%; height: 56%; }
  .photo-ph__label { position: relative; padding: .2rem .7rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-size: .75rem; font-weight: 600; line-height: 1.3; }
  @media print { .photo-ph::before { display: none; } }
</style>
