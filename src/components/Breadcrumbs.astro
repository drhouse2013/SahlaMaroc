---
/** Fil d'Ariane visible (le JSON-LD BreadcrumbList est généré par la page). */
import { useTranslations, type Locale } from '../i18n';
interface Crumb { name: string; href?: string }
interface Props { items: Crumb[]; lang: Locale }
const { items, lang } = Astro.props;
const t = useTranslations(lang);
---

<nav aria-label={t('breadcrumb.label')} class="text-sm muted">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    {items.map((c, i) => (
      <li class="flex min-w-0 items-center gap-1.5 [overflow-wrap:anywhere]">
        {i > 0 && <span aria-hidden="true" class="opacity-60 rtl:-scale-x-100">/</span>}
        {c.href && i < items.length - 1 ? <a href={c.href} class="hover:text-[var(--text)] hover:underline underline-offset-4">{c.name}</a> : <span aria-current="page" class="font-medium text-[var(--text)]">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
