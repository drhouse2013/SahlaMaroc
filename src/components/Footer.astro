---
import Logo from './Logo.astro';
import { useTranslations, type Locale } from '../i18n';
import { CATEGORIES } from '../i18n/categories';
import { L } from '../data/home';
import { categoryPath, getActiveCategories, getPageUrl, rssPath } from '../utils/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const links = [
  { key: 'calculators', label: t('nav.tools') },
  { key: 'about', label: t('footer.about') },
  { key: 'disclosure', label: t('footer.disclosure') },
  { key: 'privacy', label: t('footer.privacy') },
] as const;
const resolved = await Promise.all(links.map(async (l) => ({ ...l, href: await getPageUrl(lang, l.key) })));
const active = await getActiveCategories(lang);
---

<footer class="mt-28 bg-night-900 text-sand-100">
  <div class="zellige h-5" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <a href={`/${lang}`} class="flex items-center gap-2.5">
        <Logo class="size-10" />
        <span class="font-display text-2xl font-bold">Sahla<span class="text-terracotta-300">Maroc</span></span>
      </a>
      <p class="mt-4 max-w-sm text-sand-100/75">{t('site.description')}</p>
    </div>
    <div>
      <p class="eyebrow text-saffron-400">{L.guides[lang]}</p>
      <ul class="mt-4 space-y-2.5">
        {active.map((id) => <li><a class="text-sand-100/85 hover:text-white hover:underline" href={categoryPath(lang, id)}>{CATEGORIES[id].label[lang]}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="eyebrow text-saffron-400">SahlaMaroc</p>
      <ul class="mt-4 space-y-2.5">
        {resolved.map((l) => l.href && <li><a class="text-sand-100/85 hover:text-white hover:underline" href={l.href}>{l.label}</a></li>)}
        <li><a class="text-sand-100/85 hover:text-white hover:underline" href={rssPath(lang)}>{t('footer.rss')}</a></li>
      </ul>
    </div>
  </div>
  <p class="border-t border-white/10 py-6 text-center text-xs text-sand-100/60">© {new Date().getFullYear()} SahlaMaroc · {t('footer.rights')}</p>
</footer>
