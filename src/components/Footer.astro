---
/**
 * Pied de page de la maquette : vert forêt, motif zellige discret, logo horizontal,
 * colonnes de liens (guides par thème, explorer, confiance, mentions) et langues.
 */
import Logo from './Logo.astro';
import { brandName } from '../utils/seo';
import { INVEST_HUB } from '../data/paths';
import { LOCALES, LOCALE_META, useTranslations, type Locale } from '../i18n';
import { CATEGORIES } from '../i18n/categories';
import { categoryPath, getActiveCategories, getPageUrl, homePath, hubPath, rssPath } from '../utils/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const brand = brandName(lang);
const brandTail = brand.split(' ')[1] ?? '';
const page = async (key: string) => getPageUrl(lang, key);
const active = await getActiveCategories(lang);
const seal = { fr: 'Guides & ressources vérifiées', en: 'Guides & checked resources', es: 'Guías y recursos verificados', de: 'Ratgeber & geprüfte Quellen', ar: 'أدلة ومصادر موثوقة' }[lang];

const explore = [
  { href: hubPath(lang, 'mre'), label: t('nav.mre') },
  { href: hubPath(lang, 'invest'), label: INVEST_HUB[lang].nav },
  { href: hubPath(lang, 'visit'), label: t('nav.visit') },
  { href: hubPath(lang, 'cities'), label: t('nav.cities') },
  { href: hubPath(lang, 'regions'), label: t('nav.regions') },
  { href: await page('calculators'), label: t('nav.tools') },
  { href: hubPath(lang, 'checklists'), label: t('nav.checklists') },
  { href: hubPath(lang, 'news'), label: t('nav.news') },
  { href: hubPath(lang, 'glossary'), label: t('nav.glossary') },
  { href: hubPath(lang, 'calendar'), label: t('nav.calendar') },
  { href: hubPath(lang, 'search'), label: t('nav.search') },
];
const trust = [
  { href: await page('about'), label: t('footer.about') },
  { href: await page('methodology'), label: t('footer.methodology') },
  { href: await page('editorial-policy'), label: t('footer.editorial') },
  { href: await page('corrections'), label: t('footer.corrections') },
  { href: await page('contact'), label: t('footer.contact') },
];
const legal = [
  { href: await page('disclosure'), label: t('footer.disclosure') },
  { href: await page('privacy'), label: t('footer.privacy') },
  { href: await page('terms'), label: t('footer.terms') },
  { href: await page('legal-notice'), label: t('footer.legalNotice') },
  { href: rssPath(lang), label: t('footer.rss') },
];
const isFrench = lang === 'fr';
---

<footer class="tpl-footer">
  <div class="tpl-footer__inner">
    <div class="tpl-footer__brand">
      <a href={homePath(lang)} aria-label={`${brand} — ${t('nav.home')}`}>
        {isFrench ? (
          <img src="/assets/logos/logo-horizontal-clair.svg" alt={brand} width="435" height="92" loading="lazy" />
        ) : (
          <span class="tpl-footer__wordmark"><Logo class="h-9 w-8" /><span dir="ltr">Sahla <span>{brandTail}</span></span></span>
        )}
      </a>
      <p>{t('footer.tagline')}</p>
      <span class="tpl-footer__seal">{seal}</span>
      <ul class="tpl-footer__langs">
        {LOCALES.map((code) => (
          <li>
            <a href={`/${code}`} hreflang={LOCALE_META[code].hreflang} lang={LOCALE_META[code].hreflang} aria-current={code === lang ? 'true' : undefined}>
              {LOCALE_META[code].label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <nav class="tpl-footer__col" aria-label={t('footer.guides')}>
      <h2>{t('footer.guides')}</h2>
      {active.map((id) => <a href={categoryPath(lang, id)}>{CATEGORIES[id].label[lang]}</a>)}
    </nav>
    <nav class="tpl-footer__col" aria-label={t('footer.explore')}>
      <h2>{t('footer.explore')}</h2>
      {explore.map((l) => l.href && <a href={l.href}>{l.label}</a>)}
    </nav>
    <nav class="tpl-footer__col" aria-label={t('footer.trust')}>
      <h2>{t('footer.trust')}</h2>
      {trust.map((l) => l.href && <a href={l.href}>{l.label}</a>)}
    </nav>
    <nav class="tpl-footer__col" aria-label={t('footer.legal')}>
      <h2>{t('footer.legal')}</h2>
      {legal.map((l) => l.href && <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
  <div class="tpl-footer__bottom">
    <span>{t('footer.notice')}</span>
    <span>© {new Date().getFullYear()} {brand} · {t('footer.rights')}</span>
  </div>
</footer>
