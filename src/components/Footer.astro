---
import Logo from './Logo.astro';
import { brandName } from '../utils/seo';
import { LOCALES, LOCALE_META, useTranslations, type Locale } from '../i18n';
import { CATEGORIES } from '../i18n/categories';
import { categoryPath, getActiveCategories, getPageUrl, homePath, hubPath, rssPath } from '../utils/i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const brand = brandName(lang);
const page = async (key: string) => getPageUrl(lang, key);
const active = await getActiveCategories(lang);

const explore = [
  { href: hubPath(lang, 'mre'), label: t('nav.mre') },
  { href: hubPath(lang, 'visit'), label: t('nav.visit') },
  { href: hubPath(lang, 'cities'), label: t('nav.cities') },
  { href: await page('calculators'), label: t('nav.tools') },
  { href: hubPath(lang, 'checklists'), label: t('nav.checklists') },
  { href: hubPath(lang, 'search'), label: t('nav.search') },
];
const trust = [
  { href: await page('about'), label: t('footer.about') },
  { href: await page('methodology'), label: t('footer.methodology') },
  { href: await page('editorial-policy'), label: t('footer.editorial') },
  { href: await page('corrections'), label: t('footer.corrections') },
  { href: await page('contact'), label: t('footer.contact') },
];
const legal = [
  { href: await page('disclosure'), label: t('footer.disclosure') },
  { href: await page('privacy'), label: t('footer.privacy') },
  { href: await page('terms'), label: t('footer.terms') },
  { href: rssPath(lang), label: t('footer.rss') },
];
const col = 'text-sand-100/80 hover:text-white hover:underline underline-offset-4';
---

<footer class="mt-24 bg-navy-900 text-sand-100 sm:mt-28">
  <div class="zellige h-3 opacity-90" aria-hidden="true"></div>
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
    <div class="sm:col-span-2 lg:col-span-1">
      <a href={homePath(lang)} class="inline-flex items-center gap-2.5 rounded-lg">
        <Logo class="h-11 w-10" variant="dark" />
        <span class="font-brand text-2xl font-bold" dir="ltr">Sahla <span class="text-gold-300">{brand.split(' ')[1]}</span></span>
      </a>
      <p class="mt-4 max-w-xs text-sm text-sand-100/75">{t('footer.tagline')}</p>
      <p class="eyebrow mt-8 text-gold-300">{t('footer.languages')}</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {LOCALES.map((code) => (
          <li><a href={`/${code}`} hreflang={LOCALE_META[code].hreflang} lang={LOCALE_META[code].hreflang} class:list={[col, code === lang && '!text-white font-semibold']} aria-current={code === lang ? 'true' : undefined}>{LOCALE_META[code].label}</a></li>
        ))}
      </ul>
    </div>
    <nav aria-label={t('footer.guides')}>
      <p class="eyebrow text-gold-300">{t('footer.guides')}</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {active.map((id) => <li><a class={col} href={categoryPath(lang, id)}>{CATEGORIES[id].label[lang]}</a></li>)}
      </ul>
    </nav>
    <nav aria-label={t('footer.explore')}>
      <p class="eyebrow text-gold-300">{t('footer.explore')}</p>
      <ul class="mt-4 space-y-2.5 text-sm">{explore.map((l) => l.href && <li><a class={col} href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav aria-label={t('footer.trust')}>
      <p class="eyebrow text-gold-300">{t('footer.trust')}</p>
      <ul class="mt-4 space-y-2.5 text-sm">{trust.map((l) => l.href && <li><a class={col} href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav aria-label={t('footer.legal')}>
      <p class="eyebrow text-gold-300">{t('footer.legal')}</p>
      <ul class="mt-4 space-y-2.5 text-sm">{legal.map((l) => l.href && <li><a class={col} href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-sand-100/65 sm:flex-row sm:items-center sm:justify-between">
      <p>{t('footer.notice')}</p>
      <p class="shrink-0">© {new Date().getFullYear()} {brand} · {t('footer.rights')}</p>
    </div>
  </div>
</footer>
