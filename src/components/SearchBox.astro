---
/**
 * Recherche globale.
 * - mode="dialog" : fenêtre modale (<dialog>) ouverte par tout élément [data-search-open] ou la touche « / ».
 * - mode="page"   : version intégrée à la page /<lang>/recherche (lit ?q=).
 * Sans JavaScript, le formulaire envoie vers la page de recherche, et les liens [data-search-open] y mènent.
 */
import Icon from './Icon.astro';
import { useTranslations, type Locale } from '../i18n';
import { hubPath, searchIndexPath } from '../utils/i18n';

interface Props { lang: Locale; mode?: 'dialog' | 'page'; autofocus?: boolean }
const { lang, mode = 'dialog', autofocus = false } = Astro.props;
const t = useTranslations(lang);
const i18n = {
  loading: t('search.loading'), error: t('search.error'), hint: t('search.hint'), empty: t('search.empty'), emptyHint: t('search.emptyHint'),
  one: t('search.result'), many: t('search.results'),
  k_article: t('search.kind.article'), k_tool: t('search.kind.tool'), k_city: t('search.kind.city'), k_checklist: t('search.kind.checklist'), k_topic: t('search.kind.topic'), k_page: t('search.kind.page'),
};
const examples = [t('search.ex1'), t('search.ex2'), t('search.ex3'), t('search.ex4'), t('search.ex5'), t('search.ex6')];
const id = `search-input-${mode}`;
---

{mode === 'dialog' ? (
  <dialog id="search-dialog" class="search-dialog m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-navy-900/55 backdrop:backdrop-blur-sm sm:mx-auto sm:mt-[8vh] sm:h-auto sm:max-h-[80vh] sm:max-w-2xl" aria-label={t('search.title')}>
    <div class="card flex h-full flex-col overflow-hidden rounded-none sm:h-auto sm:max-h-[80vh] sm:rounded-3xl">
      <form role="search" action={hubPath(lang, 'search')} method="get" data-search-root data-mode="dialog" data-index={searchIndexPath(lang)} data-i18n={JSON.stringify(i18n)} class="flex min-h-0 flex-1 flex-col">
        <div class="flex items-center gap-3 border-b border-[var(--line)] px-4 py-3">
          <Icon name="search" class="size-5 shrink-0 muted" />
          <label for={id} class="sr-only">{t('search.label')}</label>
          <input id={id} name="q" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder={t('search.placeholder')} class="min-h-11 w-full bg-transparent text-lg outline-none placeholder:text-[var(--muted)]" aria-describedby={`${id}-status`} aria-controls={`${id}-results`} />
          <button type="button" data-search-close class="grid size-10 shrink-0 place-items-center rounded-full hover:bg-sand-100 dark:hover:bg-white/10" aria-label={t('common.close')}><Icon name="x" /></button>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto px-2 py-3 sm:px-3">
          <div data-search-examples class="px-2 pb-2">
            <p class="eyebrow muted">{t('search.examples')}</p>
            <ul class="mt-3 flex flex-wrap gap-2">{examples.map((e) => <li><button type="button" data-search-example={e} class="badge badge-navy min-h-9 cursor-pointer px-3 text-sm hover:brightness-95">{e}</button></li>)}</ul>
          </div>
          <p id={`${id}-status`} data-search-status class="px-2 text-sm muted" role="status" aria-live="polite"></p>
          <ul id={`${id}-results`} data-search-results aria-label={t('search.title')} class="search-list mt-1 grid gap-1"></ul>
        </div>
      </form>
    </div>
  </dialog>
) : (
  <form role="search" action={hubPath(lang, 'search')} method="get" data-search-root data-mode="page" data-index={searchIndexPath(lang)} data-i18n={JSON.stringify(i18n)}>
    <div class="card flex items-center gap-3 px-4 py-2 focus-within:border-majorelle-500">
      <Icon name="search" class="size-5 shrink-0 muted" />
      <label for={id} class="sr-only">{t('search.label')}</label>
      <input id={id} name="q" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder={t('search.placeholder')} autofocus={autofocus} class="min-h-12 w-full bg-transparent text-lg outline-none placeholder:text-[var(--muted)]" aria-describedby={`${id}-status`} aria-controls={`${id}-results`} />
      <button type="submit" class="btn btn-secondary btn-sm shrink-0">{t('search.submit')}</button>
    </div>
    <div data-search-examples class="mt-5">
      <p class="eyebrow muted">{t('search.examples')}</p>
      <ul class="mt-3 flex flex-wrap gap-2">{examples.map((e) => <li><button type="button" data-search-example={e} class="badge badge-navy min-h-9 cursor-pointer px-3 text-sm hover:brightness-95">{e}</button></li>)}</ul>
    </div>
    <p id={`${id}-status`} data-search-status class="mt-6 text-sm muted" role="status" aria-live="polite"></p>
    <ul id={`${id}-results`} data-search-results aria-label={t('search.title')} class="search-list mt-3 grid gap-2"></ul>
  </form>
)}

<style is:global>
  .search-hit { display: grid; gap: .15rem; border-radius: 1rem; padding: .75rem .9rem; border: 1px solid transparent; }
  .search-hit:hover, .search-hit:focus-visible { background: var(--surface-3); border-color: var(--line); outline: none; }
  .search-kind { font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--color-emerald-moroccan-600); }
  .dark .search-kind { color: var(--color-emerald-moroccan-100); }
  .search-title { font-weight: 600; line-height: 1.35; }
  .search-desc { font-size: .88rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .search-dialog[open] { display: flex; }
  .search-dialog::backdrop { animation: fade-in .15s ease-out; }
</style>

<script>
  import { initSearch } from '../scripts/search';
  document.querySelectorAll<HTMLElement>('[data-search-root]').forEach((root) => {
    const api = initSearch(root);
    if (root.dataset.mode === 'page') {
      const q = new URLSearchParams(location.search).get('q');
      if (q) { api.input.value = q; api.run(); }
      return;
    }
    const dialog = root.closest('dialog') as HTMLDialogElement;
    const open = (e?: Event) => {
      if (!dialog || typeof dialog.showModal !== 'function') return; // navigateur ancien : on suit le lien
      e?.preventDefault();
      if (!dialog.open) dialog.showModal();
      api.input.focus();
      api.input.select();
    };
    document.querySelectorAll('[data-search-open]').forEach((el) => el.addEventListener('click', open));
    dialog.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    document.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement).tagName;
      const typing = /INPUT|TEXTAREA|SELECT/.test(tag) || (e.target as HTMLElement).isContentEditable;
      if (!typing && (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'))) open(e);
    });
  });
</script>
