---
import { L } from '../data/home';
import { useTranslations, type Locale } from '../i18n';
import { getPageUrl } from '../utils/i18n';
interface Props { lang: Locale; name: string }
const { lang, name } = Astro.props;
const t = useTranslations(lang);
const about = await getPageUrl(lang, 'about');
---
<aside class="card mt-12 flex items-start gap-4 p-6">
  <span class="grid size-14 shrink-0 place-items-center rounded-full bg-majorelle-600 font-display text-2xl font-bold text-white">{name.charAt(0)}</span>
  <div>
    <p class="font-semibold">{t('article.by')} {name}</p>
    <p class="mt-1 text-sm text-ink-900/75 dark:text-sand-100/75">{L.aboutAuthor[lang]}</p>
    {about && <a href={about} class="mt-2 inline-block text-sm font-semibold text-majorelle-600 underline underline-offset-4 dark:text-majorelle-100">{t('nav.about')}</a>}
  </div>
</aside>
