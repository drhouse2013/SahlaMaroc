---
import type { Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const words = {
fr:['Mon carnet','Enregistrer cette page','Page enregistrée','Retirer','Votre carnet est vide. Enregistrez une ville ou un guide pour le retrouver ici.','Les favoris restent sur cet appareil, sans compte.','Partager cette page','Lien copié.','Le partage a échoué. Copiez l’adresse de la page depuis votre navigateur.','Le stockage est indisponible : les favoris seront conservés seulement jusqu’à la fermeture de cette page.',' favoris','Exporter le carnet'],
en:['My travel notebook','Save this page','Page saved','Remove','Your notebook is empty. Save a city or guide to find it here.','Favourites stay on this device, without an account.','Share this page','Link copied.','Sharing failed. Copy the page address from your browser.','Storage is unavailable: favourites will only last until you close this page.',' favourites','Export notebook'],
es:['Mi cuaderno','Guardar esta página','Página guardada','Eliminar','Tu cuaderno está vacío. Guarda una ciudad o guía para encontrarla aquí.','Los favoritos se guardan en este dispositivo, sin cuenta.','Compartir esta página','Enlace copiado.','No se pudo compartir. Copia la dirección desde el navegador.','El almacenamiento no está disponible: los favoritos se conservarán solo hasta cerrar esta página.',' favoritos','Exportar cuaderno'],
de:['Mein Reiseheft','Diese Seite speichern','Seite gespeichert','Entfernen','Ihr Reiseheft ist leer. Speichern Sie eine Stadt oder einen Reiseführer.','Favoriten bleiben ohne Konto auf diesem Gerät.','Diese Seite teilen','Link kopiert.','Teilen fehlgeschlagen. Kopieren Sie die Seitenadresse im Browser.','Speicher nicht verfügbar: Favoriten bleiben nur bis zum Schließen dieser Seite erhalten.',' Favoriten','Reiseheft exportieren'],
ar:['دفتر رحلتي','حفظ هذه الصفحة','تم حفظ الصفحة','إزالة','دفترك فارغ. احفظ مدينة أو دليلاً لتجده هنا.','تبقى المفضلة على هذا الجهاز دون حساب.','مشاركة هذه الصفحة','تم نسخ الرابط.','تعذرت المشاركة. انسخ عنوان الصفحة من المتصفح.','التخزين غير متاح؛ ستبقى المفضلة حتى إغلاق هذه الصفحة فقط.',' عناصر محفوظة','تصدير الدفتر'],
}[lang];
---
<details class="notebook no-print" data-notebook data-words={JSON.stringify(words)} hidden>
<summary><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 4.75A2.75 2.75 0 0 1 7.75 2H20v17H7.75A2.75 2.75 0 0 0 5 21.75v-17Z"/><path d="M5 5h12M5 21.75A2.75 2.75 0 0 1 7.75 19H20"/></svg><span class="notebook__title">{words[0]}</span><span class="notebook__count" data-notebook-count aria-hidden="true">0</span></summary>
<div class="notebook__panel"><p class="notebook__privacy">{words[5]}</p><button type="button" class="btn btn-primary btn-sm" data-notebook-save aria-pressed="false">{words[1]}</button><p role="status" aria-live="polite" data-notebook-status></p><ul data-notebook-list></ul><p data-notebook-empty>{words[4]}</p><div class="notebook__actions"><button class="btn btn-secondary btn-sm" type="button" data-notebook-share>{words[6]}</button><button class="btn btn-ghost btn-sm" type="button" data-notebook-export>{words[11]}</button></div></div>
</details>
<style>
.notebook{position:fixed;inset-inline-end:1rem;bottom:calc(4.25rem + env(safe-area-inset-bottom));z-index:45;font-size:.85rem;max-width:calc(100vw - 2rem)}.notebook[hidden]{display:none}.notebook>summary{list-style:none;display:flex;align-items:center;gap:.65rem;cursor:pointer;background:var(--brand);color:var(--surface-2);border:1px solid var(--line-strong);padding:.75rem 1rem;border-radius:8px;font-weight:600;min-height:44px}.notebook>summary::-webkit-details-marker{display:none}.notebook>summary svg{width:1.1rem;height:1.1rem;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex:none}.notebook__count{font-variant-numeric:tabular-nums}.notebook__panel{position:absolute;inset-inline-end:0;bottom:calc(100% + .5rem);width:min(24rem,calc(100vw - 2rem));max-height:65dvh;overflow:auto;background:var(--surface);color:var(--text);padding:1.25rem;border:1px solid var(--line-strong);border-radius:12px;box-shadow:0 12px 32px rgb(10 35 29 / .2)}.notebook__privacy{margin:0 0 1rem;color:var(--muted);font-size:.8rem}.notebook ul{list-style:none;padding:0;margin:1rem 0}.notebook :global(li){display:flex;gap:.75rem;align-items:baseline;justify-content:space-between;padding:.7rem 0;border-bottom:1px solid var(--line)}.notebook :global(li a){overflow-wrap:anywhere;text-decoration:underline;text-underline-offset:3px}.notebook :global(li button){flex:none;border:0;background:none;color:var(--link);font:inherit;min-height:44px;cursor:pointer}.notebook__actions{display:flex;gap:.5rem;flex-wrap:wrap}.notebook summary:focus-visible,.notebook :global(button:focus-visible),.notebook :global(a:focus-visible){outline:3px solid var(--focus);outline-offset:3px}@media(max-width:480px){.notebook>summary{width:48px;height:48px;justify-content:center;padding:.6rem;gap:0;border-radius:50%}.notebook__title{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.notebook__count{position:absolute;inset-block-start:-.2rem;inset-inline-end:-.2rem;min-width:1.1rem;height:1.1rem;padding:0 .15rem;display:grid;place-items:center;border-radius:999px;background:var(--accent);color:var(--surface);font-size:.65rem}}@media(min-width:1024px){.notebook{bottom:1rem}}@media print{.notebook{display:none}}
</style>
<script>
type SavedPage={path:string;title:string};
document.querySelectorAll<HTMLElement>('[data-notebook]').forEach(root=>{
const words=JSON.parse(root.dataset.words??'[]') as string[],key='sahla-notebook-v1',path=location.pathname;
const save=root.querySelector<HTMLButtonElement>('[data-notebook-save]')!,list=root.querySelector<HTMLUListElement>('[data-notebook-list]')!,status=root.querySelector<HTMLElement>('[data-notebook-status]')!;
let entries:SavedPage[]=[],persist=true;
const valid=(item:unknown):item is SavedPage=>{if(!item||typeof item!=='object')return false;const x=item as SavedPage;return typeof x.title==='string'&&typeof x.path==='string'&&/^\/(en|fr|es|de|ar)(\/|$)/.test(x.path)&&!x.path.includes('\\')&&!x.path.includes('?')&&!x.path.includes('#')};
try{const stored:unknown=JSON.parse(localStorage.getItem(key)??'[]');if(Array.isArray(stored))entries=stored.filter(valid).slice(0,100)}catch{persist=false}
const write=()=>{try{localStorage.setItem(key,JSON.stringify(entries))}catch{persist=false}if(!persist)status.textContent=words[9]};
const render=()=>{const active=entries.some(x=>x.path===path);save.textContent=words[active?2:1];save.setAttribute('aria-pressed',String(active));root.querySelector('[data-notebook-count]')!.textContent=String(entries.length);root.querySelector<HTMLElement>('[data-notebook-empty]')!.hidden=entries.length>0;root.querySelector<HTMLButtonElement>('[data-notebook-export]')!.disabled=!entries.length;list.replaceChildren();entries.forEach(entry=>{const li=document.createElement('li'),a=document.createElement('a'),remove=document.createElement('button');a.href=entry.path;a.textContent=entry.title;remove.type='button';remove.textContent=words[3];remove.setAttribute('aria-label',`${words[3]} : ${entry.title}`);remove.addEventListener('click',()=>{entries=entries.filter(x=>x.path!==entry.path);write();render()});li.append(a,remove);list.append(li)})};
save.addEventListener('click',()=>{if(entries.some(x=>x.path===path))entries=entries.filter(x=>x.path!==path);else entries=[{path,title:document.querySelector('h1')?.textContent?.trim().slice(0,200)||document.title},...entries].slice(0,100);write();render()});
root.querySelector('[data-notebook-share]')?.addEventListener('click',async()=>{const url=new URL(path,location.origin).href;try{if(navigator.share)await navigator.share({title:document.title,url});else{await navigator.clipboard.writeText(url);status.textContent=words[7]}}catch(e){if(!(e instanceof DOMException&&e.name==='AbortError'))status.textContent=words[8]}});
root.querySelector('[data-notebook-export]')?.addEventListener('click',()=>{const data=entries.map(x=>({title:x.title,url:new URL(x.path,location.origin).href}));const url=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='sahla-maroc-carnet.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)});
render();if(!persist)status.textContent=words[9];root.hidden=false;
});
</script>

